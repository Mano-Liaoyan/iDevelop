<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IDevelop.Desktop"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:sidebar="using:IDevelop.Desktop.Sidebar"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Sidebar.SidebarView"
             ClipToBounds="False"
             x:DataType="local:MainWindowViewModel">

  <UserControl.Resources>
    <!-- UI Automation shows no plain panel, so the summary carries the row's id and its reason. The summary names the
         reason in a few words, and the row's tooltip holds all of it. The name and the summary wrap in full, and the dot
         centres on the name's first line. -->
    <DataTemplate x:Key="AgentRowTemplate" DataType="execution:AgentRow">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8"
            Background="Transparent"
            ToolTip.Tip="{Binding Detail}">
        <Ellipse Classes="status" VerticalAlignment="Top" Margin="0,5,0,0"
                 Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                 Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                 Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                 Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="rowName" Text="{Binding Name}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="{Binding AutomationId}"
                   AutomationProperties.HelpText="{Binding Detail}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The rows are in the order they appear, which is also the Tab order. A row's width takes everything in the panel's
       8 px inset. Find, Activity, and the footer take the height they need, and the tree scrolls in the rest. -->
  <Grid x:Name="Rows" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
    <!-- Linux ignores the request to draw into the title bar, so the band that stands in for it collapses there. -->
    <Border Height="44" Background="Transparent"
            IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}"
            PointerPressed="OnTitleBandPressed" />

    <Border Grid.Row="1" Padding="8,8,8,4" IsVisible="{Binding HasProjects}">
      <TextBox x:Name="FindBox" Classes="search" Height="32" MinHeight="32"
               Text="{Binding Find.Query, Mode=TwoWay}"
               Watermark="Find node or workflow"
               ToolTip.Tip="Finds nodes and workflows in every open project"
               AutomationProperties.AutomationId="FindBox"
               AutomationProperties.Name="Find node or workflow">
        <TextBox.InnerRightContent>
          <!-- The hint gives its width to the words once the box has the keys. -->
          <TextBlock Classes="keyHint" Text="{x:Static sidebar:FindViewModel.Hint}" VerticalAlignment="Center" Margin="0,0,8,0"
                     IsVisible="{Binding !#FindBox.IsFocused}" />
        </TextBox.InnerRightContent>
      </TextBox>
    </Border>

    <!-- What needs the person and what runs now, without a click. The heading's chevron folds the list, and its counts stay in view
         and add up to the list. A short panel starts folded, so the heading is the one summary row until the person opens it. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="8,4,0,0" IsVisible="{Binding Activity.HasRows}">
      <ToggleButton Classes="sectionFold" Margin="0,0,8,0" IsChecked="{Binding Activity.IsOpen}"
                    ToolTip.Tip="{Binding Activity.FoldLabel}"
                    AutomationProperties.AutomationId="ActivityFold"
                    AutomationProperties.Name="{Binding Activity.FoldLabel}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
          <PathIcon Theme="{StaticResource Glyph}" Width="12" Height="12" />
          <TextBlock Grid.Column="1" Classes="section" Text="Activity" VerticalAlignment="Center" />
          <StackPanel Grid.Column="3" Classes="counts" VerticalAlignment="Center">
            <StackPanel Classes="count" IsVisible="{Binding Activity.HasWaiting}" Background="Transparent"
                        ToolTip.Tip="{Binding Activity.WaitingCount, StringFormat='{}{0} waiting for you'}"
                        AutomationProperties.AutomationId="ActivityWaiting">
              <PathIcon Classes="stateIcon state-inputrequired" Theme="{StaticResource Glyph}" Width="14" Height="14" />
              <TextBlock Classes="caption" Text="{Binding Activity.WaitingCount}" />
            </StackPanel>
            <StackPanel Classes="count" IsVisible="{Binding Activity.HasFailed}" Background="Transparent"
                        ToolTip.Tip="{Binding Activity.FailedCount, StringFormat='{}{0} failed'}"
                        AutomationProperties.AutomationId="ActivityFailed">
              <PathIcon Classes="stateIcon state-failed" Theme="{StaticResource Glyph}" Width="14" Height="14" />
              <TextBlock Classes="caption" Text="{Binding Activity.FailedCount}" />
            </StackPanel>
            <StackPanel Classes="count" IsVisible="{Binding Activity.HasRunning}" Background="Transparent"
                        ToolTip.Tip="{Binding Activity.RunningCount, StringFormat='{}{0} running'}"
                        AutomationProperties.AutomationId="ActivityRunning">
              <PathIcon Classes="stateIcon state-running spin" Theme="{StaticResource Glyph}" Width="14" Height="14" />
              <TextBlock Classes="caption" Text="{Binding Activity.RunningCount}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </ToggleButton>
      <ScrollViewer x:Name="ActivityScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Activity.IsOpen}">
        <StackPanel Spacing="2" Margin="0,0,8,0">
          <ItemsControl ItemsSource="{Binding Activity.Rows}"
                        AutomationProperties.AutomationId="Activity"
                        AutomationProperties.Name="Activity">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="sidebar:ActivityRow">
                <Button Classes="activity" Classes.selected="{Binding Node.IsConversationShown}" Command="{Binding OpenCommand}"
                        ToolTip.Tip="{Binding Detail}"
                        AutomationProperties.AutomationId="ActivityRow"
                        AutomationProperties.Name="{Binding Node.Title}"
                        AutomationProperties.HelpText="{Binding Detail}">
                  <Grid ColumnDefinitions="16,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                    <PathIcon Classes="stateIcon" Classes.spin="{Binding Node.IsRunningNow}" Theme="{StaticResource Glyph}" Margin="0,1,0,0" VerticalAlignment="Top"
                              theme:StyleClass.State="{Binding Node.State}" theme:StyleClass.Why="{Binding Node.WaitReason}" />
                    <TextBlock Grid.Column="1" Classes="rowName strong" Text="{Binding Node.Title, Converter={x:Static theme:NameBreaks.KeepTokens}}" />
                    <!-- One line: the reason in its state's color, a dot, and the workflow in the rest, cut at its end. The tooltip holds the project too. -->
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4"
                          AutomationProperties.AutomationId="ActivityDetail" AutomationProperties.Name="{Binding Detail}">
                      <TextBlock Classes="caption reason" theme:StyleClass.State="{Binding Node.State}" Text="{Binding Reason}" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                 AutomationProperties.AutomationId="ActivityReason" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="·" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Workflow}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="ghost" Height="24" Margin="0,0,0,4" Padding="8,0" HorizontalAlignment="Left"
                  Command="{Binding Activity.ShowAllCommand}"
                  IsVisible="{Binding Activity.HasMore}"
                  AutomationProperties.AutomationId="ActivityShowAll"
                  AutomationProperties.Name="{Binding Activity.ShowAllLabel}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Activity.ShowAllLabel}" VerticalAlignment="Center" />
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Nothing is open: the canvas holds Open folder, and this panel the folders the person closed. -->
    <StackPanel Grid.Row="3" Margin="16,12" Spacing="8" IsVisible="{Binding !HasProjects}">
      <TextBlock Classes="caption" Text="No project open" AutomationProperties.AutomationId="NoProject" />
      <TextBlock Classes="caption" Text="Folders you close show here." TextWrapping="Wrap" IsVisible="{Binding !HasRecent}"
                 AutomationProperties.AutomationId="NoRecent" />
      <TextBlock Classes="section" Text="Recent" Margin="0,8,0,0" IsVisible="{Binding HasRecent}" />
      <ItemsControl ItemsSource="{Binding Recent}" IsVisible="{Binding HasRecent}" Margin="-8,0"
                    AutomationProperties.AutomationId="RecentProjects" AutomationProperties.Name="Recent projects">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="local:RecentProject">
            <Button Classes="nav" Click="OnOpenRecent" ToolTip.Tip="{Binding Folder}"
                    AutomationProperties.AutomationId="RecentProject" AutomationProperties.Name="{Binding Name}">
              <TextBlock Classes="rowName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid Grid.Row="3" RowDefinitions="Auto,*" IsVisible="{Binding HasProjects}">
      <Grid ColumnDefinitions="*,Auto" Height="28" Margin="16,0,16,0">
        <TextBlock Classes="section" Text="Projects" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon small" VerticalAlignment="Center"
                Click="OnOpenFolder"
                ToolTip.Tip="Open folder"
                AutomationProperties.AutomationId="OpenFolder"
                AutomationProperties.Name="Open folder">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" />
        </Button>
      </Grid>
      <!-- Each project lists its workflows, and each workflow lists its nodes, one size smaller, while its row is expanded. The
           shown workflow is the selected row. A workflow's name wraps in full, and a node's name takes two lines until it is selected. The scroll bar draws in
           the gutter at the rows' end, so every row keeps one right edge. -->
      <Panel Grid.Row="1">
      <ScrollViewer x:Name="Tree" Classes="quietBar" Margin="8,0,0,0" HorizontalScrollBarVisibility="Disabled"
                    ScrollChanged="OnTreeScrollChanged">
        <StackPanel x:Name="TreeRows" Margin="0,0,8,8" Spacing="2">
          <ItemsControl ItemsSource="{Binding Projects}"
                        AutomationProperties.AutomationId="Projects"
                        AutomationProperties.Name="Open projects">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:ProjectViewModel">
                <StackPanel Spacing="2">
                  <Panel Classes="projectRow">
                    <ToggleButton Classes="projectRow" IsChecked="{Binding IsExpanded}"
                                  AutomationProperties.AutomationId="ProjectExpand"
                                  AutomationProperties.Name="{Binding ExpandLabel}">
                      <Grid ColumnDefinitions="12,16,*,Auto" ColumnSpacing="6">
                        <PathIcon Theme="{StaticResource Glyph}" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0"
                                  Foreground="{DynamicResource TextMutedBrush}" />
                        <Border Grid.Column="1" Classes="projectTile" Classes.current="{Binding IsCurrent}" Margin="0,1,0,0" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Initial}" />
                        </Border>
                        <TextBlock Grid.Column="2" Classes="rowName strong semibold" Text="{Binding Name}"
                                   ToolTip.Tip="{Binding Folder}"
                                   AutomationProperties.AutomationId="ProjectName" />
                        <!-- An open project's workflows show these counts, so only a folded row sums them. -->
                        <StackPanel Grid.Column="3" Classes="counts" Margin="0,1,0,0" IsVisible="{Binding !IsExpanded}">
                          <StackPanel Classes="count" IsVisible="{Binding HasRunningNodes}"
                                      Background="Transparent"
                                      ToolTip.Tip="{Binding RunningLabel}"
                                      AutomationProperties.AutomationId="ProjectRunning"
                                      AutomationProperties.Name="{Binding RunningLabel}">
                            <PathIcon Classes="stateIcon state-running spin" Theme="{StaticResource Glyph}" Width="14" Height="14" />
                            <TextBlock Classes="caption" Text="{Binding RunningCount}" />
                          </StackPanel>
                          <StackPanel Classes="count" IsVisible="{Binding HasFailed}"
                                      Background="Transparent"
                                      ToolTip.Tip="{Binding FailedLabel}"
                                      AutomationProperties.AutomationId="ProjectFailed"
                                      AutomationProperties.Name="{Binding FailedLabel}">
                            <PathIcon Classes="stateIcon state-failed" Theme="{StaticResource Glyph}" Width="14" Height="14" />
                            <TextBlock Classes="caption" Text="{Binding FailedCount}" />
                          </StackPanel>
                          <StackPanel Classes="count" IsVisible="{Binding IsWaiting}"
                                      Background="Transparent"
                                      ToolTip.Tip="{Binding WaitingLabel}"
                                      AutomationProperties.AutomationId="ProjectWaiting"
                                      AutomationProperties.Name="{Binding WaitingLabel}">
                            <PathIcon Classes="stateIcon state-inputrequired" Theme="{StaticResource Glyph}" Width="14" Height="14" />
                            <TextBlock Classes="caption" Text="{Binding WaitingCount}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </ToggleButton>
                    <!-- Show on hover or focus only, over the row's end. Close asks before it stops anything. -->
                    <StackPanel Classes="rowActions">
                      <Button Classes="icon small"
                              Click="OnNewWorkflow"
                              ToolTip.Tip="New workflow"
                              AutomationProperties.AutomationId="NewWorkflow"
                              AutomationProperties.Name="{Binding Name, StringFormat='New workflow in {0}'}">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" />
                      </Button>
                      <Button Classes="icon small"
                              Click="OnCloseProject"
                              ToolTip.Tip="Close project"
                              AutomationProperties.AutomationId="CloseProject"
                              AutomationProperties.Name="{Binding Name, StringFormat='Close {0}'}">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDismiss}" />
                      </Button>
                    </StackPanel>
                  </Panel>
                  <StackPanel Spacing="2" IsVisible="{Binding IsExpanded}">
                    <Grid ColumnDefinitions="*,Auto" Margin="38,0,8,0" IsVisible="{Binding HasNoWorkflows}">
                      <TextBlock Classes="caption" Text="No workflows yet" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="ghost" Height="24" Content="New workflow" Click="OnNewWorkflow"
                              AutomationProperties.AutomationId="EmptyNewWorkflow" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Workflows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:WorkflowCanvasViewModel">
                          <StackPanel Spacing="2">
                            <Panel>
                              <!-- The name, and at the row's end how far the work went. Under them, in glyphs and words,
                                   what failed, waits, runs, or is stale. The tooltip holds the sum. -->
                              <Button Classes="nav workflow" Classes.selected="{Binding IsSelected}" Classes.holdsNode="{Binding ShowsNodeSelection}" HorizontalContentAlignment="Stretch"
                                      IsVisible="{Binding !IsRenamingWorkflow}"
                                      Click="OnWorkflowClick"
                                      KeyDown="OnWorkflowKeyDown"
                                      ToolTip.Tip="{Binding Summary}"
                                      AutomationProperties.AutomationId="WorkflowRow"
                                      AutomationProperties.Name="{Binding Name}"
                                      AutomationProperties.HelpText="{Binding Summary}">
                                <Button.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Header="Rename" InputGesture="F2"
                                              Click="OnRenameWorkflow"
                                              AutomationProperties.AutomationId="WorkflowRename"
                                              AutomationProperties.Name="Rename" theme:MenuGlyph.Data="{StaticResource IconRename}" />
                                  </ContextMenu>
                                </Button.ContextMenu>
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4">
                                  <TextBlock Classes="rowName workflowName" Classes.shown="{Binding IsSelected}" Text="{Binding Name, Converter={x:Static theme:NameBreaks.KeepTokens}}"
                                             AutomationProperties.AutomationId="WorkflowName" />
                                  <!-- While a node runs, the row says what it does now. -->
                                  <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="caption" Text="{Binding RowActivity}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                             IsVisible="{Binding RowActivity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             AutomationProperties.AutomationId="WorkflowActivity" />
                                  <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{DynamicResource AccentBrush}"
                                           IsVisible="{Binding HasUnsavedChanges}" AutomationProperties.AutomationId="WorkflowUnsaved" />
                                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding RowProgress}" VerticalAlignment="Top" Margin="0,1,0,0"
                                             AutomationProperties.AutomationId="WorkflowSummary" />
                                  <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2,0,0" ItemsSource="{Binding RowChips}" IsVisible="{Binding HasRowChips}"
                                                AutomationProperties.AutomationId="WorkflowAlert">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="2" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="canvas:StateChip">
                                        <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.Name="{Binding Label}">
                                          <Panel Width="14" Height="14" VerticalAlignment="Center">
                                            <Ellipse Classes="badgeDisc" theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
                                            <PathIcon Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="9" Height="9"
                                                      theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
                                          </Panel>
                                          <TextBlock Classes="caption" Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Grid>
                              </Button>
                              <local:WorkflowNameBox IsVisible="{Binding IsRenamingWorkflow}" Height="32" Margin="38,2,4,2"
                                                     AutomationProperties.AutomationId="WorkflowNameBox"
                                                     AutomationProperties.Name="Workflow name" />
                              <ToggleButton Classes="chevron workflowChevron" HorizontalAlignment="Left" IsTabStop="False"
                                            IsChecked="{Binding IsExpanded}" IsVisible="{Binding !!Nodes.Count}"
                                            ToolTip.Tip="{Binding ExpandLabel}"
                                            AutomationProperties.AutomationId="WorkflowExpand"
                                            AutomationProperties.Name="{Binding ExpandLabel}">
                                <PathIcon Theme="{StaticResource Glyph}" />
                              </ToggleButton>
                            </Panel>
                            <Border IsVisible="{Binding IsExpanded}"
                                    Margin="24,0,0,0" Padding="2,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border100Brush}">
                              <ListBox Classes="tasks" Classes.hidden="{Binding !IsSelected}"
                                       ItemsSource="{Binding Outline}"
                                       SelectedItem="{Binding SelectedNode}"
                                       SelectionChanged="OnSidebarSelectionChanged"
                                       Tapped="OnSidebarTapped"
                                       KeyDown="OnSidebarKeyDown"
                                       AutomationProperties.AutomationId="SidebarTasks"
                                       AutomationProperties.Name="{Binding Name}">
                                <ListBox.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                  </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                  <DataTemplate DataType="canvas:TaskNodeViewModel">
                                    <!-- A name takes two lines, so rows keep a steady height and a long list stays in view. The tooltip and the selected row hold all of it. -->
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="5" Background="Transparent" ToolTip.Tip="{Binding Title}">
                                      <theme:KindTile Kind="{Binding Kind}" TileSize="14" VerticalAlignment="Top" Margin="0,1,0,0" />
                                      <theme:EllipsisText Grid.Column="1" Classes="rowName nodeName" Whole="{Binding Title, Converter={x:Static theme:NameBreaks.KeepTokens}}"
                                                          AutomationProperties.AutomationId="NodeRowName" />
                                      <PathIcon Grid.Column="2" Classes="stateIcon" Classes.spin="{Binding IsRunningNow}" Theme="{StaticResource Glyph}" Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0"
                                                theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding WaitReason}"
                                                ToolTip.Tip="{Binding StatusLabel}"
                                                AutomationProperties.AutomationId="NodeRowState"
                                                AutomationProperties.Name="{Binding StatusLabel}" />
                                    </Grid>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Unopened}"
                        AutomationProperties.AutomationId="UnopenedProjects"
                        AutomationProperties.Name="Projects that did not open">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:UnopenedProject">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="8,5,0,5" ColumnSpacing="8"
                      Background="Transparent"
                      ToolTip.Tip="{Binding Reason}">
                  <TextBlock Grid.Row="0" Classes="rowName semibold" Text="{Binding Name}"
                             AutomationProperties.AutomationId="UnopenedName" />
                  <TextBlock Grid.Row="1" Classes="caption warning" Text="{Binding Summary}" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="UnopenedReason"
                             AutomationProperties.HelpText="{Binding Reason}" />
                  <Button Grid.Row="0" Grid.Column="1" Classes="icon small" VerticalAlignment="Top" Margin="0,-3,0,0"
                          Click="OnForgetProject"
                          ToolTip.Tip="Forget this folder"
                          AutomationProperties.AutomationId="ForgetProject"
                          AutomationProperties.Name="{Binding Name, StringFormat='Forget {0}'}">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDismiss}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <!-- A row slides under the pinned rows at the top. What it reaches past the bottom edge would show cut through its letters, so
           the panel's own color covers that row until it comes in whole. The cover takes no pointer. -->
      <Border x:Name="TreeFootCover" Classes="treeCover" VerticalAlignment="Bottom" IsVisible="False" />
      <!-- The project and the workflow of the rows under the top edge stay in view while they scroll. A click goes back to its row. -->
      <Border x:Name="TreeHead" Classes="treeHead" IsVisible="False">
        <StackPanel>
          <Panel x:Name="StickyProject" IsVisible="False" x:DataType="local:ProjectViewModel" DataContext="{x:Null}">
            <Button Classes="stickyRow projectHead" Click="OnStickyProject" AutomationProperties.AutomationId="StickyProject">
              <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                <Border Classes="projectTile" Classes.current="{Binding IsCurrent, FallbackValue=False}">
                  <TextBlock Text="{Binding Initial, FallbackValue={x:Null}}" />
                </Border>
                <TextBlock Grid.Column="1" Classes="rowName strong semibold" Text="{Binding Name, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </Grid>
            </Button>
            <ToggleButton Classes="chevron stickyChevron" Margin="12,0,0,0" IsChecked="{Binding IsExpanded, FallbackValue=False}"
                          ToolTip.Tip="{Binding ExpandLabel, FallbackValue={x:Null}}"
                          AutomationProperties.AutomationId="StickyProjectFold"
                          AutomationProperties.Name="{Binding ExpandLabel, FallbackValue={x:Null}}">
              <PathIcon Theme="{StaticResource Glyph}" />
            </ToggleButton>
          </Panel>
          <Panel x:Name="StickyWorkflow" IsVisible="False" x:DataType="canvas:WorkflowCanvasViewModel" DataContext="{x:Null}">
            <Button Classes="stickyRow workflowHead" Click="OnStickyWorkflow" AutomationProperties.AutomationId="StickyWorkflow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBlock Classes="rowName strong" Text="{Binding Name, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding RowProgress, FallbackValue={x:Null}}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <ToggleButton Classes="chevron stickyChevron" Margin="25,0,0,0" IsChecked="{Binding IsExpanded, FallbackValue=False}"
                          ToolTip.Tip="{Binding ExpandLabel, FallbackValue={x:Null}}"
                          AutomationProperties.AutomationId="StickyWorkflowFold"
                          AutomationProperties.Name="{Binding ExpandLabel, FallbackValue={x:Null}}">
              <PathIcon Theme="{StaticResource Glyph}" />
            </ToggleButton>
          </Panel>
        </StackPanel>
      </Border>
      </Panel>
    </Grid>

    <!-- Find's results take the panel under the box, over Activity and the tree, down to the footer. A name wraps in full. -->
    <Panel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding Find.IsActive}">
      <Border Classes="findPalette" AutomationProperties.AutomationId="FindPalette">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="caption" Text="{Binding Find.ResultsLabel}" Margin="8,4,8,4" IsVisible="{Binding Find.HasResults}"
                     AutomationProperties.AutomationId="FindCount" />
          <ListBox x:Name="FindResults" Grid.Row="1" Classes="results"
                   ItemsSource="{Binding Find.Results}"
                   SelectedIndex="{Binding Find.Index, Mode=TwoWay}"
                   Tapped="OnResultTapped"
                   Focusable="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.AutomationId="FindResults"
                   AutomationProperties.Name="Find results">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="sidebar:FindResult">
                <Grid ColumnDefinitions="14,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                  <Panel Margin="0,2,0,0" VerticalAlignment="Top">
                    <PathIcon Theme="{StaticResource Glyph}" Width="14" Height="14" Data="{StaticResource IconFlowchart}" IsVisible="{Binding IsWorkflow}"
                              Foreground="{DynamicResource TextMutedBrush}" />
                    <theme:KindTile Kind="{Binding Kind}" TileSize="14" IsVisible="{Binding IsNode}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Classes="rowName strong"
                             AutomationProperties.Name="{Binding Name}">
                    <Run Text="{Binding BeforeMatch}" /><Run Classes="match" Text="{Binding Match}" /><Run Text="{Binding AfterMatch}" />
                  </TextBlock>
                  <PathIcon Grid.Column="2" Classes="stateIcon" Theme="{StaticResource Glyph}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                            IsVisible="{Binding IsNode}"
                            theme:StyleClass.State="{Binding Node.State, FallbackValue={x:Null}}" theme:StyleClass.Why="{Binding Node.WaitReason, FallbackValue={x:Null}}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="caption" Text="{Binding Place}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" Text="No node or workflow matches" Margin="8,8" IsVisible="{Binding Find.HasNoMatch}"
                     AutomationProperties.AutomationId="FindNoMatch" />
          <TextBlock Grid.Row="2" Classes="caption" Text="Enter opens. Esc closes." Margin="8,4" IsVisible="{Binding Find.HasResults}"
                     AutomationProperties.AutomationId="FindKeys" />
        </Grid>
      </Border>
    </Panel>

    <!-- A problem never hides behind a flyout: a client that needs setup shows here until the problem clears. -->
    <Border Grid.Row="4" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}"
            IsVisible="{Binding HasAgentsNeedingSetup}">
      <ItemsControl ItemsSource="{Binding AgentsNeedingSetup}" ItemTemplate="{StaticResource AgentRowTemplate}"
                    AutomationProperties.AutomationId="AgentsNeedingSetup"
                    AutomationProperties.Name="Agents that need setup">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>

    <Border Grid.Row="5" Height="40" Padding="8,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button x:Name="AgentsStatus" Classes="ghost" Height="28" Padding="8,0" HorizontalAlignment="Left"
                ToolTip.Tip="{Binding AgentsSummary, StringFormat='{}{0}. Open the list of agents.'}"
                AutomationProperties.AutomationId="AgentsStatus"
                AutomationProperties.Name="{Binding AgentsSummary, StringFormat='Agents: {0}'}">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft">
              <StackPanel x:Name="AgentsPanel" Width="224" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="Agents" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="icon small"
                          Command="{Binding RefreshAgentsCommand}"
                          ToolTip.Tip="Check agents again"
                          AutomationProperties.AutomationId="RefreshAgents"
                          AutomationProperties.Name="Check agents again">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Agents}" ItemTemplate="{StaticResource AgentRowTemplate}"
                              AutomationProperties.AutomationId="Agents"
                              AutomationProperties.Name="Agents">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- One dot for the worst status. The flyout names each client. -->
            <Ellipse Classes="status small" VerticalAlignment="Center"
                     Classes.running="{Binding AgentsTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                     Classes.complete="{Binding AgentsTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                     Classes.problem="{Binding AgentsTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                     Classes.waiting="{Binding AgentsTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}" />
            <ItemsControl ItemsSource="{Binding Agents}" Width="0" Height="0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="execution:AgentRow">
                  <!-- UI Automation reads each client's status here, with the flyout closed. The text takes no room. -->
                  <TextBlock Width="0" Height="0" Opacity="0" Text="{Binding Summary}"
                             AutomationProperties.AutomationId="{Binding AutomationId}"
                             AutomationProperties.HelpText="{Binding Detail}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Text="{Binding AgentsSummary}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="AgentsSummary" />
          </StackPanel>
        </Button>
        <Border Grid.Column="1" Width="72" Height="28" Padding="2" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusSm}">
          <UniformGrid Columns="3">
            <RadioButton Classes="segment glyph" GroupName="Theme"
                         Tag="{x:Static ThemeVariant.Default}"
                         IsChecked="{Binding RequestedThemeVariant, Source={x:Static Application.Current}, Mode=OneWay,
                                     Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ThemeVariant.Default}}"
                         IsCheckedChanged="OnThemeChecked"
                         ToolTip.Tip="System theme"
                         AutomationProperties.AutomationId="ThemeSystem"
                         AutomationProperties.Name="System theme">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconThemeSystem}" Width="14" Height="14" />
            </RadioButton>
            <RadioButton Classes="segment glyph" GroupName="Theme"
                         Tag="{x:Static ThemeVariant.Light}"
                         IsChecked="{Binding RequestedThemeVariant, Source={x:Static Application.Current}, Mode=OneWay,
                                     Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ThemeVariant.Light}}"
                         IsCheckedChanged="OnThemeChecked"
                         ToolTip.Tip="Light theme"
                         AutomationProperties.AutomationId="ThemeLight"
                         AutomationProperties.Name="Light theme">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconThemeLight}" Width="14" Height="14" />
            </RadioButton>
            <RadioButton Classes="segment glyph" GroupName="Theme"
                         Tag="{x:Static ThemeVariant.Dark}"
                         IsChecked="{Binding RequestedThemeVariant, Source={x:Static Application.Current}, Mode=OneWay,
                                     Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ThemeVariant.Dark}}"
                         IsCheckedChanged="OnThemeChecked"
                         ToolTip.Tip="Dark theme"
                         AutomationProperties.AutomationId="ThemeDark"
                         AutomationProperties.Name="Dark theme">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconThemeDark}" Width="14" Height="14" />
            </RadioButton>
          </UniformGrid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
