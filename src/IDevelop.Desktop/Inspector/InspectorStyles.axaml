<!-- The inspector's look: a pinned header, foldable Title Case sections, and rows on the panel's surface, all on the
     columns of InspectorGrid inside one 12 px inset. Godot's inspector gives the structure; the type sizes, radii, and
     colors come from the app's tokens. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:execution="using:IDevelop.Desktop.Execution"
        xmlns:inspector="using:IDevelop.Desktop.Inspector">

  <Style Selector="Border.inspectorHeader">
    <Setter Property="Padding" Value="12,12,12,8" />
  </Style>
  <Style Selector="TextBox.headerTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- The title as text, at the box's border and padding, so it ends in an ellipsis where the box would clip. -->
  <Style Selector="TextBlock.headerTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="7,0" />
  </Style>
  <Style Selector="Panel.headerTitle:focus-within > TextBlock.headerTitle">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.headerTitle:not(:focus-within) > TextBox.headerTitle /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TextBlock.kindLine">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.headerName">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- A tile for what has no kind, such as a connection or the workflow: neutral, so it never reads as a node kind. -->
  <Style Selector="Border.neutralTile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Border.neutralTile > PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.filterBar">
    <Setter Property="Padding" Value="12,0,12,8" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <Style Selector="Border.filterBar TextBox">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="Button.glyph">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.glyph:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.glyph:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.glyph:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector="Button.glyph.revert">
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="Border.infoGlyph">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.infoGlyph > PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
  </Style>

  <!-- Folded, a section's chevron points to the leading edge, as Apple's disclosure controls do. -->
  <Style Selector="inspector|InspectorSection">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Button Name="PART_Header" Classes="sectionHeader" AutomationProperties.Name="{TemplateBinding Title}">
            <inspector:InspectorGrid>
              <PathIcon Name="PART_Chevron" Theme="{StaticResource Glyph}" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Classes="sectionTitle" Text="{TemplateBinding Title}"
                         AutomationProperties.AutomationId="{TemplateBinding TitleId}" />
              <TextBlock Grid.Column="3" Classes="sectionBadge" Text="{TemplateBinding Badge}" HorizontalAlignment="Right" />
            </inspector:InspectorGrid>
          </Button>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="0,0,0,10" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="inspector|InspectorSection /template/ PathIcon#PART_Chevron">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector="inspector|InspectorSection:folded /template/ PathIcon#PART_Chevron">
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="inspector|InspectorSection:folded /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="inspector|InspectorSection:unmatched /template/ Button#PART_Header">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="inspector|InspectorSection:unmatched /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.sectionHeader">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0,8,0,6" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <Style Selector="Button.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sectionHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <Style Selector="Button.sectionHeader:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.sectionBadge">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rows: a glyph or tile, the label, the editor, and a trailing column for the revert and info glyphs or a row's
       actions, so every editor lines up whether or not its row has them. -->
  <Style Selector="inspector|InspectorRow">
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Template">
      <ControlTemplate>
        <inspector:InspectorGrid RowDefinitions="Auto,Auto">
          <PathIcon Name="PART_Icon" Theme="{StaticResource Glyph}" Data="{TemplateBinding Icon}"
                    IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ContentPresenter Name="PART_Lead" Content="{TemplateBinding Lead}" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="{TemplateBinding Lead, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Name="PART_Label" Grid.Column="2" Classes="rowLabel" Text="{TemplateBinding Label}" ToolTip.Tip="{TemplateBinding LabelTip}" />
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="3" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
          <StackPanel Name="PART_Trail" Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Classes="glyph revert"
                    Command="{TemplateBinding RevertCommand}" IsVisible="{TemplateBinding CanRevert}"
                    ToolTip.Tip="Revert to the blueprint's default"
                    AutomationProperties.AutomationId="{TemplateBinding RevertId}"
                    AutomationProperties.Name="Revert">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRevert}" Width="14" Height="14" />
            </Button>
            <Border Classes="infoGlyph" ToolTip.Tip="{TemplateBinding Info}"
                    IsVisible="{TemplateBinding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.AutomationId="{TemplateBinding InfoId}"
                    AutomationProperties.Name="{TemplateBinding InfoName}"
                    AutomationProperties.HelpText="{TemplateBinding Info}">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Actions}" IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </inspector:InspectorGrid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="inspector|InspectorRow /template/ PathIcon#PART_Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="inspector|InspectorRow:wide /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="inspector|InspectorRow:stacked /template/ TextBlock#PART_Label, inspector|InspectorRow:editor:narrow /template/ TextBlock#PART_Label">
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="inspector|InspectorRow:stacked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="4" />
  </Style>
  <Style Selector="inspector|InspectorRow:editor:narrow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="inspector|InspectorRow:full /template/ TextBlock#PART_Label">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="inspector|InspectorRow:full /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="4" />
  </Style>
  <Style Selector="inspector|InspectorRow:title /template/ TextBlock#PART_Label">
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="inspector|InspectorRow:title /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- An entry, such as a kind in the overview or a blueprint in the library, names a thing rather than a property. -->
  <Style Selector="inspector|InspectorRow.entry /template/ TextBlock#PART_Label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.rowLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- A one-line note, short enough to show whole, whose tooltip holds the full text where a paragraph used to be. -->
  <Style Selector="TextBlock.note">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="inspector|InspectorRow CheckBox">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="inspector|InspectorRow ComboBox, inspector|InspectorRow TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="inspector|InspectorRow TextBox.multiline">
    <Setter Property="MinHeight" Value="72" />
  </Style>
  <Style Selector="inspector|InspectorRow Button.action, inspector|InspectorRow Button.primary, inspector|InspectorRow Button.destructive">
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.rowLink">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <Style Selector="Button.rowLink:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rowLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <!-- Short values side by side, such as the client, model, and reasoning of the last run. -->
  <Style Selector="WrapPanel.chips">
    <Setter Property="ItemSpacing" Value="4" />
    <Setter Property="LineSpacing" Value="4" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- A disclosure: a chevron and a count that show or hide detail most people never need. -->
  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.disclosure TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.disclosure PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked PathIcon">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>

  <Style Selector="TextBlock.activity">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.activity.tool">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Margin" Value="14,0,0,0" />
  </Style>
  <!-- The list holds the tool calls only while the person asks for them, so a long run builds only the lines it shows. -->
  <Style Selector="ItemsControl.activity" x:DataType="execution:AttemptViewModel">
    <Setter Property="ItemsSource" Value="{Binding Said}" />
  </Style>
  <Style Selector="ContentControl.activity.showsTools ItemsControl.activity" x:DataType="execution:AttemptViewModel">
    <Setter Property="ItemsSource" Value="{Binding Activity}" />
  </Style>

  <Style Selector="TextBlock.itemTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.groupHeading">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="Margin" Value="0,6,0,2" />
  </Style>
</Styles>
