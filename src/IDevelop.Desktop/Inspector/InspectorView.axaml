<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:conversation="using:IDevelop.Desktop.Conversation"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             xmlns:workflows="using:IDevelop.Workflows"
             x:Class="IDevelop.Desktop.Inspector.InspectorView"
             x:DataType="canvas:WorkflowCanvasViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Inspector/InspectorStyles.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- An overlay scroll bar 10 px wide, expanded, fits in the panel's 12 px right inset, so it never covers a row's
         buttons, and the rows never move for it. Its quiet thumb stays in view whenever the sections overflow. -->
    <x:Double x:Key="ScrollBarSize">10</x:Double>
    <!-- One finding of a review's verdict: its heading, with its severity at the card's right edge where every card keeps
         it, then its location, the reviewer's words, and the change that would settle it. A verdict that gave no severity
         or location shows neither. -->
    <DataTemplate x:Key="FindingTemplate" DataType="execution:FindingViewModel">
      <Border Padding="8" CornerRadius="{StaticResource RadiusSm}" BorderThickness="1"
              BorderBrush="{DynamicResource Border80Brush}" Background="{DynamicResource SurfaceRaisedBrush}">
        <StackPanel Spacing="4">
          <!-- The chip keeps to 96 px, so an odd long severity wraps inside it rather than pushing it past the card, and the
               heading sits on the chip's first line. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="caption" Text="{Binding Heading}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,3,0,0" />
            <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top" MaxWidth="96"
                    IsVisible="{Binding Severity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    AutomationProperties.AutomationId="FindingSeverity">
              <TextBlock Text="{Binding Severity}" />
            </Border>
          </Grid>
          <TextBlock Classes="location" Text="{Binding Location}"
                     IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     AutomationProperties.AutomationId="FindingLocation" />
          <TextBlock Text="{Binding Reviewer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="{Binding Change}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding Change, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Panel>
    <!-- The blueprint editor takes the panel while it is open. Its sections fold apart from the inspector's. -->
    <ContentControl x:Name="EditorHost" Content="{Binding Blueprints.Editor}"
                    IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="blueprints:BlueprintEditorViewModel">
          <blueprints:BlueprintEditorView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- The header and the filter stay put while the sections scroll. The selection fills both, or the workflow when nothing
         is selected. The filter comes first in the tree, so Tab goes from it to the header's actions, and the actions come
         first in the header, so the first action is two stops from the filter. -->
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNull}}">
      <!-- With nothing selected, the panel holds the overview and the library, and nothing to filter. -->
      <Border Grid.Row="1" Classes="filterBar" IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBox x:Name="Filter" Classes="search clearButton" Watermark="Filter properties"
                 TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown"
                 AutomationProperties.AutomationId="InspectorFilter"
                 AutomationProperties.Name="Filter properties" />
      </Border>

      <Border Grid.Row="0" Classes="pinnedHeader">
      <ContentControl>
        <ContentControl.Content>
          <MultiBinding Converter="{x:Static inspector:InspectorConverters.FirstSet}">
            <Binding Path="Inspected" />
            <Binding Path="Overview" />
          </MultiBinding>
        </ContentControl.Content>
        <ContentControl.DataTemplates>
          <DataTemplate DataType="canvas:TaskNodeViewModel">
            <inspector:InspectorHeader>
              <!-- The node's next steps have their own row, so the sections start at one height in every state. -->
              <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Classes="headerState">
                <!-- The node's next steps, primary first. -->
                <ItemsControl Classes="headerActions" ItemsSource="{Binding Actions}"
                              AutomationProperties.AutomationId="NodeActions">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="inspector:NodeAction">
                      <Button Classes.primary="{Binding IsPrimary}" Classes.action="{Binding !IsPrimary}" Command="{Binding Command}"
                              ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True"
                              AutomationProperties.AutomationId="{Binding Id}"
                              AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{Binding Glyph, Converter={x:Static inspector:InspectorConverters.Icon}}" Width="14" Height="14" />
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <theme:KindTile Classes="headerTile" Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="24" />
              <!-- Until the box has focus, a text block over it shows the title in up to two lines, so the header reads as a
                   title rather than a field. The box takes the title's whole length once it has focus. -->
              <Panel Grid.Row="0" Grid.Column="2" Classes="headerTitle" Margin="-6,0,0,0" ToolTip.Tip="{Binding Title}">
                <TextBox Classes="headerTitle" Text="{Binding Title}"
                         AutomationProperties.AutomationId="TaskTitle"
                         AutomationProperties.Name="Title" />
                <theme:EllipsisText Classes="headerTitle" Whole="{Binding Title}" MaxLines="2" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
              </Panel>
              <!-- The status and the kind share a line. The status is a plain word with its glyph, so it never reads as a button.
                   Where they do not fit, the kind goes under the status, without the dot. -->
              <inspector:SeparatedLine Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="InspectorKind">
                <Border Classes="pill headerPill" HorizontalAlignment="Left"
                        Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                        Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                        Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                        Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}"
                        Classes.warning="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Warning}}">
                  <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding StatusLabel}">
                    <PathIcon Theme="{StaticResource Glyph}" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StateWord}"
                               AutomationProperties.AutomationId="RunTaskStatus" />
                  </Grid>
                </Border>
                <TextBlock Classes="kindLine" Text=" · " ClipToBounds="True" />
                <TextBlock Classes="kindLine" Text="{Binding TypeName}" Background="Transparent" ToolTip.Tip="{Binding KindTip}"
                           AutomationProperties.AutomationId="TaskType" />
              </inspector:SeparatedLine>
              <Button Grid.Row="0" Grid.Column="3" Classes="glyph" ToolTip.Tip="More" HorizontalAlignment="Right" VerticalAlignment="Top"
                      AutomationProperties.AutomationId="InspectorMore"
                      AutomationProperties.Name="More">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconMore}" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Open Conversation" Command="{Binding OpenConversationCommand}" IsVisible="{Binding ConversationIsInMenu}"
                              AutomationProperties.AutomationId="InspectorMoreConversation" theme:MenuGlyph.Data="{StaticResource IconChat}" />
                    <MenuItem Header="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding RetryIsInMenu}"
                              AutomationProperties.AutomationId="InspectorMoreRetry" theme:MenuGlyph.Data="{StaticResource IconRefresh}" />
                    <MenuItem Header="Derive Blueprint…" Command="{Binding DeriveCommand}" ToolTip.Tip="A new blueprint with this type's fields and template"
                              AutomationProperties.AutomationId="DeriveTaskType" theme:MenuGlyph.Data="{StaticResource IconDerive}" />
                    <MenuItem Header="Save as Blueprint…" Command="{Binding SaveAsBlueprintCommand}" ToolTip.Tip="A new blueprint whose defaults are this node's values and agent"
                              AutomationProperties.AutomationId="SaveAsBlueprint" theme:MenuGlyph.Data="{StaticResource IconSaveAs}" />
                    <Separator />
                    <MenuItem Header="Expand All Sections" Click="OnExpandAll" AutomationProperties.AutomationId="ExpandAllSections" theme:MenuGlyph.Data="{StaticResource IconChevronDown}" />
                    <MenuItem Header="Collapse All Sections" Click="OnCollapseAll" AutomationProperties.AutomationId="CollapseAllSections" theme:MenuGlyph.Data="{StaticResource IconChevronRight}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <StackPanel Grid.Row="4" Grid.ColumnSpan="4">
                <Border Classes="detailRule" IsVisible="{Binding ShowsStateDetail}"
                Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}"
                Classes.warning="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Warning}}">
                  <StackPanel>
                    <theme:EllipsisText x:Name="DetailText" Classes="detail clamped" Whole="{Binding StateDetail}" ToolTip.Tip="{Binding StateDetail}"
                                           AutomationProperties.AutomationId="RunTaskDetail" />
                    <Button Classes="textLink" Content="Show all" IsVisible="{Binding #DetailText.IsCut}"
                            AutomationProperties.AutomationId="RunTaskDetailMore" AutomationProperties.Name="Show the whole text">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <SelectableTextBlock Classes="wholeText" Text="{Binding StateDetail}" />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Border>
                <Border Classes="detailRule warning" IsVisible="{Binding RunRefusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel>
                    <theme:EllipsisText x:Name="RefusalText" Classes="detail clamped" Whole="{Binding RunRefusal}" ToolTip.Tip="{Binding RunRefusal}"
                                           AutomationProperties.AutomationId="StartProblem" />
                    <Button Classes="textLink" Content="Show all" IsVisible="{Binding #RefusalText.IsCut}"
                            AutomationProperties.AutomationId="StartProblemMore" AutomationProperties.Name="Show the whole text">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <SelectableTextBlock Classes="wholeText" Text="{Binding RunRefusal}" />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Border>
                <!-- Three lines, as the note is short and the sections stay in view. -->
                <TextBox Classes="sendBackNote" Text="{Binding SendBackNote}" AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;"
                         IsVisible="{Binding ShowsSendBack}"
                         Watermark="Why send it back? The note goes to the nodes before it."
                         AutomationProperties.AutomationId="SendBackNote"
                         AutomationProperties.Name="Note to send back" />
              </StackPanel>
            </inspector:InspectorHeader>
          </DataTemplate>
          <DataTemplate DataType="canvas:ConnectionViewModel">
            <inspector:InspectorHeader>
              <Border Classes="neutralTile headerTile">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconLink}" />
              </Border>
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="headerName" Text="{Binding Kind}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="kindLine" Text="Connection" />
            </inspector:InspectorHeader>
          </DataTemplate>
          <DataTemplate DataType="inspector:WorkflowOverviewViewModel">
            <inspector:InspectorHeader>
              <Border Classes="neutralTile headerTile">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFlowchart}" />
              </Border>
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="headerName" Text="Workflow" />
              <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="kindLine" Text="{Binding TaskCount}" />
            </inspector:InspectorHeader>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
      </Border>

      <!-- A short row that the bottom edge would cut hides under the cover until it comes in whole. -->
      <Border x:Name="SectionsFoot" Grid.Row="2" Classes="scrollFoot" ZIndex="1" IsVisible="False" />
      <ScrollViewer x:Name="SectionScroller" Grid.Row="2" Classes="quietBar" ScrollChanged="OnSectionsScrolled">
        <StackPanel x:Name="SectionList" Margin="8,8,8,16">
          <!-- Over the sections, and outside the swapped content, so the hint stays in the tree, hidden, while something is selected. -->
          <TextBlock Classes="note" Text="Select a node to edit it." Margin="4,0,4,8"
                     IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNull}}"
                     AutomationProperties.AutomationId="InspectorHint" />
          <ContentControl>
            <ContentControl.Content>
              <MultiBinding Converter="{x:Static inspector:InspectorConverters.FirstSet}">
                <Binding Path="Inspected" />
                <Binding Path="Overview" />
              </MultiBinding>
            </ContentControl.Content>
            <ContentControl.DataTemplates>
              <DataTemplate DataType="canvas:TaskNodeViewModel">
                <!-- The sections keep one order in every state, as Godot's and Blender's do, so a field never moves when a node's state changes:
                     what the node is asked, who does it, what it reads, and what it hands on. The header says the state. -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <inspector:InspectorSection Key="Proposal" Title="Proposal" IsShown="{Binding Proposal, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                      <ContentControl Content="{Binding Proposal}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="canvas:ProposalViewModel">
                            <StackPanel AutomationProperties.AutomationId="Proposal">
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding CheckingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" Width="14" Height="14"
                                            VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CheckingNote}" TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="ProposalCheckingNote" />
                                </Grid>
                              </inspector:InspectorRow>
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <!-- The tile says the kind and the ghost wires say the connections, so a row is its title. A new
                                       task's agent and the planner's reason follow under the title, and its pickers open under the row. -->
                                  <DataTemplate DataType="canvas:ProposalItemViewModel">
                                    <StackPanel AutomationProperties.AutomationId="ProposalEntry">
                                      <inspector:InspectorRow Classes="firstLine" Layout="Full" Label="{Binding Label}">
                                        <inspector:InspectorRow.Actions>
                                          <Button Classes="glyph" Classes.open="{Binding Agent.IsEditing, FallbackValue=False}"
                                                  IsVisible="{Binding HasAgent}" Command="{Binding Agent.EditCommand, FallbackValue={x:Null}}"
                                                  ToolTip.Tip="Change the agent"
                                                  AutomationProperties.AutomationId="ProposalAgentEdit"
                                                  AutomationProperties.Name="{Binding Agent.EditName, FallbackValue={x:Null}}">
                                            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconEdit}" Width="14" Height="14" />
                                          </Button>
                                        </inspector:InspectorRow.Actions>
                                        <StackPanel>
                                          <!-- The box takes the tile and the title only, so a click on the agent or the reason ticks nothing. -->
                                          <CheckBox Padding="8,0,0,0"
                                                    IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanChoose}" ToolTip.Tip="{Binding Tip}"
                                                    AutomationProperties.AutomationId="ProposalItem"
                                                    AutomationProperties.Name="{Binding Label}">
                                            <!-- The box sits in the middle of the check box's first 32 px, so the title line does too. -->
                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8" Margin="0,7">
                                              <theme:KindTile Kind="{Binding Kind}" TileSize="18" VerticalAlignment="Top" />
                                              <StackPanel Grid.Column="1">
                                                <TextBlock Classes="itemTitle" Text="{Binding Title}" MinHeight="18" TextWrapping="Wrap"
                                                           AutomationProperties.AutomationId="ProposalItemTitle" />
                                                <TextBlock Classes="note" Text="{Binding Note}"
                                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </Grid>
                                          </CheckBox>
                                          <!-- Under the title, outside the box: the box's 20 px, its 8 px padding, the tile's 18 px, and the 8 px gap. -->
                                          <StackPanel Margin="54,-3,0,0" Spacing="4" IsVisible="{Binding HasAgent}">
                                            <!-- The agent on a card's two lines, the client and then the model and level, so every row reads alike. -->
                                            <StackPanel AutomationProperties.AutomationId="ProposalAgent"
                                                        AutomationProperties.Name="{Binding Agent.Label, FallbackValue={x:Null}}">
                                              <TextBlock Classes="agentLine" Text="{Binding Agent.Client, FallbackValue={x:Null}}" />
                                              <TextBlock Classes="agentLine" Text="{Binding Agent.Model, FallbackValue={x:Null}}"
                                                         IsVisible="{Binding Agent.Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                                            </StackPanel>
                                            <TextBlock Classes="caption" Text="{Binding Agent.Reason, FallbackValue={x:Null}}" TextWrapping="Wrap"
                                                       IsVisible="{Binding Agent.Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                                       AutomationProperties.AutomationId="ProposalAgentReason" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"
                                                  IsVisible="{Binding Agent.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" Width="14" Height="14"
                                                        VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource StateWarningStrongBrush}" />
                                              <TextBlock Grid.Column="1" Text="{Binding Agent.Note, FallbackValue={x:Null}}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                                         AutomationProperties.AutomationId="ProposalAgentNote" />
                                            </Grid>
                                          </StackPanel>
                                        </StackPanel>
                                      </inspector:InspectorRow>
                                      <ContentControl Content="{Binding Agent.Editor, FallbackValue={x:Null}}">
                                        <ContentControl.ContentTemplate>
                                          <DataTemplate DataType="canvas:ProposalAgentViewModel">
                                            <StackPanel Margin="0,0,0,6">
                                              <inspector:InspectorRow Label="Client">
                                                <ComboBox ItemsSource="{Binding Picker.ClientChoices}" SelectedItem="{Binding Picker.SelectedClient, Mode=OneWay}" SelectionChanged="OnAgentChosen"
                                                          AutomationProperties.AutomationId="ProposalAgentClient"
                                                          AutomationProperties.Name="Client" ItemTemplate="{StaticResource TrimmedChoice}" />
                                              </inspector:InspectorRow>
                                              <inspector:InspectorRow Label="Model">
                                                <ComboBox ItemsSource="{Binding Picker.ModelChoices}" SelectedItem="{Binding Picker.SelectedModel, Mode=OneWay}" SelectionChanged="OnAgentChosen"
                                                          PlaceholderText="Choose a model"
                                                          AutomationProperties.AutomationId="ProposalAgentModel"
                                                          AutomationProperties.Name="Model" ItemTemplate="{StaticResource TrimmedChoice}" />
                                              </inspector:InspectorRow>
                                              <inspector:InspectorRow Label="Reasoning" IsShown="{Binding Picker.HasReasoning}">
                                                <ComboBox ItemsSource="{Binding Picker.ReasoningChoices}" SelectedItem="{Binding Picker.SelectedReasoning, Mode=OneWay}" SelectionChanged="OnAgentChosen"
                                                          PlaceholderText="Choose a level"
                                                          AutomationProperties.AutomationId="ProposalAgentReasoning"
                                                          AutomationProperties.Name="Reasoning" ItemTemplate="{StaticResource TrimmedChoice}" />
                                              </inspector:InspectorRow>
                                            </StackPanel>
                                          </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                      </ContentControl>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <!-- The ghost wires show the connections, so their words wait behind a disclosure. -->
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding ConnectionCount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel>
                                  <ToggleButton x:Name="ConnectionsToggle" Classes="disclosure"
                                                AutomationProperties.AutomationId="ProposalConnectionsToggle"
                                                AutomationProperties.Name="{Binding ConnectionCount}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <PathIcon Theme="{StaticResource Glyph}" />
                                      <TextBlock Text="{Binding ConnectionCount}" />
                                    </StackPanel>
                                  </ToggleButton>
                                  <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding #ConnectionsToggle.IsChecked}" Margin="14,2,0,0"
                                                AutomationProperties.AutomationId="ProposalConnections"
                                                AutomationProperties.Name="Proposed connections">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </inspector:InspectorRow>
                              <!-- A new or filled task without an agent of its own, from the person or the planner, needs the planner's. -->
                              <inspector:InspectorRow Layout="Full" Label="Fall back to the planner's agent" IsShown="{Binding UsesFallback}">
                                <CheckBox IsChecked="{Binding UsePlannerAgent}"
                                          ToolTip.Tip="A new or filled task without an agent of its own, and without a choice of the planner's that this machine runs, takes the planner's client, model, and reasoning."
                                          AutomationProperties.AutomationId="ProposalUsePlannerAgent"
                                          AutomationProperties.Name="Fall back to the planner's agent">
                                  <TextBlock Text="Fall back to the planner's agent" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextStrongBrush}" />
                                </CheckBox>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DestructiveTextBrush}"
                                           AutomationProperties.AutomationId="ProposalProblem" />
                              </inspector:InspectorRow>

                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <!-- A waiting Chat planner ends its conversation by accepting, so Accept and Finish leads there. The
                           buttons share one line when they fit, else Accept and Finish takes its own line above the others. -->
                      <inspector:InspectorRow Layout="Buttons">
                        <inspector:ActionRow AutomationProperties.AutomationId="ProposalActions">
                          <Button Classes="primary" Command="{Binding AcceptAndFinishCommand}" IsVisible="{Binding ShowsAcceptAndFinish}"
                                  ToolTip.Tip="Adds and fills the chosen tasks, then marks the planner done"
                                  AutomationProperties.AutomationId="ProposalAcceptFinish"
                                  AutomationProperties.Name="Accept and Finish">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
                              <TextBlock Text="Accept and Finish" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes.primary="{Binding !ShowsAcceptAndFinish}" Classes.action="{Binding ShowsAcceptAndFinish}"
                                  Command="{Binding Proposal.AcceptCommand, FallbackValue={x:Null}}"
                                  ToolTip.Tip="{Binding Proposal.AcceptTip, FallbackValue={x:Null}}"
                                  AutomationProperties.AutomationId="AcceptProposal"
                                  AutomationProperties.Name="{Binding Proposal.AcceptLabel, FallbackValue=Accept}">
                            <TextBlock Text="{Binding Proposal.AcceptLabel, FallbackValue=Accept}" />
                          </Button>
                          <Button Classes="action" Command="{Binding Proposal.DismissCommand, FallbackValue={x:Null}}"
                                  ToolTip.Tip="{Binding Proposal.DismissTip, FallbackValue={x:Null}}"
                                  AutomationProperties.AutomationId="DismissProposal"
                                  AutomationProperties.Name="Dismiss">
                            <TextBlock Text="Dismiss" />
                          </Button>
                        </inspector:ActionRow>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- What the node hands on: its results, newest first, a review's findings, and the nodes that read them. -->
                  <inspector:InspectorSection Grid.Row="4" Key="Output" Title="Output">
                    <StackPanel>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding HasNoOutput}">
                        <TextBlock Classes="note" Text="No result yet."
                                   AutomationProperties.AutomationId="NoResult" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Buttons" Label="Results" IsShown="{Binding HasResults}">
                        <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.AutomationId="Results">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="execution:ResultViewModel">
                              <!-- A click opens the whole report, which the row cuts to its first paragraph's three lines. -->
                              <Button Classes="resultRow" ToolTip.Tip="{Binding Report}"
                                      AutomationProperties.AutomationId="ResultRow"
                                      AutomationProperties.Name="{Binding Heading}">
                                <StackPanel Spacing="2">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="resultHeading" Text="{Binding Heading}" />
                                    <TextBlock Grid.Column="1" Classes="location" Text="{Binding Commit}"
                                               IsVisible="{Binding Commit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                  </Grid>
                                  <StackPanel Spacing="2">
                                    <theme:EllipsisText x:Name="ResultText" Classes="detail resultSummary" Whole="{Binding PlainSummary}"
                                                           AutomationProperties.AutomationId="ResultSummary" />
                                    <TextBlock Classes="linkWord" Text="Show all" IsVisible="{Binding #ResultText.IsCut}"
                                               AutomationProperties.AutomationId="ResultMore" />
                                  </StackPanel>
                                </StackPanel>
                                <Button.Flyout>
                                  <Flyout Placement="LeftEdgeAlignedTop">
                                    <ScrollViewer MaxHeight="400">
                                      <SelectableTextBlock Classes="wholeText" Text="{Binding Report}" />
                                    </ScrollViewer>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </inspector:InspectorRow>
                    <inspector:InspectorRow Layout="Full" Label="Findings" IsShown="{Binding ReviewSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Spacing="6" AutomationProperties.AutomationId="Review">
                        <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                                   AutomationProperties.AutomationId="ReviewSummary" />
                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"
                                      AutomationProperties.AutomationId="Findings"
                                      AutomationProperties.Name="Findings">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </StackPanel>
                    </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Title" Label="Goes to" IsShown="{Binding HasOutputs}" />
                    <ItemsControl ItemsSource="{Binding Outputs}" AutomationProperties.AutomationId="OutputLinks">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:NodeLink">
                          <inspector:InspectorRow Layout="Buttons" Label="{Binding Node.Title}">
                            <Button Classes="nodeLink" Command="{Binding Node.SelectCommand}" ToolTip.Tip="{Binding Node.StatusLabel}"
                                    AutomationProperties.AutomationId="OutputLink"
                                    AutomationProperties.Name="{Binding Node.Title}">
                              <inspector:InspectorGrid>
                                <theme:KindTile Kind="{Binding Node.Kind}" TileSize="14" VerticalAlignment="Top" Margin="0,2,0,0" IsVisible="{Binding !IsContext}" />
                                <!-- A dashed link stands for a context connection, as on the canvas. -->
                                <Line Classes="wireSwatch" IsVisible="{Binding IsContext}" VerticalAlignment="Top" Margin="0,9,0,0"
                                      StartPoint="0,1" EndPoint="14,1" StrokeThickness="2" StrokeDashArray="2,1.5"
                                      AutomationProperties.AutomationId="ContextLink" />
                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Classes="linkTitle" Text="{Binding Node.Title}" />
                                <PathIcon Grid.Column="3" Classes="linkChevron" Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" />
                                <PathIcon Grid.Column="4" Classes="stateIcon" Classes.spin="{Binding Node.IsRunningNow}" Theme="{StaticResource Glyph}" Width="14" Height="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                                          theme:StyleClass.State="{Binding Node.State}"
                                          AutomationProperties.Name="{Binding Node.StatusLabel}" />
                              </inspector:InspectorGrid>
                            </Button>
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- What the node reads: each incoming connection's node. A person's own input is a field under Task. -->
                  <inspector:InspectorSection Grid.Row="3" Key="Input" Title="Input">
                    <StackPanel>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding HasNoInputs}">
                        <TextBlock Classes="note" Text="No input. This node starts first."
                                   AutomationProperties.AutomationId="NoInput" />
                      </inspector:InspectorRow>
                    <ItemsControl ItemsSource="{Binding Inputs}" AutomationProperties.AutomationId="InputLinks">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:NodeLink">
                          <inspector:InspectorRow Layout="Buttons" Label="{Binding Node.Title}">
                            <StackPanel>
                              <Button Classes="nodeLink" Command="{Binding Node.SelectCommand}" ToolTip.Tip="{Binding Node.StatusLabel}"
                                      AutomationProperties.AutomationId="InputLink"
                                      AutomationProperties.Name="{Binding Node.Title}">
                                <inspector:InspectorGrid>
                                  <theme:KindTile Kind="{Binding Node.Kind}" TileSize="14" VerticalAlignment="Top" Margin="0,2,0,0" IsVisible="{Binding !IsContext}" />
                                  <!-- A dashed link stands for a context connection, as on the canvas. -->
                                  <Line Classes="wireSwatch" IsVisible="{Binding IsContext}" VerticalAlignment="Top" Margin="0,9,0,0"
                                        StartPoint="0,1" EndPoint="14,1" StrokeThickness="2" StrokeDashArray="2,1.5"
                                        AutomationProperties.AutomationId="ContextLink" />
                                  <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Classes="linkTitle" Text="{Binding Node.Title}" />
                                  <PathIcon Grid.Column="3" Classes="linkChevron" Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" />
                                  <PathIcon Grid.Column="4" Classes="stateIcon" Classes.spin="{Binding Node.IsRunningNow}" Theme="{StaticResource Glyph}" Width="14" Height="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                                            theme:StyleClass.State="{Binding Node.State}"
                                            AutomationProperties.Name="{Binding Node.StatusLabel}" />
                                </inspector:InspectorGrid>
                              </Button>
                              <!-- The result this node reads from it, folded to two lines. -->
                              <StackPanel Margin="20,0,0,4" IsVisible="{Binding Node.HandsOn, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <inspector:FoldPanel x:Name="InputFold" Rest="32">
                                  <TextBlock Classes="inputResult" Text="{Binding Node.HandsOn}"
                                             AutomationProperties.AutomationId="InputResult" />
                                </inspector:FoldPanel>
                                <ToggleButton Classes="textLink" Content="{Binding #InputFold.MoreLabel}" IsChecked="{Binding #InputFold.IsOpen}" IsVisible="{Binding #InputFold.Folds}"
                                              AutomationProperties.AutomationId="InputResultMore" AutomationProperties.Name="Show the whole result" />
                              </StackPanel>
                            </StackPanel>
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- The open conversation holds the task, so this section rests folded beside it, and a click opens it to edit. -->
                  <inspector:InspectorSection Grid.Row="1" Key="Task" Title="Task" Changes="{Binding TaskChanges}" IsShown="{Binding HasFields}" RestsFolded="{Binding IsConversationShown}">
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:FieldViewModel">
                          <inspector:InspectorRow Label="{Binding Label}" LabelTip="{Binding LabelTip}"
                                                  Layout="{Binding IsMultiline, Converter={x:Static inspector:InspectorConverters.StackedWhen}}"
                                                  RevertCommand="{Binding RevertCommand}" CanRevert="{Binding CanRevert}" RevertId="{Binding RevertId}" RevertTip="Back to the blueprint's default">
                            <!-- Enter must insert the line break the domain stores, or each keystroke's round trip would rewrite the box.
                                 Until the box has focus, long text reads as text over it, in up to four lines with an ellipsis, and More opens the
                                 rest in place. A click on the text edits the source. -->
                            <StackPanel>
                            <Panel Classes="fieldText" Classes.multiline="{Binding IsMultiline}" Classes.open="{Binding IsReadingOpen}">
                              <TextBox Text="{Binding Text}" Watermark="{Binding Placeholder}"
                                       AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" NewLine="&#10;"
                                       Classes.multiline="{Binding IsMultiline}"
                                       AutomationProperties.AutomationId="{Binding AutomationId}"
                                       AutomationProperties.Name="{Binding Label}" />
                              <theme:EllipsisText x:Name="FieldReading" Classes="fieldReading" Whole="{Binding Reading}" IsHitTestVisible="False" IsVisible="{Binding IsMultiline}"
                                                  AutomationProperties.AutomationId="{Binding ReadingId}" />
                            </Panel>
                            <ToggleButton Classes="textLink" Content="{Binding ReadingToggle}" IsChecked="{Binding IsReadingOpen}"
                                          AutomationProperties.AutomationId="{Binding ReadingMoreId}" AutomationProperties.Name="{Binding ReadingToggleName}">
                              <ToggleButton.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                  <Binding Path="#FieldReading.IsCut" />
                                  <Binding Path="IsReadingOpen" />
                                </MultiBinding>
                              </ToggleButton.IsVisible>
                            </ToggleButton>
                            </StackPanel>
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Grid.Row="2" Key="Agent" Title="{Binding AgentSectionTitle}" TitleId="AgentHeading"
                                              Changes="{Binding AgentChanges}" IsShown="{Binding HasAgent}">
                    <StackPanel>
                      <inspector:InspectorRow Label="Client" Info="{Binding PermissionNote}" InfoName="{Binding PermissionSummary}" InfoId="PermissionNote"
                                              RevertCommand="{Binding RevertAgentCommand}" CanRevert="{Binding ClientChanged}" RevertId="RevertAgent" RevertTip="Back to the blueprint's or the saved client">
                        <ComboBox ItemsSource="{Binding Picker.ClientChoices}" SelectedItem="{Binding Picker.SelectedClient, Mode=OneWay}" SelectionChanged="OnAgentChosen"
                                  ToolTip.Tip="{Binding Picker.SelectedClient.Label, FallbackValue={x:Null}}"
                                  AutomationProperties.AutomationId="TaskClient"
                                  AutomationProperties.HelpText="{Binding PermissionNote}"
                                  AutomationProperties.Name="Client" ItemTemplate="{StaticResource InspectorChoice}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Model" LabelTip="{x:Static canvas:CanvasKeys.ModelHint}" IsShown="{Binding HasClient}"
                                              RevertCommand="{Binding RevertAgentCommand}" CanRevert="{Binding ModelChanged}" RevertId="RevertModel" RevertTip="Back to the blueprint's or the saved model">
                        <ComboBox ItemsSource="{Binding Picker.ModelChoices}" SelectedItem="{Binding Picker.SelectedModel, Mode=OneWay}" SelectionChanged="OnAgentChosen"
                                  PlaceholderText="Choose a model" ToolTip.Tip="{Binding Picker.SelectedModel.Label, StringFormat='{}{0} (Alt+M)', FallbackValue='Model (Alt+M)'}"
                                  AutomationProperties.AutomationId="TaskModel"
                                  AutomationProperties.Name="Model" ItemTemplate="{StaticResource InspectorChoice}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Reasoning" IsShown="{Binding Picker.HasReasoning}"
                                              RevertCommand="{Binding RevertAgentCommand}" CanRevert="{Binding ReasoningChanged}" RevertId="RevertReasoning" RevertTip="Back to the blueprint's or the saved reasoning">
                        <ComboBox ItemsSource="{Binding Picker.ReasoningChoices}" SelectedItem="{Binding Picker.SelectedReasoning, Mode=OneWay}" SelectionChanged="OnAgentChosen"
                                  PlaceholderText="Choose a level" ToolTip.Tip="{Binding Picker.SelectedReasoning.Label, FallbackValue={x:Null}}"
                                  AutomationProperties.AutomationId="TaskReasoning"
                                  AutomationProperties.Name="Reasoning" ItemTemplate="{StaticResource InspectorChoice}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Skills" IsShown="{Binding HasClient}"
                                              Info="{Binding Skills.FixedNote}" InfoName="{Binding Skills.FixedNote}" InfoId="SkillsFixed"
                                              RevertCommand="{Binding Skills.RevertCommand}" CanRevert="{Binding Skills.CanRevert}" RevertId="RevertSkills" RevertTip="Back to the blueprint's skills">
                        <Panel>
                          <ToggleButton Classes="picker" IsChecked="{Binding Skills.IsOpen}" IsVisible="{Binding Skills.CanChoose}"
                                        ToolTip.Tip="{Binding Skills.SummaryTip}"
                                        AutomationProperties.AutomationId="TaskSkills"
                                        AutomationProperties.Name="Skills">
                            <TextBlock Text="{Binding Skills.Summary}" TextTrimming="CharacterEllipsis" />
                          </ToggleButton>
                          <!-- A client that takes no choice shows a plain value, with no box and no arrow. Its glyph and tooltip say why. -->
                          <Border Classes="fixedValue" IsVisible="{Binding !Skills.CanChoose}" ToolTip.Tip="{Binding Skills.FixedNote}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Classes="value" Text="{Binding Skills.Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                         AutomationProperties.AutomationId="TaskSkillsValue" />
                              <PathIcon Grid.Column="1" Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" Width="14" Height="14"
                                        Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                          </Border>
                        </Panel>
                      </inspector:InspectorRow>
                      <!-- The picker opens its list in place, under the row at the section's whole width, so each name wraps in full. -->
                      <inspector:InspectorRow Layout="Full" Label="Skills" IsShown="{Binding Skills.ShowsList}">
                        <Border Classes="skillList" AutomationProperties.AutomationId="SkillList">
                          <StackPanel>
                            <TextBlock Classes="note" Margin="0,4" Text="{Binding Skills.ListNote}"
                                       IsVisible="{Binding Skills.ListNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="SkillListNote" />
                            <ItemsControl ItemsSource="{Binding Skills.Choices}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="canvas:SkillChoiceViewModel">
                                  <CheckBox Classes="skill" IsChecked="{Binding IsChosen}" ToolTip.Tip="{Binding Description}"
                                            AutomationProperties.AutomationId="SkillChoice"
                                            AutomationProperties.Name="{Binding Label}">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Classes.missing="{Binding !IsInstalled}" />
                                      <TextBlock Classes="letsIn" Text="{Binding LetsIn}" TextWrapping="Wrap"
                                                 IsVisible="{Binding LetsIn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 AutomationProperties.AutomationId="SkillLetsIn" />
                                    </StackPanel>
                                  </CheckBox>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="note" Margin="0,4" Text="{Binding Skills.ListFooter}"
                                       IsVisible="{Binding Skills.ListFooter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="SkillListFooter" />
                          </StackPanel>
                        </Border>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full" Label="Skills" IsShown="{Binding Skills.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="note" Text="{Binding Skills.Note}"
                                   AutomationProperties.AutomationId="SkillsNote" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Mode" IsShown="{Binding HasConversation}"
                                              Info="{Binding ConversationNote}" InfoName="{Binding ConversationSummary}" InfoId="ConversationNote"
                                              RevertCommand="{Binding RevertConversationCommand}" CanRevert="{Binding CanRevertConversation}" RevertId="RevertConversation" RevertTip="Back to the blueprint's mode">
                        <ComboBox ItemsSource="{Binding ConversationChoices}" SelectedItem="{Binding SelectedConversation, Mode=OneWay}" SelectionChanged="OnConversationChosen"
                                  AutomationProperties.AutomationId="TaskConversation"
                                  AutomationProperties.HelpText="{Binding ConversationNote}"
                                  AutomationProperties.Name="Mode" ItemTemplate="{StaticResource InspectorChoice}" />
                      </inspector:InspectorRow>
                      <!-- What the blueprint tells this node's agent, with the node's own values in it. A blueprint edits the template. -->
                      <inspector:InspectorRow Label="Prompt" LabelTip="System prompt" IsShown="{Binding HasSystemPrompt}">
                        <ToggleButton x:Name="PromptOpen" Classes="disclosure rowDisclosure" ToolTip.Tip="Show what the blueprint tells this agent"
                                      AutomationProperties.AutomationId="SystemPromptMore" AutomationProperties.Name="Show the whole system prompt">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Theme="{StaticResource Glyph}" />
                            <TextBlock Text="Show prompt" />
                          </StackPanel>
                        </ToggleButton>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full" Label="Prompt" IsShown="{Binding #PromptOpen.IsChecked}">
                        <Border Classes="templatePreview">
                          <conversation:MarkdownView Classes="promptView" Markdown="{Binding SystemPrompt}"
                                                     AutomationProperties.AutomationId="SystemPrompt" />
                        </Border>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="canvas:ConnectionViewModel">
                <inspector:InspectorSection Key="Connection" Title="Connection">
                  <StackPanel>
                    <inspector:InspectorRow Label="From">
                      <inspector:InspectorRow.Lead>
                        <theme:KindTile Kind="{Binding From.Kind}" TileSize="14" />
                      </inspector:InspectorRow.Lead>
                      <Button Classes="rowLink" Command="{Binding From.SelectCommand}" ToolTip.Tip="Select this node"
                              AutomationProperties.AutomationId="ConnectionFrom"
                              AutomationProperties.Name="{Binding From.Title}">
                        <TextBlock Classes="value" Text="{Binding From.Title}" />
                      </Button>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="To">
                      <inspector:InspectorRow.Lead>
                        <theme:KindTile Kind="{Binding To.Kind}" TileSize="14" />
                      </inspector:InspectorRow.Lead>
                      <Button Classes="rowLink" Command="{Binding To.SelectCommand}" ToolTip.Tip="Select this node"
                              AutomationProperties.AutomationId="ConnectionTo"
                              AutomationProperties.Name="{Binding To.Title}">
                        <TextBlock Classes="value" Text="{Binding To.Title}" />
                      </Button>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="Kind" Icon="{StaticResource IconLink}">
                      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2">
                        <!-- Each swatch draws its kind's line as a wire draws it, so the buttons double as the legend for the canvas. -->
                        <UniformGrid Columns="2">
                          <Button Classes="segment"
                                  Command="{Binding SetKindCommand}"
                                  CommandParameter="{x:Static workflows:ConnectionKind.Dependency}"
                                  AutomationProperties.AutomationId="KindDependency"
                                  AutomationProperties.Name="Dependency">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Line Classes="wireSwatch" StartPoint="0,1" EndPoint="10,1" StrokeThickness="2" VerticalAlignment="Center" />
                              <TextBlock Text="Dependency" />
                            </StackPanel>
                          </Button>
                          <Button Classes="segment"
                                  Command="{Binding SetKindCommand}"
                                  CommandParameter="{x:Static workflows:ConnectionKind.Context}"
                                  AutomationProperties.AutomationId="KindContext"
                                  AutomationProperties.Name="Context">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Line Classes="wireSwatch" StartPoint="0,1" EndPoint="10,1" StrokeThickness="2" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                              <TextBlock Text="Context" />
                            </StackPanel>
                          </Button>
                        </UniformGrid>
                      </Border>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Layout="Buttons">
                      <Button Classes="destructive" Command="{Binding DeleteCommand}" Margin="0,6,0,0"
                              AutomationProperties.AutomationId="DeleteConnection"
                              AutomationProperties.Name="Delete Connection">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDelete}" Width="14" Height="14" />
                          <TextBlock Text="Delete Connection" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </inspector:InspectorRow>
                  </StackPanel>
                </inspector:InspectorSection>
              </DataTemplate>

              <DataTemplate DataType="inspector:WorkflowOverviewViewModel">
                <StackPanel>
                  <inspector:InspectorSection Key="Overview" Title="Overview" IsShown="{Binding HasStates}">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding States}" AutomationProperties.AutomationId="WorkflowStates">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="inspector:StateCount">
                          <!-- A click goes to the first node in that state. -->
                          <inspector:InspectorRow Layout="Buttons" Label="{Binding Label}">
                            <Button Classes="nodeLink" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tip}"
                                    AutomationProperties.AutomationId="StateRow"
                                    AutomationProperties.Name="{Binding Label}">
                              <inspector:InspectorGrid>
                                <PathIcon Classes="stateIcon spin" IsVisible="{Binding IsRunning}" Theme="{StaticResource Glyph}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
                                <theme:StateBadge Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" State="{Binding State}" Why="{Binding Why}" IsVisible="{Binding !IsRunning}" />
                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Classes="linkTitle" Text="{Binding Label}" />
                                <inspector:InkAlignedText Grid.Column="4" Classes="count" Text="{Binding Count}" AutomationProperties.AutomationId="StateCount" />
                              </inspector:InspectorGrid>
                            </Button>
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </inspector:InspectorSection>
                  <inspector:InspectorSection Key="Library" Title="Library">
                    <blueprints:PaletteView DataContext="{Binding Blueprints}" />
                  </inspector:InspectorSection>
                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Panel>
</UserControl>