<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:conversation="using:IDevelop.Desktop.Conversation"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:executionCore="using:IDevelop.Execution"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             xmlns:workflows="using:IDevelop.Workflows"
             x:Class="IDevelop.Desktop.Inspector.InspectorView"
             x:DataType="canvas:WorkflowCanvasViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Inspector/InspectorStyles.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- An overlay scroll bar 10 px wide, expanded, fits in the panel's 12 px right inset, so it never covers a row's
         buttons, and the rows never move for it. -->
    <x:Double x:Key="ScrollBarSize">10</x:Double>
    <!-- One finding of a review, in the Review node's Findings and in an Approval's handed-on review alike: its heading, with
         its severity at the card's right edge where every card keeps it, then its location, the reviewer's latest words, and
         how it was or would be settled: the change that would settle it, the implementer's answer, and why the reviewer
         withdrew it. A verdict that gave no severity or location shows neither. -->
    <DataTemplate x:Key="FindingTemplate" DataType="execution:FindingViewModel">
      <Border Padding="10,8" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
              BorderBrush="{DynamicResource Border80Brush}" Background="{DynamicResource SurfaceRaisedBrush}"
              Opacity="{Binding Emphasis}">
        <StackPanel Spacing="4">
          <!-- The chip keeps to 96 px, so an odd long severity wraps inside it rather than pushing it past the card, and the
               heading sits on the chip's first line. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="caption" Text="{Binding Heading}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,3,0,0" />
            <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top" MaxWidth="96"
                    IsVisible="{Binding Severity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    AutomationProperties.AutomationId="FindingSeverity">
              <TextBlock Text="{Binding Severity}" />
            </Border>
          </Grid>
          <TextBlock Classes="location" Text="{Binding Location}"
                     IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     AutomationProperties.AutomationId="FindingLocation" />
          <TextBlock Text="{Binding Reviewer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="{Binding Change}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding Change, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Implementer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding Implementer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Withdrawal}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding Withdrawal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Panel>
    <!-- The blueprint editor takes the panel while it is open. Its sections fold apart from the inspector's. -->
    <ScrollViewer x:Name="EditorHost" IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl x:Name="Editor" Content="{Binding Blueprints.Editor}" Margin="12,12,12,16">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="blueprints:BlueprintEditorViewModel">
            <blueprints:BlueprintEditorView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </ScrollViewer>

    <!-- The header and the filter stay put while the sections scroll. The selection fills both, or the workflow
         when nothing is selected. -->
    <DockPanel IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNull}}">
      <ContentControl DockPanel.Dock="Top">
        <ContentControl.Content>
          <MultiBinding Converter="{x:Static inspector:InspectorConverters.FirstSet}">
            <Binding Path="Inspected" />
            <Binding Path="Overview" />
          </MultiBinding>
        </ContentControl.Content>
        <ContentControl.DataTemplates>
          <DataTemplate DataType="canvas:TaskNodeViewModel">
            <Border Classes="inspectorHeader" AutomationProperties.AutomationId="InspectorHeader">
              <inspector:InspectorGrid>
                <!-- A title line and a kind line of fixed heights, so every header is as tall until a long title wraps. The
                     title ends at the value edge, before the trailing column, where More sits on its line; the kind line,
                     with nothing after it, takes the trailing column too. -->
                <Grid Grid.ColumnSpan="5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Static inspector:InspectorGrid.TrailColumn}" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="{x:Static inspector:InspectorGrid.LineHeight}" />
                    <RowDefinition Height="Auto" MinHeight="{x:Static inspector:InspectorGrid.SubtitleHeight}" />
                  </Grid.RowDefinitions>
                  <theme:KindTile Grid.RowSpan="2" Classes="headerTile" Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="32" />
                  <!-- Until the box has focus, a text block over it shows the title, wrapped as the box wraps it, so the header
                       reads as a title rather than a field. -->
                  <Panel Grid.Column="2" Classes="headerTitle" Margin="-6,0,0,0">
                    <TextBox Classes="headerTitle" Text="{Binding Title}"
                             AutomationProperties.AutomationId="TaskTitle"
                             AutomationProperties.Name="Title" />
                    <TextBlock Classes="headerTitle" Text="{Binding Title}" IsHitTestVisible="False"
                               AutomationProperties.AccessibilityView="Raw" />
                  </Panel>
                  <!-- Where the kind line does not fit, the version and its help glyph go under the type, without the dot. -->
                  <inspector:SeparatedLine Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="InspectorKind">
                    <TextBlock Classes="kindLine" Text="{Binding TypeName}"
                               AutomationProperties.AutomationId="TaskType" />
                    <TextBlock Classes="kindLine" Text=" · " ClipToBounds="True" />
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Classes="kindLine" Text="{Binding TypeVersion}"
                                 AutomationProperties.AutomationId="TaskTypeVersion" />
                      <Border Classes="infoGlyph kindHelp" Margin="2,0,0,0" ToolTip.Tip="{Binding Description}"
                              IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconHelp}" />
                      </Border>
                    </StackPanel>
                  </inspector:SeparatedLine>
                  <Button Grid.Column="3" Classes="glyph" ToolTip.Tip="More" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                          AutomationProperties.AutomationId="InspectorMore"
                          AutomationProperties.Name="More">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconMore}" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Derive Blueprint…" Command="{Binding DeriveCommand}">
                          <MenuItem.Icon>
                            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save as Blueprint…" Command="{Binding SaveAsBlueprintCommand}">
                          <MenuItem.Icon>
                            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </inspector:InspectorGrid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="canvas:ConnectionViewModel">
            <Border Classes="inspectorHeader" AutomationProperties.AutomationId="InspectorHeader">
              <inspector:InspectorGrid>
                <!-- A title line and a kind line of fixed heights, so every header is as tall until a long title wraps. The
                     title ends at the value edge, before the trailing column, where More sits on its line; the kind line,
                     with nothing after it, takes the trailing column too. -->
                <Grid Grid.ColumnSpan="5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Static inspector:InspectorGrid.TrailColumn}" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="{x:Static inspector:InspectorGrid.LineHeight}" />
                    <RowDefinition Height="Auto" MinHeight="{x:Static inspector:InspectorGrid.SubtitleHeight}" />
                  </Grid.RowDefinitions>
                  <Border Grid.RowSpan="2" Classes="neutralTile headerTile">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconLink}" />
                  </Border>
                  <TextBlock Grid.Column="2" Classes="headerName" Text="{Binding Kind}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="kindLine" Text="Connection" />
                </Grid>
              </inspector:InspectorGrid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="inspector:WorkflowOverviewViewModel">
            <Border Classes="inspectorHeader" AutomationProperties.AutomationId="InspectorHeader">
              <inspector:InspectorGrid>
                <!-- A title line and a kind line of fixed heights, so every header is as tall until a long title wraps. The
                     title ends at the value edge, before the trailing column, where More sits on its line; the kind line,
                     with nothing after it, takes the trailing column too. -->
                <Grid Grid.ColumnSpan="5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Static inspector:InspectorGrid.TrailColumn}" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="{x:Static inspector:InspectorGrid.LineHeight}" />
                    <RowDefinition Height="Auto" MinHeight="{x:Static inspector:InspectorGrid.SubtitleHeight}" />
                  </Grid.RowDefinitions>
                  <Border Grid.RowSpan="2" Classes="neutralTile headerTile">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFlowchart}" />
                  </Border>
                  <TextBlock Grid.Column="2" Classes="headerName" Text="{Binding Name}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="kindLine" Text="{Binding TaskCount}" />
                </Grid>
              </inspector:InspectorGrid>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <Border DockPanel.Dock="Top" Classes="filterBar">
        <inspector:InspectorGrid>
          <TextBox x:Name="Filter" Grid.ColumnSpan="4" Classes="search clearButton" Watermark="Filter properties"
                   TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown"
                   AutomationProperties.AutomationId="InspectorFilter"
                   AutomationProperties.Name="Filter properties" />
          <Button Grid.Column="4" Classes="glyph" HorizontalAlignment="Right" ToolTip.Tip="Expand or collapse sections"
                  AutomationProperties.AutomationId="InspectorTools"
                  AutomationProperties.Name="Sections">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFilter}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Expand All" Click="OnExpandAll" AutomationProperties.AutomationId="ExpandAllSections">
                  <MenuItem.Icon>
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronDown}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse All" Click="OnCollapseAll" AutomationProperties.AutomationId="CollapseAllSections">
                  <MenuItem.Icon>
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </inspector:InspectorGrid>
      </Border>

      <ScrollViewer>
        <StackPanel Margin="12,0,12,16">
          <ContentControl>
            <ContentControl.Content>
              <MultiBinding Converter="{x:Static inspector:InspectorConverters.FirstSet}">
                <Binding Path="Inspected" />
                <Binding Path="Overview" />
              </MultiBinding>
            </ContentControl.Content>
            <ContentControl.DataTemplates>
              <DataTemplate DataType="canvas:TaskNodeViewModel">
                <StackPanel>
                  <inspector:InspectorSection Key="Task" Title="Task" Changes="{Binding TaskChanges}" IsShown="{Binding HasFields}">
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:FieldViewModel">
                          <inspector:InspectorRow Label="{Binding Label}" LabelTip="{Binding LabelTip}"
                                                  Icon="{Binding IconKey, Converter={x:Static inspector:InspectorConverters.Icon}}"
                                                  Layout="{Binding IsMultiline, Converter={x:Static inspector:InspectorConverters.StackedWhen}}"
                                                  RevertCommand="{Binding RevertCommand}" CanRevert="{Binding CanRevert}" RevertId="{Binding RevertId}">
                            <!-- Enter must insert the line break the domain stores, or each keystroke's round trip would rewrite the box. -->
                            <TextBox Text="{Binding Text}"
                                     AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" NewLine="&#10;"
                                     Classes.multiline="{Binding IsMultiline}"
                                     AutomationProperties.AutomationId="{Binding AutomationId}"
                                     AutomationProperties.Name="{Binding Label}" />
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Agent" Title="{Binding AgentSectionTitle}" TitleId="AgentHeading"
                                              Changes="{Binding AgentChanges}" IsShown="{Binding HasAgent}">
                    <StackPanel>
                      <inspector:InspectorRow Label="Client" Icon="{StaticResource IconAgent}" Info="{Binding PermissionNote}" InfoName="{Binding PermissionSummary}" InfoId="PermissionNote"
                                              RevertCommand="{Binding RevertAgentCommand}" CanRevert="{Binding CanRevertAgent}" RevertId="RevertAgent">
                        <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding SelectedClient, Mode=OneWay}" SelectionChanged="OnClientChosen"
                                  AutomationProperties.AutomationId="TaskClient"
                                  AutomationProperties.Name="Client">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:ClientChoice">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Model" Icon="{StaticResource IconModel}" IsShown="{Binding HasClient}">
                        <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel, Mode=OneWay}" SelectionChanged="OnModelChosen"
                                  PlaceholderText="Choose a model"
                                  AutomationProperties.AutomationId="TaskModel"
                                  AutomationProperties.Name="Model">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:Choice">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Reasoning" Icon="{StaticResource IconReasoning}" IsShown="{Binding HasReasoning}">
                        <ComboBox ItemsSource="{Binding ReasoningChoices}" SelectedItem="{Binding SelectedReasoning, Mode=OneWay}" SelectionChanged="OnReasoningChosen"
                                  PlaceholderText="Choose a level"
                                  AutomationProperties.AutomationId="TaskReasoning"
                                  AutomationProperties.Name="Reasoning">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:Choice">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                      <!-- The skill picker opens its list in place, under the box, so the list keeps the panel's edges and scroll. -->
                      <inspector:InspectorRow Label="Skills" Icon="{StaticResource IconSkills}" IsShown="{Binding HasClient}"
                                              RevertCommand="{Binding Skills.RevertCommand}" CanRevert="{Binding Skills.CanRevert}" RevertId="RevertSkills">
                        <StackPanel Spacing="4">
                          <ToggleButton Classes="picker" IsChecked="{Binding Skills.IsOpen}" IsEnabled="{Binding Skills.CanChoose}"
                                        ToolTip.Tip="{Binding Skills.SummaryTip}"
                                        AutomationProperties.AutomationId="TaskSkills"
                                        AutomationProperties.Name="Skills">
                            <TextBlock Text="{Binding Skills.Summary}" TextWrapping="Wrap" />
                          </ToggleButton>
                          <Border Classes="skillList" IsVisible="{Binding Skills.ShowsList}" AutomationProperties.AutomationId="SkillList">
                            <StackPanel>
                              <TextBlock Classes="note" Margin="0,4" Text="{Binding Skills.ListNote}"
                                         IsVisible="{Binding Skills.ListNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         AutomationProperties.AutomationId="SkillListNote" />
                              <ItemsControl ItemsSource="{Binding Skills.Choices}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="canvas:SkillChoiceViewModel">
                                    <CheckBox Classes="skill" IsChecked="{Binding IsChosen}" ToolTip.Tip="{Binding Description}"
                                              AutomationProperties.AutomationId="SkillChoice"
                                              AutomationProperties.Name="{Binding Label}">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Classes.missing="{Binding !IsInstalled}" />
                                        <TextBlock Classes="letsIn" Text="{Binding LetsIn}" TextWrapping="Wrap"
                                                   IsVisible="{Binding LetsIn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   AutomationProperties.AutomationId="SkillLetsIn" />
                                      </StackPanel>
                                    </CheckBox>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Classes="note" Margin="0,4" Text="{Binding Skills.ListFooter}"
                                         IsVisible="{Binding Skills.ListFooter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         AutomationProperties.AutomationId="SkillListFooter" />
                            </StackPanel>
                          </Border>
                          <TextBlock Classes="note" Text="{Binding Skills.Note}"
                                     IsVisible="{Binding Skills.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     AutomationProperties.AutomationId="SkillsNote" />
                        </StackPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Conversation" Icon="{StaticResource IconConversation}" IsShown="{Binding HasConversation}"
                                              Info="{Binding ConversationNote}" InfoName="{Binding ConversationSummary}" InfoId="ConversationNote"
                                              RevertCommand="{Binding RevertConversationCommand}" CanRevert="{Binding CanRevertConversation}" RevertId="RevertConversation">
                        <ComboBox ItemsSource="{Binding ConversationChoices}" SelectedItem="{Binding SelectedConversation, Mode=OneWay}" SelectionChanged="OnConversationChosen"
                                  AutomationProperties.AutomationId="TaskConversation"
                                  AutomationProperties.Name="Conversation">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:Choice">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Run" Title="Run">
                    <StackPanel>
                      <!-- A task that the canvas's workflow run owns shows the run's state, not its own Run and Cancel. -->
                      <!-- Stacked, so a long status such as what a pending task waits for has the section's whole width. -->
                      <inspector:InspectorRow Label="Status" Layout="Stacked" Icon="{StaticResource IconStatus}" IsShown="{Binding ShowsRunState}">
                        <Border Classes="pill" HorizontalAlignment="Left"
                                Classes.running="{Binding RunTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                                Classes.complete="{Binding RunTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                                Classes.problem="{Binding RunTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                                Classes.waiting="{Binding RunTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}"
                                Classes.warning="{Binding RunTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Warning}}">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding RunStatusLabel}">
                            <PathIcon Theme="{StaticResource Glyph}" IsVisible="{Binding RunHasGlyph}" />
                            <TextBlock Grid.Column="1" Text="{Binding RunStatusLabel}"
                                       AutomationProperties.AutomationId="RunTaskStatus" />
                          </Grid>
                        </Border>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowsRunState" />
                            <Binding Path="RunOwner" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <TextBlock Text="{Binding RunOwner}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   AutomationProperties.AutomationId="RunOwner" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowsRunState" />
                            <Binding Path="RunDetail" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <TextBlock Text="{Binding RunDetail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                   AutomationProperties.AutomationId="RunTaskDetail" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Buttons" IsShown="{Binding ShowsCancel}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="primary" Command="{Binding RunCommand}" IsVisible="{Binding ShowsRunControls}"
                                  ToolTip.Tip="{Binding RunRefusal}" ToolTip.ShowOnDisabled="True"
                                  AutomationProperties.AutomationId="RunTask"
                                  AutomationProperties.Name="Run">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" Width="14" Height="14" />
                              <TextBlock Text="Run" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding CancelCommand}" IsVisible="{Binding ShowsCancelButton}"
                                  AutomationProperties.AutomationId="CancelRun"
                                  AutomationProperties.Name="Cancel run">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                              <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Buttons" IsShown="{Binding ShowsFixChoice}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="primary" Command="{Binding ContinueFixCommand}"
                                  AutomationProperties.AutomationId="ContinueFix"
                                  AutomationProperties.Name="Continue fix">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" Width="14" Height="14" />
                              <TextBlock Text="Continue fix" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding RetryFixCommand}"
                                  AutomationProperties.AutomationId="RetryFix"
                                  AutomationProperties.Name="Retry fix">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                              <TextBlock Text="Retry fix" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <!-- A conflict between the task's predecessors that no Merge node takes: the person fixes it in its worktree. -->
                      <inspector:InspectorRow Layout="Buttons" IsShown="{Binding ShowsConflictActions}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="action" Command="{Binding OpenConflictCommand}"
                                  AutomationProperties.AutomationId="OpenConflict"
                                  AutomationProperties.Name="Open worktree">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" Width="14" Height="14" />
                              <TextBlock Text="Open worktree" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="primary" Command="{Binding MarkResolvedCommand}"
                                  AutomationProperties.AutomationId="MarkResolved"
                                  AutomationProperties.Name="Mark resolved">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
                              <TextBlock Text="Mark resolved" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <!-- Cancel of a run's task while its attempt runs or waits, which the run then shows as Cancelled with Retry. -->
                      <inspector:InspectorRow Layout="Buttons" IsShown="{Binding ShowsRunCancel}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="action" Command="{Binding CancelInRunCommand}"
                                  AutomationProperties.AutomationId="CancelRunTask"
                                  AutomationProperties.Name="Cancel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                              <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <!-- Retry of a run's task that ended without a result asks first, here, wherever the person chose it. -->
                      <inspector:InspectorRow Layout="Buttons" IsShown="{Binding ShowsRetryButton}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="primary" Command="{Binding RetryCommand}"
                                  AutomationProperties.AutomationId="RetryTask"
                                  AutomationProperties.Name="Retry">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                              <TextBlock Text="Retry" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding ConfirmingRetry}">
                        <TextBlock Text="{Binding RetryConfirmation}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                   AutomationProperties.AutomationId="RetryConfirmation" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Buttons" IsShown="{Binding ConfirmingRetry}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="primary" Command="{Binding ConfirmRetryCommand}"
                                  AutomationProperties.AutomationId="ConfirmRetry"
                                  AutomationProperties.Name="Retry">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                              <TextBlock Text="Retry" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding KeepRetryCommand}"
                                  AutomationProperties.AutomationId="KeepRetry"
                                  AutomationProperties.Name="Not now">
                            <TextBlock Text="Not now" VerticalAlignment="Center" />
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowsRunControls" />
                            <Binding Path="StartProblem" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding StartProblem}" Background="Transparent">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" Width="14" Height="14"
                                    VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource StateWarningStrongBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding StartProblem}" TextWrapping="Wrap"
                                     FontSize="12" Foreground="{DynamicResource TextBrush}"
                                     AutomationProperties.AutomationId="StartProblem" />
                        </Grid>
                      </inspector:InspectorRow>
                      <ContentControl Content="{Binding LastRun}">
                        <ContentControl.ContentTemplate>
                          <!-- The status and why a run ended show even while a proposal hides the rest of the run. -->
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <StackPanel>
                              <inspector:InspectorRow Label="Status" Layout="Stacked" Icon="{StaticResource IconStatus}">
                                <Border Classes="pill" HorizontalAlignment="Left"
                                        Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                                        Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                                        Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                                        Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Theme="{StaticResource Glyph}" />
                                    <TextBlock Text="{Binding StatusLabel}" AutomationProperties.AutomationId="LastRunStatus" />
                                  </StackPanel>
                                </Border>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           AutomationProperties.AutomationId="LastRunDetail" />
                              </inspector:InspectorRow>
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <!-- What ran and when, as chips whose tooltips say it in full, under their labels like the status above, so
                           the chips keep to one line at every width. -->
                      <ContentControl Content="{Binding LastRun}" IsVisible="{Binding ShowsRunControls}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <StackPanel>
                              <inspector:InspectorRow Label="Agent" Layout="Stacked" Icon="{StaticResource IconAgent}">
                                <ItemsControl ItemsSource="{Binding Agent}" ToolTip.Tip="{Binding Configuration}" Background="Transparent"
                                              AutomationProperties.AutomationId="LastRunConfiguration"
                                              AutomationProperties.Name="{Binding Configuration}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel Classes="chips" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Label="Time" Layout="Stacked" Icon="{StaticResource IconTime}">
                                <WrapPanel Classes="chips" ToolTip.Tip="{Binding Timing}" Background="Transparent"
                                           AutomationProperties.AutomationId="LastRunTiming"
                                           AutomationProperties.Name="{Binding Timing}">
                                  <Border Classes="chip">
                                    <inspector:RelativeTime At="{Binding Started}" />
                                  </Border>
                                  <Border Classes="chip" IsVisible="{Binding Took, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Took}" />
                                  </Border>
                                </WrapPanel>
                              </inspector:InspectorRow>
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- An Approval node's request in the run: what approving hands on, and the two answers. -->
                  <inspector:InspectorSection Key="Approval" Title="Approval" IsShown="{Binding Gate, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl Content="{Binding Gate}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate DataType="execution:GateViewModel">
                          <StackPanel>
                            <!-- The Run section above shows the request's status, so this section shows what it is about. -->
                            <inspector:InspectorRow Label="Request" Icon="{StaticResource IconVersion}">
                              <TextBlock Text="{Binding RequestLabel}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                         AutomationProperties.AutomationId="GateRequest" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Label="Hands on" Layout="Stacked" Icon="{StaticResource IconBrief}" IsShown="{Binding HasInputs}">
                              <!-- Each input shows its heading, then its report as Markdown in a card, as the conversation renders
                                   it. A review shows its verdict as a status and every finding it raised on the Review node's
                                   finding cards, with no card around them, and keeps its recorded report, with the raw verdict,
                                   behind a disclosure. Everything grows with what it holds, so the panel's own scroll is the only one. -->
                              <ItemsControl ItemsSource="{Binding Inputs}" AutomationProperties.AutomationId="GateInputs">
                                <ItemsControl.Styles>
                                  <StyleInclude Source="/Conversation/ConversationStyles.axaml" />
                                </ItemsControl.Styles>
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="execution:GateInputViewModel">
                                    <!-- Every input's heading starts at the row's edge, above its report's card or its review. -->
                                    <StackPanel Spacing="8">
                                      <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium"
                                                 Foreground="{DynamicResource TextStrongBrush}"
                                                 AutomationProperties.AutomationId="GateInputHeading" />
                                      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                              IsVisible="{Binding !IsReview}">
                                        <conversation:MarkdownView Markdown="{Binding Report}" FitsCode="True"
                                                                   AutomationProperties.AutomationId="GateReport"
                                                                   AutomationProperties.Name="What approving hands on" />
                                      </Border>
                                      <StackPanel Spacing="8" IsVisible="{Binding IsReview}" AutomationProperties.AutomationId="GateReview">
                                        <Border Classes="pill" HorizontalAlignment="Left" Classes.complete="{Binding Approves}" Classes.waiting="{Binding !Approves}">
                                          <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Theme="{StaticResource Glyph}" />
                                            <TextBlock Text="{Binding Verdict}" AutomationProperties.AutomationId="GateVerdict" />
                                          </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"
                                                      IsVisible="{Binding NoFindings, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                      AutomationProperties.AutomationId="GateFindings"
                                                      AutomationProperties.Name="Findings">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Classes="caption" Text="{Binding NoFindings}" TextWrapping="Wrap"
                                                   IsVisible="{Binding NoFindings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   AutomationProperties.AutomationId="GateNoFindings" />
                                        <StackPanel Spacing="4">
                                          <ToggleButton x:Name="RawToggle" Classes="disclosure"
                                                        AutomationProperties.AutomationId="GateRawToggle"
                                                        AutomationProperties.Name="Raw data">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                              <PathIcon Theme="{StaticResource Glyph}" />
                                              <TextBlock Text="Raw data" />
                                            </StackPanel>
                                          </ToggleButton>
                                          <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                                  IsVisible="{Binding #RawToggle.IsChecked}">
                                            <conversation:MarkdownView Markdown="{Binding Report}" FitsCode="True"
                                                                       AutomationProperties.AutomationId="GateRaw"
                                                                       AutomationProperties.Name="The review's recorded report" />
                                          </Border>
                                        </StackPanel>
                                      </StackPanel>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding SentBackReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding SentBackReason, StringFormat='Sent back: {0}'}" TextWrapping="Wrap" FontSize="12"
                                         Foreground="{DynamicResource TextBrush}"
                                         AutomationProperties.AutomationId="GateSentBackReason" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding IsWaiting}">
                              <TextBox Text="{Binding Reason}" AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="48"
                                       Watermark="Why send it back? The reason stays with the request."
                                       AutomationProperties.AutomationId="GateReason"
                                       AutomationProperties.Name="Reason to send back" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Buttons" IsShown="{Binding IsWaiting}">
                              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                <Button Classes="primary" Command="{Binding ApproveCommand}"
                                        AutomationProperties.AutomationId="ApproveGate"
                                        AutomationProperties.Name="Approve">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
                                    <TextBlock Text="Approve" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding SendBackCommand}"
                                        AutomationProperties.AutomationId="SendBackGate"
                                        AutomationProperties.Name="Send back">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconUndo}" Width="14" Height="14" />
                                    <TextBlock Text="Send back" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                              </WrapPanel>
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Classes="caption" Text="{Binding Notice}" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="GateNotice" />
                            </inspector:InspectorRow>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </inspector:InspectorSection>

                  <!-- A block or an unresolved turn in the run: its evidence, then Close as stopped. -->
                  <inspector:InspectorSection Key="Recovery" Title="Recovery" IsShown="{Binding Recovery, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl Content="{Binding Recovery}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate DataType="execution:RecoveryViewModel">
                          <StackPanel>
                            <inspector:InspectorRow Label="Attempt" Layout="Stacked" Icon="{StaticResource IconVersion}"
                                                    IsShown="{Binding AttemptText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding AttemptText}" TextWrapping="Wrap" FontSize="13"
                                         Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="RecoveryAttempt" />
                            </inspector:InspectorRow>
                            <!-- Every block that holds the task. -->
                            <ItemsControl ItemsSource="{Binding Blocks}" AutomationProperties.AutomationId="RecoveryBlocks">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="execution:RecoveryBlock">
                                  <inspector:InspectorRow Label="Block" Layout="Stacked" Icon="{StaticResource IconStateFailed}">
                                    <StackPanel Spacing="4">
                                      <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                 AutomationProperties.AutomationId="RecoveryBlockProblem" />
                                      <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap"
                                                 AutomationProperties.AutomationId="RecoveryBlockDetail" />
                                    </StackPanel>
                                  </inspector:InspectorRow>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <inspector:InspectorRow Label="Client" Layout="Stacked" Icon="{StaticResource IconAgent}"
                                                    IsShown="{Binding ClientText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding ClientText}" TextWrapping="Wrap" FontSize="13"
                                         Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="RecoveryClient" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Label="Turn end" Layout="Stacked" Icon="{StaticResource IconStatus}"
                                                    IsShown="{Binding TurnEndText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding TurnEndText}" TextWrapping="Wrap" FontSize="13"
                                         Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="RecoveryTurnEnd" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding NoActionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Classes="caption" Text="{Binding NoActionNote}" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="RecoveryNoAction" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding UnsettledNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding UnsettledNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                         AutomationProperties.AutomationId="RecoveryUnsettled" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding CanClose}">
                              <StackPanel Spacing="6">
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Close as stopped records that its client stopped, with your reason. It records no result, and the run never starts this turn again." />
                                <TextBlock Text="{Binding StillRuns}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           IsVisible="{Binding StillRuns, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           AutomationProperties.AutomationId="RecoveryStillRuns" />
                              </StackPanel>
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding CanClose}">
                              <TextBox Text="{Binding Reason}" AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="48"
                                       Watermark="What did you check? For example, that the client no longer runs."
                                       AutomationProperties.AutomationId="RecoveryReason"
                                       AutomationProperties.Name="Why you close the turn" />
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Buttons" IsShown="{Binding CanClose}">
                              <Button Classes="action" HorizontalAlignment="Left" Command="{Binding CloseCommand}"
                                      AutomationProperties.AutomationId="CloseAsStopped"
                                      AutomationProperties.Name="Close as stopped">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                                  <TextBlock Text="Close as stopped" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </inspector:InspectorRow>
                            <inspector:InspectorRow Layout="Full" IsShown="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Classes="caption" Text="{Binding Notice}" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="RecoveryNotice" />
                            </inspector:InspectorRow>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Proposal" Title="Proposal" IsShown="{Binding Proposal, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                      <ContentControl Content="{Binding Proposal}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="canvas:ProposalViewModel">
                            <StackPanel AutomationProperties.AutomationId="Proposal">
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding CheckingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" Width="14" Height="14"
                                            VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CheckingNote}" TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="ProposalCheckingNote" />
                                </Grid>
                              </inspector:InspectorRow>
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <!-- The tile says the kind and the ghost wires say the connections, so a row is its title. A new
                                       task's agent and the planner's reason follow under the title, and its pickers open under the row. -->
                                  <DataTemplate DataType="canvas:ProposalItemViewModel">
                                    <StackPanel AutomationProperties.AutomationId="ProposalEntry">
                                      <inspector:InspectorRow Classes="firstLine" Layout="Full" Label="{Binding Label}">
                                        <inspector:InspectorRow.Actions>
                                          <Button Classes="glyph" Classes.open="{Binding Agent.IsEditing, FallbackValue=False}"
                                                  IsVisible="{Binding HasAgent}" Command="{Binding Agent.EditCommand}"
                                                  ToolTip.Tip="Change the agent"
                                                  AutomationProperties.AutomationId="ProposalAgentEdit"
                                                  AutomationProperties.Name="{Binding Agent.EditName}">
                                            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconEdit}" Width="14" Height="14" />
                                          </Button>
                                        </inspector:InspectorRow.Actions>
                                        <StackPanel>
                                          <!-- The box takes the tile and the title only, so a click on the agent or the reason ticks nothing. -->
                                          <CheckBox Padding="8,0,0,0"
                                                    IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanChoose}" ToolTip.Tip="{Binding Tip}"
                                                    AutomationProperties.AutomationId="ProposalItem"
                                                    AutomationProperties.Name="{Binding Label}">
                                            <!-- The box sits in the middle of the check box's first 32 px, so the title line does too. -->
                                            <Grid ColumnDefinitions="18,*" ColumnSpacing="8" Margin="0,7">
                                              <theme:KindTile Kind="{Binding Kind}" TileSize="18" VerticalAlignment="Top" />
                                              <StackPanel Grid.Column="1">
                                                <TextBlock Classes="itemTitle" Text="{Binding Title}" MinHeight="18" TextWrapping="Wrap"
                                                           AutomationProperties.AutomationId="ProposalItemTitle" />
                                                <TextBlock Classes="note" Text="{Binding Note}"
                                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </Grid>
                                          </CheckBox>
                                          <!-- Under the title, outside the box: the box's 20 px, its 8 px padding, the tile's 18 px, and the 8 px gap. -->
                                          <StackPanel Margin="54,-3,0,0" Spacing="4" IsVisible="{Binding HasAgent}">
                                            <!-- The agent on a card's two lines, the client and then the model and level, so every row reads alike. -->
                                            <StackPanel AutomationProperties.AutomationId="ProposalAgent"
                                                        AutomationProperties.Name="{Binding Agent.Label}">
                                              <TextBlock Classes="agentLine" Text="{Binding Agent.Client}" />
                                              <TextBlock Classes="agentLine" Text="{Binding Agent.Model}"
                                                         IsVisible="{Binding Agent.Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                                            </StackPanel>
                                            <TextBlock Classes="caption" Text="{Binding Agent.Reason}" TextWrapping="Wrap"
                                                       IsVisible="{Binding Agent.Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                                       AutomationProperties.AutomationId="ProposalAgentReason" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"
                                                  IsVisible="{Binding Agent.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" Width="14" Height="14"
                                                        VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource StateWarningStrongBrush}" />
                                              <TextBlock Grid.Column="1" Text="{Binding Agent.Note}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                                         AutomationProperties.AutomationId="ProposalAgentNote" />
                                            </Grid>
                                          </StackPanel>
                                        </StackPanel>
                                      </inspector:InspectorRow>
                                      <ContentControl Content="{Binding Agent.Editor, FallbackValue={x:Null}}">
                                        <ContentControl.ContentTemplate>
                                          <DataTemplate DataType="canvas:ProposalAgentViewModel">
                                            <StackPanel Margin="0,0,0,6">
                                              <inspector:InspectorRow Label="Client" Icon="{StaticResource IconAgent}">
                                                <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding SelectedClient, Mode=OneWay}" SelectionChanged="OnProposalClientChosen"
                                                          AutomationProperties.AutomationId="ProposalAgentClient"
                                                          AutomationProperties.Name="Client">
                                                  <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="canvas:ClientChoice">
                                                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                  </ComboBox.ItemTemplate>
                                                </ComboBox>
                                              </inspector:InspectorRow>
                                              <inspector:InspectorRow Label="Model" Icon="{StaticResource IconModel}">
                                                <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel, Mode=OneWay}" SelectionChanged="OnProposalModelChosen"
                                                          PlaceholderText="Choose a model"
                                                          AutomationProperties.AutomationId="ProposalAgentModel"
                                                          AutomationProperties.Name="Model">
                                                  <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="canvas:Choice">
                                                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                  </ComboBox.ItemTemplate>
                                                </ComboBox>
                                              </inspector:InspectorRow>
                                              <inspector:InspectorRow Label="Reasoning" Icon="{StaticResource IconReasoning}" IsShown="{Binding HasReasoning}">
                                                <ComboBox ItemsSource="{Binding ReasoningChoices}" SelectedItem="{Binding SelectedReasoning, Mode=OneWay}" SelectionChanged="OnProposalReasoningChosen"
                                                          PlaceholderText="Choose a level"
                                                          AutomationProperties.AutomationId="ProposalAgentReasoning"
                                                          AutomationProperties.Name="Reasoning">
                                                  <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="canvas:Choice">
                                                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                  </ComboBox.ItemTemplate>
                                                </ComboBox>
                                              </inspector:InspectorRow>
                                            </StackPanel>
                                          </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                      </ContentControl>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <!-- The ghost wires show the connections, so their words wait behind a disclosure. -->
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding ConnectionCount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel>
                                  <ToggleButton x:Name="ConnectionsToggle" Classes="disclosure"
                                                AutomationProperties.AutomationId="ProposalConnectionsToggle"
                                                AutomationProperties.Name="{Binding ConnectionCount}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <PathIcon Theme="{StaticResource Glyph}" />
                                      <TextBlock Text="{Binding ConnectionCount}" />
                                    </StackPanel>
                                  </ToggleButton>
                                  <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding #ConnectionsToggle.IsChecked}" Margin="14,2,0,0"
                                                AutomationProperties.AutomationId="ProposalConnections"
                                                AutomationProperties.Name="Proposed connections">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </inspector:InspectorRow>
                              <!-- A new or filled task without an agent of its own, from the person or the planner, needs the planner's. -->
                              <inspector:InspectorRow Layout="Full" Label="Fall back to the planner's agent" IsShown="{Binding UsesFallback}">
                                <CheckBox IsChecked="{Binding UsePlannerAgent}"
                                          ToolTip.Tip="A new or filled task without an agent of its own, and without a choice of the planner's that this machine runs, takes the planner's client, model, and reasoning."
                                          AutomationProperties.AutomationId="ProposalUsePlannerAgent"
                                          AutomationProperties.Name="Fall back to the planner's agent">
                                  <TextBlock Text="Fall back to the planner's agent" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextStrongBrush}" />
                                </CheckBox>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DestructiveTextBrush}"
                                           AutomationProperties.AutomationId="ProposalProblem" />
                              </inspector:InspectorRow>
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <!-- A waiting Chat planner ends its conversation by accepting, so Accept and Finish leads there. The
                           buttons share one line when they fit, else Accept and Finish takes its own line above the others. -->
                      <inspector:InspectorRow Layout="Buttons">
                        <inspector:ActionRow AutomationProperties.AutomationId="ProposalActions">
                          <Button Classes="primary" Command="{Binding AcceptAndFinishCommand}" IsVisible="{Binding ShowsAcceptAndFinish}"
                                  ToolTip.Tip="Adds and fills the chosen tasks, then marks the planner done"
                                  AutomationProperties.AutomationId="ProposalAcceptFinish"
                                  AutomationProperties.Name="Accept and Finish">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
                              <TextBlock Text="Accept and Finish" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes.primary="{Binding !ShowsAcceptAndFinish}" Classes.action="{Binding ShowsAcceptAndFinish}"
                                  Command="{Binding Proposal.AcceptCommand}"
                                  ToolTip.Tip="Adds and fills the chosen tasks in one change"
                                  AutomationProperties.AutomationId="AcceptProposal"
                                  AutomationProperties.Name="Accept">
                            <TextBlock Text="Accept" />
                          </Button>
                          <Button Classes="action" Command="{Binding Proposal.DismissCommand}"
                                  ToolTip.Tip="Hides the proposal until the planner proposes again"
                                  AutomationProperties.AutomationId="DismissProposal"
                                  AutomationProperties.Name="Dismiss">
                            <TextBlock Text="Dismiss" />
                          </Button>
                        </inspector:ActionRow>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- The review's round and every finding it raised: the task's review in the canvas's run while the run shows the
                       task, else its own latest attempt. -->
                  <inspector:InspectorSection Key="Findings" Title="Findings" IsShown="{Binding FindingsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <inspector:InspectorRow Layout="Full">
                      <StackPanel Spacing="6" AutomationProperties.AutomationId="Review">
                        <TextBlock Text="{Binding FindingsSummary}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                                   AutomationProperties.AutomationId="ReviewSummary" />
                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"
                                      AutomationProperties.AutomationId="Findings"
                                      AutomationProperties.Name="Findings">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </StackPanel>
                    </inspector:InspectorRow>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Conversation" Title="{Binding ComposerSectionTitle}" TitleId="ComposerHeading">
                    <StackPanel>
                      <inspector:InspectorRow Layout="Buttons">
                        <Button Classes="action" Command="{Binding OpenConversationCommand}"
                                ToolTip.Tip="{Binding AttentionLabel, FallbackValue='Open the full conversation'}"
                                AutomationProperties.AutomationId="OpenConversation"
                                AutomationProperties.Name="Open conversation">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChat}" Width="14" Height="14" />
                            <TextBlock Text="Open conversation" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </inspector:InspectorRow>
                      <ContentControl Content="{Binding LastRun}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <inspector:InspectorRow Layout="Full">
                              <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding Conversation}"
                                              AutomationProperties.AutomationId="Conversation"
                                              AutomationProperties.Name="Conversation">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="execution:ExchangeViewModel">
                                      <StackPanel Spacing="6">
                                        <TextBlock Classes="caption" Text="{Binding StatusLine}" TextWrapping="Wrap"
                                                   IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ItemsControl ItemsSource="{Binding Turns}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="execution:TurnViewModel">
                                              <StackPanel Spacing="6">
                                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                                        IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                  <StackPanel Spacing="2">
                                                    <TextBlock Classes="caption" Text="{Binding Author}" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                                  </StackPanel>
                                                </Border>
                                                <TextBox Text="{Binding Reply, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" FontSize="13"
                                                         IsVisible="{Binding Reply, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                         AutomationProperties.AutomationId="{Binding ReplyId}"
                                                         AutomationProperties.Name="{Binding ReplyName}" />
                                                <TextBlock Classes="caption" Text="{Binding Note}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="caption" Text="{Binding TerminalNote}" TextWrapping="Wrap"
                                                   IsVisible="{Binding TerminalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="4" IsVisible="{Binding WaitingCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            AutomationProperties.AutomationId="Waiting">
                                  <TextBlock Classes="caption" Text="{Binding WaitingCaption}" />
                                  <ItemsControl ItemsSource="{Binding Waiting}"
                                                AutomationProperties.AutomationId="WaitingMessages"
                                                AutomationProperties.Name="{Binding WaitingCaption}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource SurfaceMuted60Brush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="0,0,0,4">
                                          <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                                <TextBlock Classes="caption" Text="{Binding TerminalNote}" TextWrapping="Wrap"
                                           IsVisible="{Binding TerminalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           AutomationProperties.AutomationId="TerminalNote" />
                              </StackPanel>
                            </inspector:InspectorRow>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowsRunConversation" />
                            <Binding Path="HasAgent" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <TextBlock Classes="caption" Text="The run's conversation with this task opens in the conversation view." TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="RunConversationNote" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsWaiting" />
                            <Binding Path="!IsRunOwned" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <StackPanel Spacing="6">
                          <Border Classes="pill waiting" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" />
                              <TextBlock Text="Waiting for you" />
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding Waiting}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                                     IsVisible="{Binding Waiting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     AutomationProperties.AutomationId="PendingQuestion" />
                        </StackPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding !IsRunOwned}">
                        <!-- Ctrl+Enter sends, so Enter stays a line break in the message. -->
                        <TextBox Text="{Binding Draft}"
                                 AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="64"
                                 Watermark="{Binding ComposerHint}"
                                 AutomationProperties.AutomationId="Composer"
                                 AutomationProperties.Name="Message">
                          <TextBox.KeyBindings>
                            <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
                          </TextBox.KeyBindings>
                        </TextBox>
                      </inspector:InspectorRow>
                      <!-- The composer's buttons end where its box ends, so they wrap at the value edge, not the panel's inset. -->
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding !IsRunOwned}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="action" Command="{Binding SendCommand}"
                                  AutomationProperties.AutomationId="SendMessage"
                                  AutomationProperties.Name="Send">
                            <TextBlock Text="Send" />
                          </Button>
                          <Button Classes="action" Command="{Binding StopAndSendCommand}" IsVisible="{Binding CanStopAndSend}"
                                  AutomationProperties.AutomationId="StopAndSend"
                                  AutomationProperties.Name="Stop and send">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                              <TextBlock Text="Stop and send" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding MarkDoneCommand}" IsVisible="{Binding IsWaiting}"
                                  AutomationProperties.AutomationId="MarkDone"
                                  AutomationProperties.Name="Mark done">
                            <TextBlock Text="Mark done" />
                          </Button>
                          <Button Classes="action" Command="{Binding NewConversationCommand}" IsVisible="{Binding CanStartNewConversation}"
                                  AutomationProperties.AutomationId="StartNewConversation"
                                  AutomationProperties.Name="Start a new conversation">
                            <TextBlock Text="Start a new conversation" />
                          </Button>
                          <Button Classes="action" Command="{Binding OpenInTerminalCommand}"
                                  AutomationProperties.AutomationId="OpenInTerminal"
                                  AutomationProperties.Name="Open in terminal">
                            <TextBlock Text="Open in terminal" />
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="SendProblem" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                            <Binding Path="!IsRunOwned" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <TextBlock Classes="caption" Text="{Binding SendProblem}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SendProblem" />
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- What the agent said shows. Its tool calls, such as raw commands, wait behind a disclosure that each task
                       keeps open or closed across its runs. -->
                  <inspector:InspectorSection Key="Activity" Title="Activity" IsShown="{Binding LastRun.HasActivity, FallbackValue=False}">
                    <StackPanel>
                      <ContentControl Classes="activity" Content="{Binding LastRun}" Classes.showsTools="{Binding ShowsToolCalls}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <inspector:InspectorRow Layout="Full">
                              <ItemsControl Classes="activity"
                                            AutomationProperties.AutomationId="LastRunActivity"
                                            AutomationProperties.Name="Recent activity">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="executionCore:ActivityLine">
                                    <TextBlock Classes="activity" Classes.tool="{Binding IsTool}" Text="{Binding Text}" ToolTip.Tip="{Binding Text}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </inspector:InspectorRow>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding LastRun.ToolCalls, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                        <ToggleButton Classes="disclosure" IsChecked="{Binding ShowsToolCalls}"
                                      AutomationProperties.AutomationId="ToolCallsToggle"
                                      AutomationProperties.Name="{Binding LastRun.ToolCalls}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Theme="{StaticResource Glyph}" />
                            <TextBlock Text="{Binding LastRun.ToolCalls}" />
                          </StackPanel>
                        </ToggleButton>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Blueprint" Title="Blueprint">
                    <StackPanel>
                      <inspector:InspectorRow Label="Type">
                        <inspector:InspectorRow.Lead>
                          <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="16" />
                        </inspector:InspectorRow.Lead>
                        <TextBlock Classes="value" Text="{Binding TypeName}" ToolTip.Tip="{Binding TypeName}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Version" Icon="{StaticResource IconVersion}">
                        <TextBlock Classes="value" Text="{Binding BlueprintVersion}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Derived from" Icon="{StaticResource IconDerive}" IsShown="{Binding DerivedFrom, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="value" Text="{Binding DerivedFrom}" ToolTip.Tip="{Binding DerivedFrom}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Description" Layout="Stacked" Icon="{StaticResource IconDescription}" IsShown="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="value" Text="{Binding Description}" TextWrapping="Wrap" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Buttons">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
                          <Button Classes="action" Command="{Binding DeriveCommand}"
                                  ToolTip.Tip="A new blueprint with this type's fields and template"
                                  AutomationProperties.AutomationId="DeriveTaskType"
                                  AutomationProperties.Name="Derive">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" Width="14" Height="14" />
                              <TextBlock Text="Derive…" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding SaveAsBlueprintCommand}"
                                  ToolTip.Tip="A new blueprint whose defaults are this task's values and agent"
                                  AutomationProperties.AutomationId="SaveAsBlueprint"
                                  AutomationProperties.Name="Save as blueprint">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" Width="14" Height="14" />
                              <TextBlock Text="Save as Blueprint…" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>
                </StackPanel>
              </DataTemplate>

              <DataTemplate DataType="canvas:ConnectionViewModel">
                <inspector:InspectorSection Key="Connection" Title="Connection">
                  <StackPanel>
                    <inspector:InspectorRow Label="From">
                      <inspector:InspectorRow.Lead>
                        <theme:KindTile Kind="{Binding From.Kind}" TileSize="16" />
                      </inspector:InspectorRow.Lead>
                      <Button Classes="rowLink" Command="{Binding From.SelectCommand}" ToolTip.Tip="Select this task"
                              AutomationProperties.AutomationId="ConnectionFrom"
                              AutomationProperties.Name="{Binding From.Title}">
                        <TextBlock Classes="value" Text="{Binding From.Title}" />
                      </Button>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="To">
                      <inspector:InspectorRow.Lead>
                        <theme:KindTile Kind="{Binding To.Kind}" TileSize="16" />
                      </inspector:InspectorRow.Lead>
                      <Button Classes="rowLink" Command="{Binding To.SelectCommand}" ToolTip.Tip="Select this task"
                              AutomationProperties.AutomationId="ConnectionTo"
                              AutomationProperties.Name="{Binding To.Title}">
                        <TextBlock Classes="value" Text="{Binding To.Title}" />
                      </Button>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="Kind" Layout="Stacked" Icon="{StaticResource IconLink}">
                      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2">
                        <!-- Each swatch draws its kind's line in the wire's hue, so the buttons double as the legend for the canvas. -->
                        <UniformGrid Columns="2">
                          <Button Classes="segment"
                                  Command="{Binding SetKindCommand}"
                                  CommandParameter="{x:Static workflows:ConnectionKind.Dependency}"
                                  AutomationProperties.AutomationId="KindDependency"
                                  AutomationProperties.Name="Dependency">
                            <StackPanel Spacing="4">
                              <Line Classes="kindStroke" theme:StyleClass.Kind="{Binding SourceKind}"
                                    StartPoint="0,1" EndPoint="18,1" StrokeThickness="2" HorizontalAlignment="Center" />
                              <TextBlock Text="Dependency" />
                            </StackPanel>
                          </Button>
                          <Button Classes="segment"
                                  Command="{Binding SetKindCommand}"
                                  CommandParameter="{x:Static workflows:ConnectionKind.Context}"
                                  AutomationProperties.AutomationId="KindContext"
                                  AutomationProperties.Name="Context">
                            <StackPanel Spacing="4">
                              <Line Classes="kindStroke" theme:StyleClass.Kind="{Binding SourceKind}"
                                    StartPoint="0,1" EndPoint="18,1" StrokeThickness="2" StrokeDashArray="2,1.5" HorizontalAlignment="Center" />
                              <TextBlock Text="Context" />
                            </StackPanel>
                          </Button>
                        </UniformGrid>
                      </Border>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Layout="Buttons">
                      <Button Classes="destructive" Command="{Binding DeleteCommand}" Margin="0,6,0,0"
                              AutomationProperties.AutomationId="DeleteConnection"
                              AutomationProperties.Name="Delete Connection">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDelete}" Width="14" Height="14" />
                          <TextBlock Text="Delete Connection" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </inspector:InspectorRow>
                  </StackPanel>
                </inspector:InspectorSection>
              </DataTemplate>

              <DataTemplate DataType="inspector:WorkflowOverviewViewModel">
                <StackPanel>
                  <inspector:InspectorSection Key="Overview" Title="Overview" IsShown="{Binding HasKinds}">
                    <ItemsControl ItemsSource="{Binding Kinds}" AutomationProperties.AutomationId="WorkflowKinds">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="inspector:KindCount">
                          <!-- The count ends where a blueprint's More button and the filter button end. -->
                          <inspector:InspectorRow Layout="Title" Classes="entry" Label="{Binding Label}">
                            <inspector:InspectorRow.Lead>
                              <theme:KindTile Kind="{Binding Kind}" TileSize="16" />
                            </inspector:InspectorRow.Lead>
                            <inspector:InspectorRow.Actions>
                              <inspector:InkAlignedText Classes="count" Text="{Binding Count}" AutomationProperties.AutomationId="KindCount" />
                            </inspector:InspectorRow.Actions>
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </inspector:InspectorSection>
                  <inspector:InspectorSection Key="Library" Title="Library">
                    <blueprints:PaletteView DataContext="{Binding Blueprints}" />
                  </inspector:InspectorSection>
                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
          <!-- Outside the swapped content, so the hint stays in the tree, hidden, while something is selected. It ends at the
               value edge, before the trailing column, as every other paragraph does. -->
          <TextBlock Text="Select a task or connection to edit it." Margin="0,4,52,0"
                     TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                     IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNull}}"
                     AutomationProperties.AutomationId="InspectorHint" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</UserControl>
