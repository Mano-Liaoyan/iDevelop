<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:executionCore="using:IDevelop.Execution"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             xmlns:workflows="using:IDevelop.Workflows"
             x:Class="IDevelop.Desktop.Inspector.InspectorView"
             x:DataType="canvas:WorkflowCanvasViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Inspector/InspectorStyles.axaml" />
  </UserControl.Styles>
  <Panel>
    <!-- The blueprint editor takes the panel while it is open. Its sections fold apart from the inspector's. -->
    <ScrollViewer x:Name="EditorHost" IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl x:Name="Editor" Content="{Binding Blueprints.Editor}" Margin="12,12,12,16">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="blueprints:BlueprintEditorViewModel">
            <blueprints:BlueprintEditorView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </ScrollViewer>

    <!-- The header and the filter stay put while the sections scroll. The selection fills both, or the workflow
         when nothing is selected. -->
    <DockPanel IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNull}}">
      <ContentControl DockPanel.Dock="Top">
        <ContentControl.Content>
          <MultiBinding Converter="{x:Static inspector:InspectorConverters.FirstSet}">
            <Binding Path="Inspected" />
            <Binding Path="Overview" />
          </MultiBinding>
        </ContentControl.Content>
        <ContentControl.DataTemplates>
          <DataTemplate DataType="canvas:TaskNodeViewModel">
            <Border Classes="inspectorHeader" AutomationProperties.AutomationId="InspectorHeader">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <theme:KindTile Grid.RowSpan="2" Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="32"
                                VerticalAlignment="Top" Margin="0,2,0,0" />
                <!-- A text box cannot end in an ellipsis, so until it has focus a text block over it shows the title. -->
                <Panel Grid.Column="1" Classes="headerTitle" Margin="-6,0,0,0">
                  <TextBox Classes="headerTitle" Text="{Binding Title}"
                           AutomationProperties.AutomationId="TaskTitle"
                           AutomationProperties.Name="Title" />
                  <TextBlock Classes="headerTitle" Text="{Binding Title}" IsHitTestVisible="False"
                             AutomationProperties.AccessibilityView="Raw" />
                </Panel>
                <Button Grid.Column="2" Classes="glyph" ToolTip.Tip="More"
                        AutomationProperties.AutomationId="InspectorMore"
                        AutomationProperties.Name="More">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconMore}" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Derive Blueprint…" Command="{Binding DeriveCommand}">
                        <MenuItem.Icon>
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Save as Blueprint…" Command="{Binding SaveAsBlueprintCommand}">
                        <MenuItem.Icon>
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                            AutomationProperties.AutomationId="InspectorKind">
                  <TextBlock Classes="kindLine" Text="{Binding TypeName}" MaxWidth="140" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="TaskType" />
                  <TextBlock Classes="kindLine" Text=" · " />
                  <TextBlock Classes="kindLine" Text="{Binding TypeVersion}"
                             AutomationProperties.AutomationId="TaskTypeVersion" />
                  <Border Classes="infoGlyph" Margin="4,0,0,0" ToolTip.Tip="{Binding Description}"
                          IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconHelp}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="canvas:ConnectionViewModel">
            <Border Classes="inspectorHeader" AutomationProperties.AutomationId="InspectorHeader">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <Border Grid.RowSpan="2" Classes="neutralTile" VerticalAlignment="Top">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconLink}" />
                </Border>
                <TextBlock Grid.Column="1" Classes="headerName" Text="{Binding Kind}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="kindLine" Text="Connection" />
              </Grid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="inspector:WorkflowOverviewViewModel">
            <Border Classes="inspectorHeader" AutomationProperties.AutomationId="InspectorHeader">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <Border Grid.RowSpan="2" Classes="neutralTile" VerticalAlignment="Top">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFlowchart}" />
                </Border>
                <TextBlock Grid.Column="1" Classes="headerName" Text="{Binding ProjectName}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="kindLine" Text="{Binding TaskCount}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <Border DockPanel.Dock="Top" Classes="filterBar">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <TextBox x:Name="Filter" Classes="search clearButton" Watermark="Filter properties"
                   TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown"
                   AutomationProperties.AutomationId="InspectorFilter"
                   AutomationProperties.Name="Filter properties" />
          <Button Grid.Column="1" Classes="glyph" ToolTip.Tip="Expand or collapse sections"
                  AutomationProperties.AutomationId="InspectorTools"
                  AutomationProperties.Name="Sections">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFilter}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Expand All" Click="OnExpandAll">
                  <MenuItem.Icon>
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronDown}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse All" Click="OnCollapseAll">
                  <MenuItem.Icon>
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <ScrollViewer>
        <StackPanel Margin="12,0,12,16">
          <ContentControl>
            <ContentControl.Content>
              <MultiBinding Converter="{x:Static inspector:InspectorConverters.FirstSet}">
                <Binding Path="Inspected" />
                <Binding Path="Overview" />
              </MultiBinding>
            </ContentControl.Content>
            <ContentControl.DataTemplates>
              <DataTemplate DataType="canvas:TaskNodeViewModel">
                <StackPanel>
                  <inspector:InspectorSection Key="Task" Title="Task" Changes="{Binding TaskChanges}" IsShown="{Binding HasFields}">
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:FieldViewModel">
                          <inspector:InspectorRow Label="{Binding Label}" LabelTip="{Binding LabelTip}"
                                                  Layout="{Binding IsMultiline, Converter={x:Static inspector:InspectorConverters.StackedWhen}}"
                                                  RevertCommand="{Binding RevertCommand}" CanRevert="{Binding CanRevert}" RevertId="{Binding RevertId}">
                            <!-- Enter must insert the line break the domain stores, or each keystroke's round trip would rewrite the box. -->
                            <TextBox Text="{Binding Text}"
                                     AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" NewLine="&#10;"
                                     Classes.multiline="{Binding IsMultiline}"
                                     AutomationProperties.AutomationId="{Binding AutomationId}"
                                     AutomationProperties.Name="{Binding Label}" />
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Agent" Title="{Binding AgentSectionTitle}" TitleId="AgentHeading"
                                              Changes="{Binding AgentChanges}" IsShown="{Binding HasAgent}">
                    <StackPanel>
                      <inspector:InspectorRow Label="Client" Info="{Binding PermissionNote}" InfoName="{Binding PermissionSummary}" InfoId="PermissionNote"
                                              RevertCommand="{Binding RevertAgentCommand}" CanRevert="{Binding CanRevertAgent}" RevertId="RevertAgent">
                        <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding SelectedClient, Mode=OneWay}" SelectionChanged="OnClientChosen"
                                  AutomationProperties.AutomationId="TaskClient"
                                  AutomationProperties.Name="Client">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:ClientChoice">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Model" IsShown="{Binding HasClient}">
                        <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel, Mode=OneWay}" SelectionChanged="OnModelChosen"
                                  PlaceholderText="Choose a model"
                                  AutomationProperties.AutomationId="TaskModel"
                                  AutomationProperties.Name="Model">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:Choice">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Reasoning" IsShown="{Binding HasReasoning}">
                        <ComboBox ItemsSource="{Binding ReasoningChoices}" SelectedItem="{Binding SelectedReasoning, Mode=OneWay}" SelectionChanged="OnReasoningChosen"
                                  PlaceholderText="Choose a level"
                                  AutomationProperties.AutomationId="TaskReasoning"
                                  AutomationProperties.Name="Reasoning">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:Choice">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Conversation" IsShown="{Binding HasConversation}"
                                              Info="{Binding ConversationNote}" InfoName="{Binding ConversationSummary}" InfoId="ConversationNote"
                                              RevertCommand="{Binding RevertConversationCommand}" CanRevert="{Binding CanRevertConversation}" RevertId="RevertConversation">
                        <ComboBox ItemsSource="{Binding ConversationChoices}" SelectedItem="{Binding SelectedConversation, Mode=OneWay}" SelectionChanged="OnConversationChosen"
                                  AutomationProperties.AutomationId="TaskConversation"
                                  AutomationProperties.Name="Conversation">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="canvas:Choice">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Run" Title="Run">
                    <StackPanel>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding ShowsCancel}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="primary" Command="{Binding RunCommand}" IsVisible="{Binding ShowsRunControls}"
                                  AutomationProperties.AutomationId="RunTask"
                                  AutomationProperties.Name="Run">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" Width="14" Height="14" />
                              <TextBlock Text="Run" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding CancelCommand}"
                                  AutomationProperties.AutomationId="CancelRun"
                                  AutomationProperties.Name="Cancel run">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                              <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <inspector:InspectorRow.IsShown>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowsRunControls" />
                            <Binding Path="StartProblem" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                          </MultiBinding>
                        </inspector:InspectorRow.IsShown>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding StartProblem}" Background="Transparent">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" Width="14" Height="14"
                                    VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource StateWarningStrongBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding StartProblem}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     FontSize="12" Foreground="{DynamicResource TextBrush}"
                                     AutomationProperties.AutomationId="StartProblem" />
                        </Grid>
                      </inspector:InspectorRow>
                      <ContentControl Content="{Binding LastRun}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <inspector:InspectorRow Label="Status">
                              <Border Classes="pill" HorizontalAlignment="Left"
                                      Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                                      Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                                      Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                                      Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Theme="{StaticResource Glyph}" />
                                  <TextBlock Text="{Binding StatusLabel}" AutomationProperties.AutomationId="LastRunStatus" />
                                </StackPanel>
                              </Border>
                            </inspector:InspectorRow>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <!-- What ran and when, as chips whose tooltips say it in full. -->
                      <ContentControl Content="{Binding LastRun}" IsVisible="{Binding ShowsRunControls}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <StackPanel>
                              <inspector:InspectorRow Label="Agent" Layout="Wide">
                                <ItemsControl ItemsSource="{Binding Agent}" ToolTip.Tip="{Binding Configuration}" Background="Transparent"
                                              AutomationProperties.AutomationId="LastRunConfiguration"
                                              AutomationProperties.Name="{Binding Configuration}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel Classes="chips" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Label="Time" Layout="Wide">
                                <WrapPanel Classes="chips" ToolTip.Tip="{Binding Timing}" Background="Transparent"
                                           AutomationProperties.AutomationId="LastRunTiming"
                                           AutomationProperties.Name="{Binding Timing}">
                                  <Border Classes="chip">
                                    <inspector:RelativeTime At="{Binding Started}" />
                                  </Border>
                                  <Border Classes="chip" IsVisible="{Binding Took, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Took}" />
                                  </Border>
                                </WrapPanel>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           AutomationProperties.AutomationId="LastRunDetail" />
                              </inspector:InspectorRow>
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Proposal" Title="Proposal" IsShown="{Binding Proposal, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                      <ContentControl Content="{Binding Proposal}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="canvas:ProposalViewModel">
                            <StackPanel AutomationProperties.AutomationId="Proposal">
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <!-- The tile says the kind and the ghost wires say the connections, so a row is its title. -->
                                  <DataTemplate DataType="canvas:ProposalItemViewModel">
                                    <inspector:InspectorRow Layout="Full" Label="{Binding Label}">
                                      <CheckBox IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanChoose}" ToolTip.Tip="{Binding Tip}"
                                                AutomationProperties.AutomationId="ProposalItem"
                                                AutomationProperties.Name="{Binding Label}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                          <theme:KindTile Kind="{Binding Kind}" TileSize="18" VerticalAlignment="Center" />
                                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{Binding Title}" />
                                            <TextBlock Classes="note" Text="{Binding Note}"
                                                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                          </StackPanel>
                                        </Grid>
                                      </CheckBox>
                                    </inspector:InspectorRow>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <!-- The ghost wires show the connections, so their words wait behind a disclosure. -->
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding ConnectionCount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel>
                                  <ToggleButton x:Name="ConnectionsToggle" Classes="disclosure"
                                                AutomationProperties.AutomationId="ProposalConnectionsToggle"
                                                AutomationProperties.Name="{Binding ConnectionCount}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <PathIcon Theme="{StaticResource Glyph}" />
                                      <TextBlock Text="{Binding ConnectionCount}" />
                                    </StackPanel>
                                  </ToggleButton>
                                  <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding #ConnectionsToggle.IsChecked}" Margin="14,2,0,0"
                                                AutomationProperties.AutomationId="ProposalConnections"
                                                AutomationProperties.Name="Proposed connections">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Layout="Full" Label="New tasks use the planner's agent" IsShown="{Binding AddsTasks}">
                                <CheckBox IsChecked="{Binding UsePlannerAgent}"
                                          ToolTip.Tip="A new task whose type has no agent of its own takes the planner's client, model, and reasoning."
                                          AutomationProperties.AutomationId="ProposalUsePlannerAgent"
                                          AutomationProperties.Name="New tasks use the planner's agent">
                                  <TextBlock Text="New tasks use the planner's agent" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextStrongBrush}" />
                                </CheckBox>
                              </inspector:InspectorRow>
                              <inspector:InspectorRow Layout="Full" IsShown="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DestructiveTextBrush}"
                                           AutomationProperties.AutomationId="ProposalProblem" />
                              </inspector:InspectorRow>
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <!-- A waiting Chat planner ends its conversation by accepting, so Accept and Finish leads there. -->
                      <inspector:InspectorRow Layout="Full">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="primary" Command="{Binding AcceptAndFinishCommand}" IsVisible="{Binding ShowsAcceptAndFinish}"
                                  ToolTip.Tip="Adds and fills the chosen tasks, then marks the planner done"
                                  AutomationProperties.AutomationId="ProposalAcceptFinish"
                                  AutomationProperties.Name="Accept and Finish">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
                              <TextBlock Text="Accept and Finish" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes.primary="{Binding !ShowsAcceptAndFinish}" Classes.action="{Binding ShowsAcceptAndFinish}"
                                  Command="{Binding Proposal.AcceptCommand}"
                                  ToolTip.Tip="Adds and fills the chosen tasks in one change"
                                  AutomationProperties.AutomationId="AcceptProposal"
                                  AutomationProperties.Name="Accept">
                            <TextBlock Text="Accept" />
                          </Button>
                          <Button Classes="action" Command="{Binding Proposal.DismissCommand}"
                                  ToolTip.Tip="Hides the proposal until the planner proposes again"
                                  AutomationProperties.AutomationId="DismissProposal"
                                  AutomationProperties.Name="Dismiss">
                            <TextBlock Text="Dismiss" />
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Findings" Title="Findings" IsShown="{Binding ReviewSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <inspector:InspectorRow Layout="Full">
                      <StackPanel Spacing="6" AutomationProperties.AutomationId="Review">
                        <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                                   AutomationProperties.AutomationId="ReviewSummary" />
                        <ItemsControl ItemsSource="{Binding Findings}"
                                      AutomationProperties.AutomationId="Findings"
                                      AutomationProperties.Name="Findings">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="execution:FindingViewModel">
                              <Border Padding="10,8" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                                      BorderBrush="{DynamicResource Border80Brush}" Background="{DynamicResource SurfaceRaisedBrush}"
                                      Opacity="{Binding Emphasis}">
                                <StackPanel Spacing="4">
                                  <TextBlock Classes="caption" Text="{Binding Heading}" />
                                  <TextBlock Text="{Binding Reviewer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                  <TextBlock Text="{Binding Change}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                             IsVisible="{Binding Change, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                  <TextBlock Text="{Binding Implementer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                             IsVisible="{Binding Implementer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </inspector:InspectorRow>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Conversation" Title="{Binding ComposerSectionTitle}" TitleId="ComposerHeading">
                    <StackPanel>
                      <ContentControl Content="{Binding LastRun}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <inspector:InspectorRow Layout="Full">
                              <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding Conversation}"
                                              AutomationProperties.AutomationId="Conversation"
                                              AutomationProperties.Name="Conversation">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="execution:ExchangeViewModel">
                                      <StackPanel Spacing="6">
                                        <TextBlock Classes="caption" Text="{Binding StatusLine}" TextWrapping="Wrap"
                                                   IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ItemsControl ItemsSource="{Binding Turns}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="execution:TurnViewModel">
                                              <StackPanel Spacing="6">
                                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                                        IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                  <StackPanel Spacing="2">
                                                    <TextBlock Classes="caption" Text="{Binding Author}" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                                  </StackPanel>
                                                </Border>
                                                <TextBox Text="{Binding Reply, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" FontSize="13"
                                                         IsVisible="{Binding Reply, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                         AutomationProperties.AutomationId="{Binding ReplyId}"
                                                         AutomationProperties.Name="{Binding ReplyName}" />
                                                <TextBlock Classes="caption" Text="{Binding Note}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                              </StackPanel>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="caption" Text="{Binding TerminalNote}" TextWrapping="Wrap"
                                                   IsVisible="{Binding TerminalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="4" IsVisible="{Binding WaitingCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            AutomationProperties.AutomationId="Waiting">
                                  <TextBlock Classes="caption" Text="{Binding WaitingCaption}" />
                                  <ItemsControl ItemsSource="{Binding Waiting}"
                                                AutomationProperties.AutomationId="WaitingMessages"
                                                AutomationProperties.Name="{Binding WaitingCaption}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource SurfaceMuted60Brush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="0,0,0,4">
                                          <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                                <TextBlock Classes="caption" Text="{Binding TerminalNote}" TextWrapping="Wrap"
                                           IsVisible="{Binding TerminalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           AutomationProperties.AutomationId="TerminalNote" />
                              </StackPanel>
                            </inspector:InspectorRow>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding IsWaiting}">
                        <StackPanel Spacing="6">
                          <Border Classes="pill waiting" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" />
                              <TextBlock Text="Waiting for you" />
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding Waiting}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                                     IsVisible="{Binding Waiting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     AutomationProperties.AutomationId="PendingQuestion" />
                        </StackPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <!-- Ctrl+Enter sends, so Enter stays a line break in the message. -->
                        <TextBox Text="{Binding Draft}"
                                 AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="64"
                                 Watermark="{Binding ComposerHint}"
                                 AutomationProperties.AutomationId="Composer"
                                 AutomationProperties.Name="Message">
                          <TextBox.KeyBindings>
                            <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
                          </TextBox.KeyBindings>
                        </TextBox>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Button Classes="action" Command="{Binding SendCommand}"
                                  AutomationProperties.AutomationId="SendMessage"
                                  AutomationProperties.Name="Send">
                            <TextBlock Text="Send" />
                          </Button>
                          <Button Classes="action" Command="{Binding StopAndSendCommand}" IsVisible="{Binding CanStopAndSend}"
                                  AutomationProperties.AutomationId="StopAndSend"
                                  AutomationProperties.Name="Stop and send">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                              <TextBlock Text="Stop and send" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding MarkDoneCommand}" IsVisible="{Binding IsWaiting}"
                                  AutomationProperties.AutomationId="MarkDone"
                                  AutomationProperties.Name="Mark done">
                            <TextBlock Text="Mark done" />
                          </Button>
                          <Button Classes="action" Command="{Binding OpenInTerminalCommand}"
                                  AutomationProperties.AutomationId="OpenInTerminal"
                                  AutomationProperties.Name="Open in terminal">
                            <TextBlock Text="Open in terminal" />
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding SendProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="caption" Text="{Binding SendProblem}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SendProblem" />
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <!-- What the agent said shows. Its tool calls, such as raw commands, wait behind a disclosure that outlives
                       each new record of the run. -->
                  <inspector:InspectorSection Key="Activity" Title="Activity" IsShown="{Binding LastRun.HasActivity, FallbackValue=False}">
                    <StackPanel>
                      <ContentControl Classes="activity" Content="{Binding LastRun}" Classes.showsTools="{Binding #ToolCallsToggle.IsChecked}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate DataType="execution:AttemptViewModel">
                            <inspector:InspectorRow Layout="Full">
                              <ItemsControl ItemsSource="{Binding Activity}"
                                            AutomationProperties.AutomationId="LastRunActivity"
                                            AutomationProperties.Name="Recent activity">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="executionCore:ActivityLine">
                                    <TextBlock Classes="activity" Classes.tool="{Binding IsTool}" Text="{Binding Text}" ToolTip.Tip="{Binding Text}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </inspector:InspectorRow>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <inspector:InspectorRow Layout="Full" IsShown="{Binding LastRun.ToolCalls, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                        <ToggleButton x:Name="ToolCallsToggle" Classes="disclosure"
                                      AutomationProperties.AutomationId="ToolCallsToggle"
                                      AutomationProperties.Name="{Binding LastRun.ToolCalls}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Theme="{StaticResource Glyph}" />
                            <TextBlock Text="{Binding LastRun.ToolCalls}" />
                          </StackPanel>
                        </ToggleButton>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>

                  <inspector:InspectorSection Key="Blueprint" Title="Blueprint">
                    <StackPanel>
                      <inspector:InspectorRow Label="Type">
                        <TextBlock Classes="value" Text="{Binding TypeName}" ToolTip.Tip="{Binding TypeName}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Version">
                        <TextBlock Classes="value" Text="{Binding BlueprintVersion}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Derived from" IsShown="{Binding DerivedFrom, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="value" Text="{Binding DerivedFrom}" ToolTip.Tip="{Binding DerivedFrom}" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Label="Description" Layout="Stacked" IsShown="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="value" Text="{Binding Description}" TextWrapping="Wrap" />
                      </inspector:InspectorRow>
                      <inspector:InspectorRow Layout="Full">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
                          <Button Classes="action" Command="{Binding DeriveCommand}"
                                  ToolTip.Tip="A new blueprint with this type's fields and template"
                                  AutomationProperties.AutomationId="DeriveTaskType"
                                  AutomationProperties.Name="Derive">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" Width="14" Height="14" />
                              <TextBlock Text="Derive…" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="action" Command="{Binding SaveAsBlueprintCommand}"
                                  ToolTip.Tip="A new blueprint whose defaults are this task's values and agent"
                                  AutomationProperties.AutomationId="SaveAsBlueprint"
                                  AutomationProperties.Name="Save as blueprint">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" Width="14" Height="14" />
                              <TextBlock Text="Save as Blueprint…" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </inspector:InspectorRow>
                    </StackPanel>
                  </inspector:InspectorSection>
                </StackPanel>
              </DataTemplate>

              <DataTemplate DataType="canvas:ConnectionViewModel">
                <inspector:InspectorSection Key="Connection" Title="Connection">
                  <StackPanel>
                    <inspector:InspectorRow Label="From">
                      <Button Classes="rowLink" Command="{Binding From.SelectCommand}" ToolTip.Tip="Select this task"
                              AutomationProperties.AutomationId="ConnectionFrom"
                              AutomationProperties.Name="{Binding From.Title}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <theme:KindTile Kind="{Binding From.Kind}" TileSize="18" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding From.Title}" />
                        </Grid>
                      </Button>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="To">
                      <Button Classes="rowLink" Command="{Binding To.SelectCommand}" ToolTip.Tip="Select this task"
                              AutomationProperties.AutomationId="ConnectionTo"
                              AutomationProperties.Name="{Binding To.Title}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <theme:KindTile Kind="{Binding To.Kind}" TileSize="18" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding To.Title}" />
                        </Grid>
                      </Button>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="Kind" Layout="Stacked">
                      <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2">
                        <!-- Each swatch draws its kind's line in the wire's hue, so the buttons double as the legend for the canvas. -->
                        <UniformGrid Columns="2">
                          <Button Classes="segment"
                                  Command="{Binding SetKindCommand}"
                                  CommandParameter="{x:Static workflows:ConnectionKind.Dependency}"
                                  AutomationProperties.AutomationId="KindDependency"
                                  AutomationProperties.Name="Dependency">
                            <StackPanel Spacing="4">
                              <Line Classes="kindStroke" theme:StyleClass.Kind="{Binding SourceKind}"
                                    StartPoint="0,1" EndPoint="18,1" StrokeThickness="2" HorizontalAlignment="Center" />
                              <TextBlock Text="Dependency" />
                            </StackPanel>
                          </Button>
                          <Button Classes="segment"
                                  Command="{Binding SetKindCommand}"
                                  CommandParameter="{x:Static workflows:ConnectionKind.Context}"
                                  AutomationProperties.AutomationId="KindContext"
                                  AutomationProperties.Name="Context">
                            <StackPanel Spacing="4">
                              <Line Classes="kindStroke" theme:StyleClass.Kind="{Binding SourceKind}"
                                    StartPoint="0,1" EndPoint="18,1" StrokeThickness="2" StrokeDashArray="2,1.5" HorizontalAlignment="Center" />
                              <TextBlock Text="Context" />
                            </StackPanel>
                          </Button>
                        </UniformGrid>
                      </Border>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Layout="Full">
                      <Button Classes="destructive" Command="{Binding DeleteCommand}" Margin="0,6,0,0"
                              AutomationProperties.AutomationId="DeleteConnection"
                              AutomationProperties.Name="Delete Connection">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDelete}" Width="14" Height="14" />
                          <TextBlock Text="Delete Connection" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </inspector:InspectorRow>
                  </StackPanel>
                </inspector:InspectorSection>
              </DataTemplate>

              <DataTemplate DataType="inspector:WorkflowOverviewViewModel">
                <StackPanel>
                  <inspector:InspectorSection Key="Overview" Title="Overview" IsShown="{Binding HasKinds}">
                    <ItemsControl ItemsSource="{Binding Kinds}" AutomationProperties.AutomationId="WorkflowKinds">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="inspector:KindCount">
                          <inspector:InspectorRow Layout="Full" Label="{Binding Label}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                              <theme:KindTile Kind="{Binding Kind}" TileSize="18" />
                              <TextBlock Grid.Column="1" Classes="entryName" Text="{Binding Label}" />
                              <TextBlock Grid.Column="2" Classes="value" Text="{Binding Count}" />
                            </Grid>
                          </inspector:InspectorRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </inspector:InspectorSection>
                  <inspector:InspectorSection Key="Library" Title="Library">
                    <blueprints:PaletteView DataContext="{Binding Blueprints}" />
                  </inspector:InspectorSection>
                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
          <!-- Outside the swapped content, so the hint stays in the tree, hidden, while something is selected. -->
          <TextBlock Text="Select a task or connection to edit it." Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                     IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNull}}"
                     AutomationProperties.AutomationId="InspectorHint" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</UserControl>
