<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:workflows="using:IDevelop.Workflows"
             x:Class="IDevelop.Desktop.Inspector.InspectorView"
             x:DataType="canvas:WorkflowCanvasViewModel">
  <Panel>
    <!-- The blueprint editor takes the panel while it is open. Otherwise the selection does, or the palette when nothing is selected. -->
    <ContentControl Content="{Binding Blueprints.Editor}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="blueprints:BlueprintEditorViewModel">
          <blueprints:BlueprintEditorView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
    <StackPanel Spacing="20">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Inspected" Converter="{x:Static ObjectConverters.IsNull}" />
          <Binding Path="Blueprints.Editor" Converter="{x:Static ObjectConverters.IsNull}" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <TextBlock Text="Select a task or connection to edit it."
                 TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                 AutomationProperties.AutomationId="InspectorHint" />
      <blueprints:PaletteView DataContext="{Binding Blueprints}" />
    </StackPanel>
    <ContentControl Content="{Binding Inspected}" IsVisible="{Binding Blueprints.Editor, Converter={x:Static ObjectConverters.IsNull}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="canvas:TaskNodeViewModel">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="{Binding TypeName}" Margin="0,0,0,2"
                       AutomationProperties.AutomationId="TaskType" />
            <TextBlock Classes="caption" Text="{Binding TypeVersion}"
                       AutomationProperties.AutomationId="TaskTypeVersion" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,2,0,6">
              <Button Classes="action" Content="Derive" Command="{Binding DeriveCommand}"
                      ToolTip.Tip="A new blueprint with this type's fields and template"
                      AutomationProperties.AutomationId="DeriveTaskType"
                      AutomationProperties.Name="Derive" />
              <Button Classes="action" Content="Save as blueprint" Command="{Binding SaveAsBlueprintCommand}"
                      ToolTip.Tip="A new blueprint whose defaults are this task's values and agent"
                      AutomationProperties.AutomationId="SaveAsBlueprint"
                      AutomationProperties.Name="Save as blueprint" />
            </WrapPanel>
            <TextBlock Classes="caption" Text="Title" />
            <TextBox Text="{Binding Title}"
                     AutomationProperties.AutomationId="TaskTitle"
                     AutomationProperties.Name="Title" />
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="canvas:FieldViewModel">
                  <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Classes="caption" Text="{Binding Label}" />
                    <!-- Enter must insert the line break the domain stores, or each keystroke's round trip would rewrite the box. -->
                    <TextBox Text="{Binding Text}"
                             AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" NewLine="&#10;"
                             Classes.multiline="{Binding IsMultiline}"
                             AutomationProperties.AutomationId="{Binding AutomationId}"
                             AutomationProperties.Name="{Binding Label}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="6" IsVisible="{Binding HasAgent}">
              <TextBlock Classes="section" Text="{Binding AgentHeading}" Margin="0,20,0,2"
                         AutomationProperties.AutomationId="AgentHeading" />
              <TextBlock Classes="caption" Text="Client" />
              <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding SelectedClient, Mode=OneWay}" SelectionChanged="OnClientChosen"
                        AutomationProperties.AutomationId="TaskClient"
                        AutomationProperties.Name="Client">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="canvas:ClientChoice">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Spacing="6" IsVisible="{Binding HasClient}">
                <TextBlock Classes="caption" Text="Model" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel, Mode=OneWay}" SelectionChanged="OnModelChosen"
                          PlaceholderText="Choose a model"
                          AutomationProperties.AutomationId="TaskModel"
                          AutomationProperties.Name="Model">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="canvas:Choice">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="6" IsVisible="{Binding HasReasoning}">
                  <TextBlock Classes="caption" Text="Reasoning" Margin="0,8,0,0" />
                  <ComboBox ItemsSource="{Binding ReasoningChoices}" SelectedItem="{Binding SelectedReasoning, Mode=OneWay}" SelectionChanged="OnReasoningChosen"
                            PlaceholderText="Choose a level"
                            AutomationProperties.AutomationId="TaskReasoning"
                            AutomationProperties.Name="Reasoning">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="canvas:Choice">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding PermissionNote}" TextWrapping="Wrap" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="PermissionNote" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding HasConversation}">
              <TextBlock Classes="caption" Text="Conversation" Margin="0,8,0,0" />
              <ComboBox ItemsSource="{Binding ConversationChoices}" SelectedItem="{Binding SelectedConversation, Mode=OneWay}" SelectionChanged="OnConversationChosen"
                        AutomationProperties.AutomationId="TaskConversation"
                        AutomationProperties.Name="Conversation">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="canvas:Choice">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" Text="{Binding ConversationNote}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="ConversationNote" />
            </StackPanel>

            <TextBlock Classes="section" Text="RUN" Margin="0,20,0,2" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="action" Command="{Binding RunCommand}"
                      AutomationProperties.AutomationId="RunTask"
                      AutomationProperties.Name="Run">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource PlayIcon}" Width="12" Height="12" />
                  <TextBlock Text="Run" />
                </StackPanel>
              </Button>
              <Button Classes="action" Command="{Binding CancelCommand}"
                      AutomationProperties.AutomationId="CancelRun"
                      AutomationProperties.Name="Cancel run">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource StopIcon}" Width="12" Height="12" />
                  <TextBlock Text="Cancel" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding StartProblem}" TextWrapping="Wrap"
                       IsVisible="{Binding StartProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       AutomationProperties.AutomationId="StartProblem" />
            <ContentControl Content="{Binding Proposal}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="canvas:ProposalViewModel">
                  <StackPanel Spacing="6" AutomationProperties.AutomationId="Proposal">
                    <TextBlock Classes="section" Text="PROPOSAL" Margin="0,20,0,2" />
                    <TextBlock Classes="caption" Text="Untick a task to leave it out. Accept adds and fills the rest in one change." TextWrapping="Wrap"
                               IsVisible="{Binding HasItems}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="canvas:ProposalItemViewModel">
                          <CheckBox IsChecked="{Binding IsChosen}" IsEnabled="{Binding CanChoose}" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="ProposalItem"
                                    AutomationProperties.Name="{Binding Label}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextStrongBrush}" />
                              <TextBlock Classes="caption" Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Connections}"
                                  AutomationProperties.AutomationId="ProposalConnections"
                                  AutomationProperties.Name="Proposed connections">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DestructiveTextBrush}"
                               IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="ProposalProblem" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="action" Command="{Binding AcceptCommand}"
                              AutomationProperties.AutomationId="AcceptProposal"
                              AutomationProperties.Name="Accept">
                        <TextBlock Text="Accept" />
                      </Button>
                      <Button Classes="action" Command="{Binding DismissCommand}"
                              AutomationProperties.AutomationId="DismissProposal"
                              AutomationProperties.Name="Dismiss">
                        <TextBlock Text="Dismiss" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <ContentControl Content="{Binding LastAttempt}" Margin="0,6,0,0">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="execution:AttemptViewModel">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caption" Text="Last run" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="pill"
                              Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                              Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                              Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                              Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon />
                          <TextBlock Text="{Binding StatusLabel}" AutomationProperties.AutomationId="LastRunStatus" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding Configuration}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="LastRunConfiguration" />
                    <TextBlock Classes="caption" Text="{Binding Timing}"
                               AutomationProperties.AutomationId="LastRunTiming" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="LastRunDetail" />
                    <ItemsControl ItemsSource="{Binding Conversation}"
                                  AutomationProperties.AutomationId="Conversation"
                                  AutomationProperties.Name="Conversation">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="execution:ExchangeViewModel">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{Binding StatusLine}" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Turns}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="execution:TurnViewModel">
                                  <StackPanel Spacing="6">
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                            IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <StackPanel Spacing="2">
                                        <TextBlock Classes="caption" Text="{Binding Author}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                      </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding Reply, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240"
                                             IsVisible="{Binding Reply, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             AutomationProperties.AutomationId="{Binding ReplyId}"
                                             AutomationProperties.Name="{Binding ReplyName}" />
                                    <TextBlock Classes="caption" Text="{Binding Note}" TextWrapping="Wrap"
                                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption" Text="{Binding TerminalNote}" TextWrapping="Wrap"
                                       IsVisible="{Binding TerminalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="4" IsVisible="{Binding WaitingCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                AutomationProperties.AutomationId="Waiting">

                      <TextBlock Classes="caption" Text="{Binding WaitingCaption}" />
                      <ItemsControl ItemsSource="{Binding Waiting}"
                                    AutomationProperties.AutomationId="WaitingMessages"
                                    AutomationProperties.Name="{Binding WaitingCaption}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Background="{DynamicResource SurfaceMuted60Brush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8" Margin="0,0,0,4">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding TerminalNote}" TextWrapping="Wrap"
                               IsVisible="{Binding TerminalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="TerminalNote" />
                    <TextBlock Classes="caption" Text="Recent activity" Margin="0,4,0,0" IsVisible="{Binding HasActivity}" />
                    <ItemsControl ItemsSource="{Binding Activity}"
                                  AutomationProperties.AutomationId="LastRunActivity"
                                  AutomationProperties.Name="Recent activity">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <StackPanel Spacing="6" IsVisible="{Binding ReviewSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        AutomationProperties.AutomationId="Review">
              <TextBlock Classes="section" Text="FINDINGS" Margin="0,20,0,2" />
              <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                         AutomationProperties.AutomationId="ReviewSummary" />
              <ItemsControl ItemsSource="{Binding Findings}"
                            AutomationProperties.AutomationId="Findings"
                            AutomationProperties.Name="Findings">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="execution:FindingViewModel">
                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                            BorderBrush="{DynamicResource Border80Brush}" Background="{DynamicResource SurfaceRaisedBrush}"
                            Opacity="{Binding Emphasis}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="{Binding Heading}" />
                        <TextBlock Text="{Binding Reviewer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Change}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding Change, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding Implementer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding Implementer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Classes="section" Text="{Binding ComposerHeading}" Margin="0,20,0,2"
                       AutomationProperties.AutomationId="ComposerHeading" />
            <Border Classes="pill waiting" HorizontalAlignment="Left" IsVisible="{Binding IsWaiting}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon />
                <TextBlock Text="Waiting for you" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Waiting}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                       IsVisible="{Binding Waiting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       AutomationProperties.AutomationId="PendingQuestion" />
            <!-- Ctrl+Enter sends, so Enter stays a line break in the message. -->
            <TextBox Text="{Binding Draft}"
                     AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="64"
                     Watermark="{Binding ComposerHint}"
                     AutomationProperties.AutomationId="Composer"
                     AutomationProperties.Name="Message">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <Button Classes="action" Command="{Binding SendCommand}"
                      AutomationProperties.AutomationId="SendMessage"
                      AutomationProperties.Name="Send">
                <TextBlock Text="Send" />
              </Button>
              <Button Classes="action" Command="{Binding StopAndSendCommand}" IsVisible="{Binding CanStopAndSend}"
                      AutomationProperties.AutomationId="StopAndSend"
                      AutomationProperties.Name="Stop and send">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource StopIcon}" Width="12" Height="12" />
                  <TextBlock Text="Stop and send" />
                </StackPanel>
              </Button>
              <Button Classes="action" Command="{Binding MarkDoneCommand}" IsVisible="{Binding IsWaiting}"
                      AutomationProperties.AutomationId="MarkDone"
                      AutomationProperties.Name="Mark done">
                <TextBlock Text="Mark done" />
              </Button>
              <Button Classes="action" Command="{Binding OpenInTerminalCommand}"
                      AutomationProperties.AutomationId="OpenInTerminal"
                      AutomationProperties.Name="Open in terminal">
                <TextBlock Text="Open in terminal" />
              </Button>
            </WrapPanel>
            <TextBlock Classes="caption" Text="{Binding SendProblem}" TextWrapping="Wrap"
                       IsVisible="{Binding SendProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       AutomationProperties.AutomationId="SendProblem" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="canvas:ConnectionViewModel">
          <StackPanel Spacing="12">
            <Border Padding="12" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                    BorderBrush="{DynamicResource Border80Brush}" Background="{DynamicResource SurfaceRaisedBrush}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <TextBlock Classes="caption" Text="From" />
                <TextBlock Grid.Column="1" Text="{Binding From.Title}" TextTrimming="CharacterEllipsis"
                           FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}" />
                <TextBlock Grid.Row="1" Classes="caption" Text="Type" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Kind}"
                           FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}" />
                <TextBlock Grid.Row="2" Classes="caption" Text="To" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding To.Title}" TextTrimming="CharacterEllipsis"
                           FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}" />
              </Grid>
            </Border>
            <StackPanel Spacing="6">
              <TextBlock Classes="caption" Text="Kind" />
              <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2">
                <!-- Each swatch draws its kind's line, so the buttons double as the legend for the canvas. -->
                <UniformGrid Columns="2">
                  <Button Classes="segment"
                          Command="{Binding SetKindCommand}"
                          CommandParameter="{x:Static workflows:ConnectionKind.Dependency}"
                          AutomationProperties.AutomationId="KindDependency"
                          AutomationProperties.Name="Dependency">
                    <StackPanel Spacing="4">
                      <Line StartPoint="0,1" EndPoint="18,1" StrokeThickness="2" HorizontalAlignment="Center"
                            Stroke="{DynamicResource ConnectionDependencyBrush}" />
                      <TextBlock Text="Dependency" />
                    </StackPanel>
                  </Button>
                  <Button Classes="segment"
                          Command="{Binding SetKindCommand}"
                          CommandParameter="{x:Static workflows:ConnectionKind.Context}"
                          AutomationProperties.AutomationId="KindContext"
                          AutomationProperties.Name="Context">
                    <StackPanel Spacing="4">
                      <Line StartPoint="0,1" EndPoint="18,1" StrokeThickness="2" StrokeDashArray="2,1.5" HorizontalAlignment="Center"
                            Stroke="{DynamicResource ConnectionContextBrush}" />
                      <TextBlock Text="Context" />
                    </StackPanel>
                  </Button>
                </UniformGrid>
              </Border>
            </StackPanel>
            <Button Classes="nav" Content="Delete connection" Command="{Binding DeleteCommand}" />
          </StackPanel>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</UserControl>
