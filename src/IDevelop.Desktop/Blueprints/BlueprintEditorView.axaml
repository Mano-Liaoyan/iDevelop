<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             x:Class="IDevelop.Desktop.Blueprints.BlueprintEditorView"
             x:DataType="blueprints:BlueprintEditorViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Inspector/InspectorStyles.axaml" />
  </UserControl.Styles>
  <!-- The form scrolls under its actions, so Save stays in view however long the form is. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource DestructiveTextBrush}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.AutomationId="BlueprintProblem" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Save Blueprint" Command="{Binding SaveCommand}"
                  AutomationProperties.AutomationId="SaveBlueprint" AutomationProperties.Name="Save blueprint" />
          <Button Classes="action" Content="Cancel" Command="{Binding CancelCommand}" FontSize="13"
                  AutomationProperties.AutomationId="CancelBlueprint" AutomationProperties.Name="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer>
  <StackPanel Margin="12,12,12,16" AutomationProperties.AutomationId="BlueprintEditor">
    <!-- The heading, its caption, and the problem end at the value edge, before the trailing column, as paragraphs do. -->
    <TextBlock Classes="headerName" Margin="0,0,52,0" Text="{Binding Heading, Converter={x:Static inspector:InspectorConverters.TitleCase}}" />
    <TextBlock Classes="kindLine" Text="{Binding Caption}" Margin="0,2,52,10"
               AutomationProperties.AutomationId="BlueprintCaption" />

    <inspector:InspectorSection Key="BlueprintAbout" Title="Blueprint">
      <StackPanel>
        <!-- A segmented control takes its own line, as a connection's kind does, so neither choice is cut short. -->
        <inspector:InspectorRow Label="Library" Layout="Stacked" IsShown="{Binding IsNew}">
          <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2">
            <UniformGrid Columns="2">
              <RadioButton Classes="segment" GroupName="BlueprintLibrary" Content="Project"
                           IsChecked="{Binding InProject}"
                           AutomationProperties.AutomationId="BlueprintInProject"
                           AutomationProperties.Name="Project library" />
              <RadioButton Classes="segment" GroupName="BlueprintLibrary" Content="Personal"
                           IsChecked="{Binding InPersonal}" IsEnabled="{Binding CanChoosePersonal}"
                           AutomationProperties.AutomationId="BlueprintInPersonal"
                           AutomationProperties.Name="Personal library" />
            </UniformGrid>
          </Border>
        </inspector:InspectorRow>
        <inspector:InspectorRow Label="Name">
          <TextBox Text="{Binding Name}"
                   AutomationProperties.AutomationId="BlueprintName"
                   AutomationProperties.Name="Name" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Label="Description" Layout="Stacked">
          <TextBox Classes="multiline" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;"
                   AutomationProperties.AutomationId="BlueprintDescription"
                   AutomationProperties.Name="Description" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Layout="Full" IsShown="{Binding IsAgent}">
          <CheckBox Content="Read-only: the agent may not edit the project" IsChecked="{Binding ReadOnly}"
                    AutomationProperties.AutomationId="BlueprintReadOnly" />
        </inspector:InspectorRow>
      </StackPanel>
    </inspector:InspectorSection>

    <!-- Each field is a group of rows on the panel's columns, so its boxes end where every other box ends, and a hairline
         parts it from the next. Remove ends the group's first row where the other rows' glyph buttons end. -->
    <inspector:InspectorSection Key="BlueprintFields" Title="Fields">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Fields}" AutomationProperties.AutomationId="BlueprintFields">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="blueprints:FieldRowViewModel">
              <Border Classes="fieldGroup">
                <StackPanel>
                  <!-- One fold row: the field's label and what it asks. Its key and the rest sit inside it. -->
                  <Grid Classes="fieldFold" ColumnDefinitions="*,Auto">
                    <ToggleButton Classes="fieldFold" IsChecked="{Binding IsOpen}"
                                  ToolTip.Tip="{Binding FoldLabel}"
                                  AutomationProperties.AutomationId="FieldFold"
                                  AutomationProperties.Name="{Binding FoldLabel}">
                      <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
                        <PathIcon Classes="fieldChevron" Theme="{StaticResource Glyph}" Width="12" Height="12" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Classes="fieldTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                     AutomationProperties.AutomationId="FieldTitle" />
                          <TextBlock Classes="fieldSummary" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                     AutomationProperties.AutomationId="FieldSummary" />
                        </StackPanel>
                      </Grid>
                    </ToggleButton>
                    <Button Grid.Column="1" Classes="glyph" VerticalAlignment="Center" Command="{Binding RemoveCommand}"
                            ToolTip.Tip="Remove field"
                            AutomationProperties.AutomationId="RemoveField" AutomationProperties.Name="Remove field">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDelete}" Width="14" Height="14" />
                    </Button>
                  </Grid>
                  <StackPanel IsVisible="{Binding IsOpen}">
                    <inspector:InspectorRow Label="Label">
                      <TextBox Text="{Binding Label}"
                               AutomationProperties.AutomationId="FieldLabel" AutomationProperties.Name="Label" />
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="Key">
                      <TextBox Text="{Binding Key}"
                               AutomationProperties.AutomationId="FieldKey" AutomationProperties.Name="Key" />
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Layout="Full">
                      <WrapPanel Orientation="Horizontal" ItemSpacing="16">
                        <CheckBox Content="Several lines" IsChecked="{Binding Multiline}"
                                  AutomationProperties.AutomationId="FieldMultiline" />
                        <CheckBox Content="Required" IsChecked="{Binding Required}"
                                  AutomationProperties.AutomationId="FieldRequired" />
                      </WrapPanel>
                    </inspector:InspectorRow>
                    <inspector:InspectorRow Label="Default" Layout="Stacked">
                      <TextBox Text="{Binding Default}" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" NewLine="&#10;"
                               Classes.multiline="{Binding Multiline}"
                               AutomationProperties.AutomationId="FieldDefault" AutomationProperties.Name="Default" />
                    </inspector:InspectorRow>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <inspector:InspectorRow Layout="Buttons">
          <Button Classes="action" HorizontalAlignment="Left" Command="{Binding AddFieldCommand}"
                  AutomationProperties.AutomationId="AddBlueprintField" AutomationProperties.Name="Add field">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" Width="14" Height="14" />
              <TextBlock Text="Add Field" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </inspector:InspectorRow>
      </StackPanel>
    </inspector:InspectorSection>

    <inspector:InspectorSection Key="BlueprintTemplate" Title="{Binding TemplateHeading, Converter={x:Static inspector:InspectorConverters.TitleCase}}"
                                IsShown="{Binding HasTemplate}">
      <StackPanel>
        <inspector:InspectorRow Layout="Full">
          <TextBox Classes="multiline" Text="{Binding Template}" AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="120"
                   AutomationProperties.AutomationId="BlueprintTemplate"
                   AutomationProperties.Name="Template" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Label="Fix template" Layout="Stacked" IsShown="{Binding IsReview}">
          <TextBox Classes="multiline" Text="{Binding FixTemplate}" AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;" MinHeight="80"
                   AutomationProperties.AutomationId="BlueprintFixTemplate"
                   AutomationProperties.Name="Fix template" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Layout="Full">
          <TextBlock Classes="caption" Text="{Binding TemplateHelp}" TextWrapping="Wrap" />
        </inspector:InspectorRow>
      </StackPanel>
    </inspector:InspectorSection>

    <inspector:InspectorSection Key="BlueprintDefaults" Title="Defaults" IsShown="{Binding HasTemplate}">
      <StackPanel>
        <inspector:InspectorRow Label="Client">
          <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding Client}"
                    AutomationProperties.AutomationId="BlueprintClient"
                    AutomationProperties.Name="Client" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Label="Model" IsShown="{Binding HasClient}">
          <TextBox Text="{Binding Model}" Watermark="The client's default"
                   AutomationProperties.AutomationId="BlueprintModel" AutomationProperties.Name="Model" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Label="Reasoning" IsShown="{Binding HasClient}">
          <TextBox Text="{Binding Reasoning}" Watermark="The model's default"
                   AutomationProperties.AutomationId="BlueprintReasoning" AutomationProperties.Name="Reasoning" />
        </inspector:InspectorRow>
        <inspector:InspectorRow Label="Conversation" IsShown="{Binding IsAgent}">
          <ComboBox ItemsSource="{Binding ConversationChoices}" SelectedItem="{Binding Conversation}"
                    AutomationProperties.AutomationId="BlueprintConversation"
                    AutomationProperties.Name="Conversation" />
        </inspector:InspectorRow>
      </StackPanel>
    </inspector:InspectorSection>

  </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
