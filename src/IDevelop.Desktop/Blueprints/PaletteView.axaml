<!-- The Library section of the workflow inspector: one line per blueprint with its kind tile, and Place, Derive, and Edit
     as glyph buttons. The Add popover is where people add nodes; this is where they manage blueprints. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Blueprints.PaletteView"
             x:DataType="blueprints:BlueprintsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Inspector/InspectorStyles.axaml" />
  </UserControl.Styles>
  <StackPanel AutomationProperties.AutomationId="Palette">
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="blueprints:PaletteGroup">
          <StackPanel>
            <inspector:InspectorRow Layout="Full">
              <TextBlock Classes="groupHeading" Text="{Binding Heading, Converter={x:Static inspector:InspectorConverters.TitleCase}}" />
            </inspector:InspectorRow>
            <inspector:InspectorRow Layout="Full" IsShown="{Binding IsEmpty}">
              <TextBlock Classes="note" Text="None yet. Derive a blueprint to add one." ToolTip.Tip="None yet. Derive a blueprint to add one." />
            </inspector:InspectorRow>
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="blueprints:BlueprintEntryViewModel">
                  <inspector:InspectorRow Layout="Full" Label="{Binding Name}">
                    <!-- Edit keeps its column while hidden, so every row's buttons line up. -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,24" ColumnSpacing="2">
                      <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="18" Margin="0,0,6,0" />
                      <TextBlock Grid.Column="1" Classes="entryName" Text="{Binding Name}" Background="Transparent">
                        <ToolTip.Tip>
                          <StackPanel Spacing="2" MaxWidth="280">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </ToolTip.Tip>
                      </TextBlock>
                      <Button Grid.Column="2" Classes="glyph" Command="{Binding PlaceCommand}" ToolTip.Tip="Place in view"
                              AutomationProperties.AutomationId="PlaceBlueprint"
                              AutomationProperties.Name="{Binding PlaceName}">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" Width="14" Height="14" />
                      </Button>
                      <Button Grid.Column="3" Classes="glyph" Command="{Binding DeriveCommand}" ToolTip.Tip="Derive a blueprint"
                              AutomationProperties.AutomationId="DeriveBlueprint"
                              AutomationProperties.Name="{Binding DeriveName}">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" Width="14" Height="14" />
                      </Button>
                      <Button Grid.Column="4" Classes="glyph" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Edit"
                              AutomationProperties.AutomationId="EditBlueprint"
                              AutomationProperties.Name="{Binding EditName}">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconEdit}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </inspector:InspectorRow>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <inspector:InspectorRow Layout="Full" IsShown="{Binding HasProblems}">
      <ItemsControl ItemsSource="{Binding Problems}"
                    AutomationProperties.AutomationId="BlueprintProblems">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </inspector:InspectorRow>
    <inspector:InspectorRow Layout="Full">
      <Button Classes="ghost" HorizontalAlignment="Left" Height="28" Margin="-8,4,0,0" Command="{Binding ReloadCommand}"
              ToolTip.Tip="Read the project and personal libraries again"
              AutomationProperties.AutomationId="ReloadBlueprints"
              AutomationProperties.Name="Read the libraries again">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
          <TextBlock Text="Reload Libraries" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </inspector:InspectorRow>
  </StackPanel>
</UserControl>
