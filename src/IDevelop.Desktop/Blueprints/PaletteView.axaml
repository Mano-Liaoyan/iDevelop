<!-- The Library section of the workflow inspector: one line per blueprint with its kind tile, Place as a glyph button,
     and Derive and Edit in its More menu. The Add popover is where people add nodes; this is where they manage blueprints. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blueprints="using:IDevelop.Desktop.Blueprints"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Blueprints.PaletteView"
             x:DataType="blueprints:BlueprintsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Inspector/InspectorStyles.axaml" />
  </UserControl.Styles>
  <StackPanel AutomationProperties.AutomationId="Palette">
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="blueprints:PaletteGroup">
          <StackPanel>
            <inspector:InspectorRow Layout="Full">
              <TextBlock Classes="groupHeading" Text="{Binding Heading, Converter={x:Static inspector:InspectorConverters.TitleCase}}" />
            </inspector:InspectorRow>
            <inspector:InspectorRow Layout="Full" IsShown="{Binding IsEmpty}">
              <TextBlock Classes="note" Text="None yet. Derive a blueprint to add one." TextWrapping="Wrap" MaxLines="0" />
            </inspector:InspectorRow>
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="blueprints:BlueprintEntryViewModel">
                  <inspector:InspectorRow Layout="Title" Classes="entry" Label="{Binding Name}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2" MaxWidth="280">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Version}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <inspector:InspectorRow.Lead>
                      <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="16" />
                    </inspector:InspectorRow.Lead>
                    <inspector:InspectorRow.Actions>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="glyph" Command="{Binding PlaceCommand}" ToolTip.Tip="Place in view"
                                AutomationProperties.AutomationId="PlaceBlueprint"
                                AutomationProperties.Name="{Binding PlaceName}">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" Width="14" Height="14" />
                        </Button>
                        <Button Classes="glyph" ToolTip.Tip="More"
                                AutomationProperties.AutomationId="BlueprintMore"
                                AutomationProperties.Name="{Binding MoreName}">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconMore}" Width="14" Height="14" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="Derive Blueprint…" Command="{Binding DeriveCommand}"
                                        AutomationProperties.AutomationId="DeriveBlueprint"
                                        AutomationProperties.Name="{Binding DeriveName}">
                                <MenuItem.Icon>
                                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Edit Blueprint…" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}"
                                        AutomationProperties.AutomationId="EditBlueprint"
                                        AutomationProperties.Name="{Binding EditName}">
                                <MenuItem.Icon>
                                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconEdit}" />
                                </MenuItem.Icon>
                              </MenuItem>
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </inspector:InspectorRow.Actions>
                  </inspector:InspectorRow>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <inspector:InspectorRow Layout="Full" IsShown="{Binding HasProblems}">
      <ItemsControl ItemsSource="{Binding Problems}"
                    AutomationProperties.AutomationId="BlueprintProblems">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </inspector:InspectorRow>
    <inspector:InspectorRow Layout="Buttons">
      <Button Classes="ghost" HorizontalAlignment="Left" Height="28" Margin="-8,4,0,0" Command="{Binding ReloadCommand}"
              ToolTip.Tip="Read the project and personal libraries again"
              AutomationProperties.AutomationId="ReloadBlueprints"
              AutomationProperties.Name="Read the libraries again">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
          <TextBlock Text="Reload Libraries" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </inspector:InspectorRow>
  </StackPanel>
</UserControl>
