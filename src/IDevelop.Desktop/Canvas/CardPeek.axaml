<!-- A collapsed card's tooltip (#94, ADR 0024): a quick read-only look at what the expanded card would show first. The
     title and the agent, then what goes on now under its heading. A tooltip takes no input, so answering, the links, and
     the agent's pickers stay on the expanded card. Its last line names the one action that opens the agent's conversation. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             x:Class="IDevelop.Desktop.Canvas.CardPeek"
             x:DataType="canvas:TaskNodeViewModel"
             Width="{x:Static canvas:CardPeek.PeekWidth}"
             AutomationProperties.AutomationId="CardPeek">
  <StackPanel Spacing="2">
    <TextBlock Text="{Binding Title}" Classes="small" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource TextStrongBrush}" />
    <TextBlock Text="{Binding PeekAgent}" Classes="caption" TextWrapping="Wrap" />
    <Border Height="1" Margin="0,6" Background="{DynamicResource Border60Brush}" />
    <ContentControl Content="{Binding Detail}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="canvas:CardDetailViewModel">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Heading}" Classes="small" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextStrongBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Meta}" Classes="caption" VerticalAlignment="Center"
                         IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
            <TextBlock Text="{Binding Text}" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                       IsVisible="{Binding HasText}" />
          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <TextBlock Text="{Binding Detail.Problem, FallbackValue={x:Null}}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
               IsVisible="{Binding Detail.HasProblem, FallbackValue=False}" />
    <TextBlock Text="Double-click or Enter opens the conversation." Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding HasAgent}"
               AutomationProperties.AutomationId="CardPeekGesture" />
  </StackPanel>
</UserControl>
