<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Canvas.WorkflowCanvasView"
             x:DataType="canvas:WorkflowCanvasViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Canvas/CanvasTemplates.axaml" />
        <ResourceInclude Source="/Canvas/CanvasMenus.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="/Canvas/CanvasStyles.axaml" />
  </UserControl.Styles>

  <Panel>
    <nodify:NodifyEditor x:Name="Editor"
                         ItemsSource="{Binding Nodes}"
                         SelectedItem="{Binding SelectedNode}"
                         SelectedItems="{Binding SelectedNodes}"
                         Connections="{Binding Connections}"
                         SelectedConnection="{Binding SelectedConnection}"
                         SelectedConnections="{Binding SelectedConnections}"
                         PendingConnection="{Binding PendingConnection}"
                         ViewportLocation="{Binding ViewportLocation}"
                         ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                         ConnectionCompletedCommand="{Binding ConnectCommand}"
                         RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                         ItemsDragCompletedCommand="{Binding CommitMovesCommand}"
                         Decorators="{Binding Ghosts}"
                         ItemTemplate="{StaticResource TaskCardTemplate}"
                         ConnectionTemplate="{StaticResource ConnectionTemplate}"
                         PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                         GridCellSize="15">

      <nodify:NodifyEditor.Background>
        <!-- A DrawingBrush keeps drawing the brush objects of its first frame, so these two brushes stay the same
             objects and take their colors from theme Color keys. The transform keeps the dots fixed to the canvas. -->
        <DrawingBrush TileMode="Tile" DestinationRect="0,0,24,24" Transform="{Binding #Editor.DpiScaledViewportTransform}">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Geometry="M0,0 H24 V24 H0 Z">
                <GeometryDrawing.Brush>
                  <SolidColorBrush Color="{DynamicResource CanvasGrid.BackgroundColor}" />
                </GeometryDrawing.Brush>
              </GeometryDrawing>
              <GeometryDrawing>
                <GeometryDrawing.Brush>
                  <SolidColorBrush Color="{DynamicResource CanvasGrid.DotColor}" />
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                  <EllipseGeometry Rect="0,0,1,1" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </nodify:NodifyEditor.Background>

      <!-- Nodify gives every decorator one template, so the ghosts leave it unset and take theirs by type from here.
           A proposal's tasks draw as dashed cards over the empty cards they fill, and its connections as dashed wires.
           A wire dropped on empty canvas stays as the line it was while the Add popover is open. -->
      <nodify:NodifyEditor.DataTemplates>
        <!-- A ghost has a card's three lines. A tab hanging from it says why the planner's choice of agent falls back. -->
        <DataTemplate DataType="canvas:GhostCardViewModel">
          <StackPanel Width="{x:Static canvas:WorkflowCanvasViewModel.TaskCardWidth}"
                      AutomationProperties.AutomationId="GhostCard"
                      AutomationProperties.Name="{Binding Title}">
            <Panel Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}">
              <Border Classes="ghost" Margin="10,0" CornerRadius="{StaticResource RadiusXl}" />
              <Rectangle Classes="kindStroke" Margin="10,0" RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="4,3"
                         theme:StyleClass.Kind="{Binding Kind}" />
              <Grid Margin="22,0" ColumnDefinitions="32,*" ColumnSpacing="12">
                <theme:KindTile Kind="{Binding Kind}" TileSize="32" Opacity="0.55" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Classes="cardText">
                  <TextBlock Classes="cardTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="GhostTitle" />
                  <TextBlock Classes="cardAgent" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="GhostLabel" />
                  <TextBlock Classes="cardAgent" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="GhostDetail" />
                </StackPanel>
              </Grid>
            </Panel>
            <Border Classes="ghostNote" IsVisible="{Binding HasNote}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" />
                <TextBlock Text="{Binding Note}" AutomationProperties.AutomationId="GhostNote" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="canvas:GhostWireViewModel">
          <nodify:StepConnection Classes="ghost" Source="{Binding Source}" Target="{Binding Target}"
                                 theme:StyleClass.Kind="{Binding Kind}" Classes.context="{Binding IsContext}"
                                 AutomationProperties.AutomationId="GhostWire" />
        </DataTemplate>
        <DataTemplate DataType="canvas:DanglingWireViewModel">
          <nodify:LineConnection Classes="dangling" Source="{Binding Source}" Target="{Binding Target}"
                                 theme:StyleClass.Kind="{Binding Kind}"
                                 AutomationProperties.AutomationId="DanglingWire" />
        </DataTemplate>
      </nodify:NodifyEditor.DataTemplates>

      <nodify:NodifyEditor.ItemContainerTheme>
        <ControlTheme TargetType="nodify:ItemContainer"
                      BasedOn="{StaticResource {x:Type nodify:ItemContainer}}"
                      x:DataType="canvas:TaskNodeViewModel">
          <Setter Property="Location" Value="{Binding Location}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="SelectedBorderThickness" Value="0" />
          <!-- The selection ring and the shadow are drawn outside the card's box. -->
          <Setter Property="ClipToBounds" Value="False" />
        </ControlTheme>
      </nodify:NodifyEditor.ItemContainerTheme>

      <!-- A proposal's tasks and connections, and a dropped wire, draw as ghosts that take no input. -->
      <nodify:NodifyEditor.DecoratorContainerStyle>
        <ControlTheme TargetType="nodify:DecoratorContainer"
                      BasedOn="{StaticResource {x:Type nodify:DecoratorContainer}}"
                      x:DataType="canvas:Ghost">
          <Setter Property="Location" Value="{Binding Location}" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </ControlTheme>
      </nodify:NodifyEditor.DecoratorContainerStyle>
    </nodify:NodifyEditor>

    <canvas:GenerateLayer />

    <canvas:AddNodePopover x:Name="AddPopover" />

    <Border Classes="floating" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
      <Border>
        <StackPanel>
          <Button Classes="icon zoom" Click="OnZoomIn" ToolTip.Tip="Zoom in (+)"
                  AutomationProperties.AutomationId="ZoomIn" AutomationProperties.Name="Zoom in">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconZoomIn}" />
          </Button>
          <Button Classes="icon zoom" Click="OnZoomOut" ToolTip.Tip="Zoom out (-)"
                  AutomationProperties.AutomationId="ZoomOut" AutomationProperties.Name="Zoom out">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconZoomOut}" />
          </Button>
          <Button Classes="icon zoom" Click="OnFitToScreen" ToolTip.Tip="Fit to view (F)"
                  AutomationProperties.AutomationId="FitToScreen" AutomationProperties.Name="Fit to screen">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFit}" />
          </Button>
        </StackPanel>
      </Border>
    </Border>

    <Button Classes="ghost" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"
            Command="{Binding NextWaitingCommand}"
            IsVisible="{Binding HasWaiting}"
            AutomationProperties.AutomationId="NextWaiting"
            AutomationProperties.Name="Show the next task that waits for you">
      <Border Classes="pill waiting">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Theme="{StaticResource Glyph}" />
          <TextBlock Text="{Binding WaitingLabel}" AutomationProperties.AutomationId="WaitingCount" />
        </StackPanel>
      </Border>
    </Button>

    <!-- The code-behind sets the margin, so the bars never cover the zoom controls or the minimap. UI Automation shows
         no plain border, so a user control carries each bar's id. The workflow run's bar sits above the bar of a task
         that runs on its own. -->
    <StackPanel x:Name="RunBars" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="8">
      <UserControl HorizontalAlignment="Center"
                   IsVisible="{Binding Run, Converter={x:Static ObjectConverters.IsNotNull}}"
                   AutomationProperties.AutomationId="WorkflowRunBar"
                   AutomationProperties.Name="{Binding Run.Summary, FallbackValue='Workflow run'}">
        <Border Classes="floating">
          <Border Padding="12,6,6,6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="pill" HorizontalAlignment="Left"
                          Classes.running="{Binding Run.Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}, FallbackValue=False}"
                          Classes.complete="{Binding Run.Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}, FallbackValue=False}"
                          Classes.problem="{Binding Run.Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}, FallbackValue=False}"
                          Classes.waiting="{Binding Run.Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}, FallbackValue=False}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Theme="{StaticResource Glyph}" />
                      <TextBlock Text="{Binding Run.StatusLabel}" AutomationProperties.AutomationId="RunStatus" />
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="caption" Text="{Binding Run.Progress}" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="RunProgress" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding Run.Activity}" MaxWidth="360" HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Run.Activity}"
                           IsVisible="{Binding Run.Activity, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                           AutomationProperties.AutomationId="RunActivity" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="ghost" Height="32"
                        Command="{Binding Run.ResumeCommand}" IsVisible="{Binding Run.ShowsResume, FallbackValue=False}"
                        ToolTip.Tip="Start the run's next tasks in this window"
                        AutomationProperties.AutomationId="ResumeRun"
                        AutomationProperties.Name="Resume run">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" Width="14" Height="14" />
                    <TextBlock Text="Resume" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Height="32"
                        Command="{Binding Run.StopCommand}" IsVisible="{Binding Run.ShowsStop, FallbackValue=False}"
                        ToolTip.Tip="Start no more tasks and stop the running ones. Finished work stays."
                        AutomationProperties.AutomationId="StopWorkflow"
                        AutomationProperties.Name="Stop Workflow">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                    <TextBlock Text="Stop Workflow" />
                  </StackPanel>
                </Button>
                <Button Classes="icon" Height="32"
                        Command="{Binding DismissRunCommand}" IsVisible="{Binding ShowsRunWorkflow}"
                        ToolTip.Tip="Hide this run. Its records stay."
                        AutomationProperties.AutomationId="DismissRun"
                        AutomationProperties.Name="Hide the run">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDismiss}" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Border>
      </UserControl>
      <UserControl x:Name="RunBar" HorizontalAlignment="Center"
                   IsVisible="{Binding ActiveRun.IsVisible}"
                   AutomationProperties.AutomationId="RunBar"
                   AutomationProperties.Name="Running task">
        <Border Classes="floating">
          <Border Padding="12,6,6,6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <PathIcon Theme="{StaticResource Glyph}" Classes="spin" Data="{StaticResource IconStateRunning}" Width="14" Height="14"
                        Foreground="{DynamicResource StateRunningBrush}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding ActiveRun.TaskTitle}" MaxWidth="200" TextTrimming="CharacterEllipsis"
                             FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                             AutomationProperties.AutomationId="RunBarTask" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ActiveRun.AgentLabel}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="RunBarAgent" />
                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding ActiveRun.Elapsed}"
                             AutomationProperties.AutomationId="RunBarElapsed" />
                </Grid>
                <TextBlock Classes="caption" Text="{Binding ActiveRun.LastActivity}" MaxWidth="360" HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActiveRun.LastActivity}"
                           AutomationProperties.AutomationId="RunBarActivity" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" Height="32" VerticalAlignment="Center"
                      Command="{Binding ActiveRun.CancelCommand}"
                      AutomationProperties.AutomationId="RunBarCancel"
                      AutomationProperties.Name="Cancel run">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
                  <TextBlock Text="Cancel" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Border>
      </UserControl>
    </StackPanel>

    <Border Classes="floating" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Width="200" Height="150">
      <Border>
        <nodify:Minimap x:Name="Minimap"
                        ItemsSource="{Binding Converter={x:Static canvas:MinimapItems.Of}}"
                        ViewportLocation="{Binding ViewportLocation}"
                        ViewportSize="{Binding #Editor.ViewportSize}"
                        ViewportStyle="{StaticResource MinimapViewportTheme}"
                        AutomationProperties.AutomationId="Minimap"
                        AutomationProperties.Name="Minimap">
          <!-- A card is a small card: its kind's fill, and its state's ring where the state is not idle. A proposal's
               ghost card is a faint fill in a dashed ring of its kind, as on the canvas. -->
          <nodify:Minimap.DataTemplates>
            <DataTemplate DataType="canvas:TaskNodeViewModel">
              <Panel>
                <Border Classes="minimapItem" theme:StyleClass.Kind="{Binding Kind}" />
                <Border Classes="minimapRing stateStroke"
                        theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
              </Panel>
            </DataTemplate>
            <DataTemplate DataType="canvas:GhostCardViewModel">
              <Panel>
                <Border Classes="minimapItem ghost" theme:StyleClass.Kind="{Binding Kind}" />
                <Rectangle Classes="minimapRing kindStroke" theme:StyleClass.Kind="{Binding Kind}" />
              </Panel>
            </DataTemplate>
          </nodify:Minimap.DataTemplates>
          <nodify:Minimap.ItemContainerTheme>
            <!-- The items are cards and ghost cards, two types that each have a Location, so the binding finds it by name. -->
            <ControlTheme TargetType="nodify:MinimapItem"
                          BasedOn="{StaticResource {x:Type nodify:MinimapItem}}">
              <Setter Property="Location" Value="{ReflectionBinding Location, Mode=OneWay}" />
              <Setter Property="Width" Value="{x:Static canvas:WorkflowCanvasViewModel.TaskCardWidth}" />
              <Setter Property="Height" Value="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}" />
            </ControlTheme>
          </nodify:Minimap.ItemContainerTheme>
        </nodify:Minimap>
      </Border>
    </Border>
  </Panel>
</UserControl>
