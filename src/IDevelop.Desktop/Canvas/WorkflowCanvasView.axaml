<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:workflows="using:IDevelop.Workflows"
             x:Class="IDevelop.Desktop.Canvas.WorkflowCanvasView"
             x:DataType="canvas:WorkflowCanvasViewModel">

  <UserControl.Resources>
    <ControlTheme x:Key="PortTheme" TargetType="nodify:Connector">
      <Setter Property="Template">
        <ControlTemplate>
          <TemplatedControl Name="PART_Connector" Width="20" Height="20"
                            Background="{DynamicResource TextStrongBrush}"
                            BorderBrush="{DynamicResource SurfaceBaseBrush}">
            <TemplatedControl.Template>
              <ControlTemplate>
                <!-- The transparent panel lets the whole 20 px square take the pointer, not only the 12 px handle. -->
                <Panel Background="Transparent">
                  <Ellipse Width="12" Height="12" StrokeThickness="2"
                           Fill="{TemplateBinding Background}"
                           Stroke="{TemplateBinding BorderBrush}" />
                </Panel>
              </ControlTemplate>
            </TemplatedControl.Template>
          </TemplatedControl>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ TemplatedControl#PART_Connector">
        <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
      </Style>
      <Style Selector="^.isOverElement /template/ TemplatedControl#PART_Connector">
        <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.ring">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="nodify|ItemContainer:selected:null-previewing-selection Border.ring">
      <Setter Property="BorderBrush" Value="{DynamicResource StateSelectedBrush}" />
    </Style>
    <Style Selector="nodify|ItemContainer:previewing-selection Border.ring">
      <Setter Property="BorderBrush" Value="{DynamicResource StateSelectedBrush}" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    </Style>
    <Style Selector="TextBlock.cardLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.prompt">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.prompt TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.prompt TextBlock.placeholder">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <!-- Nodify's own rule that draws connections below the cards never matches its internal host type. -->
    <Style Selector="nodify|NodifyEditor /template/ :is(Control)#PART_ConnectionsHost">
      <Setter Property="ZIndex" Value="-1" />
    </Style>
    <Style Selector="nodify|StepConnection">
      <Setter Property="Stroke" Value="{DynamicResource ConnectionDependencyBrush}" />
      <Setter Property="Fill" Value="{DynamicResource ConnectionDependencyBrush}" />
      <Setter Property="StrokeThickness" Value="2.2" />
      <Setter Property="Opacity" Value="0.56" />
      <Setter Property="Spacing" Value="20" />
      <Setter Property="CornerRadius" Value="5" />
      <!-- Half a handle's width, so each end meets the edge of its 12 px handle. -->
      <Setter Property="SourceOffset" Value="6,0" />
      <Setter Property="TargetOffset" Value="6,0" />
      <Setter Property="ArrowSize" Value="9,9" />
      <!-- An invisible solid outline gives the pointer a 12 px target around the line, gaps in a dash included. -->
      <Setter Property="OutlineBrush" Value="Transparent" />
      <Setter Property="OutlineThickness" Value="5" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="StrokeThickness" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="nodify|StepConnection.context">
      <Setter Property="Stroke" Value="{DynamicResource ConnectionContextBrush}" />
      <Setter Property="Fill" Value="{DynamicResource ConnectionContextBrush}" />
      <Setter Property="StrokeDashArray" Value="4,3" />
    </Style>
    <Style Selector="nodify|StepConnection.review">
      <Setter Property="Stroke" Value="{DynamicResource ConnectionReviewBrush}" />
      <Setter Property="Fill" Value="{DynamicResource ConnectionReviewBrush}" />
    </Style>
    <Style Selector="nodify|StepConnection:pointerover">
      <Setter Property="StrokeThickness" Value="3.2" />
      <Setter Property="Opacity" Value="0.96" />
    </Style>
    <Style Selector="nodify|StepConnection[(nodify|BaseConnection.IsSelected)=true]">
      <Setter Property="StrokeThickness" Value="3.2" />
      <Setter Property="Opacity" Value="0.96" />
    </Style>
    <Style Selector="nodify|PendingConnection.rejected">
      <Setter Property="Stroke" Value="{DynamicResource StateFailedBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <nodify:NodifyEditor x:Name="Editor"
                         ItemsSource="{Binding Nodes}"
                         SelectedItem="{Binding SelectedNode}"
                         SelectedItems="{Binding SelectedNodes}"
                         Connections="{Binding Connections}"
                         SelectedConnection="{Binding SelectedConnection}"
                         SelectedConnections="{Binding SelectedConnections}"
                         PendingConnection="{Binding PendingConnection}"
                         ViewportLocation="{Binding ViewportLocation}"
                         ConnectionCompletedCommand="{Binding ConnectCommand}"
                         RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                         ItemsDragCompletedCommand="{Binding CommitMovesCommand}"
                         GridCellSize="15">

      <nodify:NodifyEditor.Background>
        <!-- A DrawingBrush keeps drawing the brush objects of its first frame, so these two brushes stay the same
             objects and take their colors from theme Color keys. The transform keeps the dots fixed to the canvas. -->
        <DrawingBrush TileMode="Tile" DestinationRect="0,0,24,24" Transform="{Binding #Editor.DpiScaledViewportTransform}">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Geometry="M0,0 H24 V24 H0 Z">
                <GeometryDrawing.Brush>
                  <SolidColorBrush Color="{DynamicResource CanvasGrid.BackgroundColor}" />
                </GeometryDrawing.Brush>
              </GeometryDrawing>
              <GeometryDrawing>
                <GeometryDrawing.Brush>
                  <SolidColorBrush Color="{DynamicResource CanvasGrid.DotColor}" />
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                  <EllipseGeometry Rect="0,0,1,1" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </nodify:NodifyEditor.Background>

      <nodify:NodifyEditor.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding DeleteSelectionCommand}" />
      </nodify:NodifyEditor.KeyBindings>

      <nodify:NodifyEditor.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Add task"
                    Command="{Binding AddTaskAtCommand}"
                    CommandParameter="{Binding #Editor.MouseLocation}" />
          <MenuItem Header="Delete" InputGesture="Delete" Command="{Binding DeleteSelectionCommand}" />
        </ContextMenu>
      </nodify:NodifyEditor.ContextMenu>

      <nodify:NodifyEditor.ItemContainerTheme>
        <ControlTheme TargetType="nodify:ItemContainer"
                      BasedOn="{StaticResource {x:Type nodify:ItemContainer}}"
                      x:DataType="canvas:TaskNodeViewModel">
          <Setter Property="Location" Value="{Binding Location}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="SelectedBorderThickness" Value="0" />
          <!-- The selection ring and the shadow are drawn outside the card's box. -->
          <Setter Property="ClipToBounds" Value="False" />
        </ControlTheme>
      </nodify:NodifyEditor.ItemContainerTheme>

      <nodify:NodifyEditor.ItemTemplate>
        <DataTemplate DataType="canvas:TaskNodeViewModel">
          <Panel Width="{x:Static canvas:WorkflowCanvasViewModel.TaskCardWidth}"
                 Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}"
                 ToolTip.Tip="{Binding Title}"
                 AutomationProperties.AutomationId="TaskCard"
                 AutomationProperties.Name="{Binding Title}">
            <Border Classes="ring" Margin="6,-4" CornerRadius="18" BorderThickness="2" IsHitTestVisible="False" />
            <Border Classes="card" Margin="10,0" Padding="12" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusXl}"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource Border80Brush}"
                    BoxShadow="{DynamicResource CardShadow}">
              <StackPanel Spacing="4">
                <TextBlock Classes="cardTitle" Height="24" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="cardLabel" Margin="0,6,0,0" Text="Instructions" />
                <Border Classes="prompt" Height="64">
                  <Panel>
                    <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
                    <TextBlock Classes="placeholder" Text="No instructions yet."
                               IsVisible="{Binding Instructions, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                  </Panel>
                </Border>
              </StackPanel>
            </Border>
            <!-- PlanWeave puts the target handle at 56% of the card's height and the source handle at 44%. -->
            <ContentControl Content="{Binding Input}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,71,0,0">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="canvas:PortViewModel">
                  <nodify:NodeInput Theme="{StaticResource PortTheme}"
                                    Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                    IsConnected="{Binding IsConnected}"
                                    AutomationProperties.Name="Task input" />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding Output}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,53,0,0">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="canvas:PortViewModel">
                  <nodify:NodeOutput Theme="{StaticResource PortTheme}"
                                     Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                     IsConnected="{Binding IsConnected}"
                                     AutomationProperties.Name="Task output" />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Panel>
        </DataTemplate>
      </nodify:NodifyEditor.ItemTemplate>

      <nodify:NodifyEditor.ConnectionTemplate>
        <DataTemplate DataType="canvas:ConnectionViewModel">
          <nodify:StepConnection Source="{Binding From.Output.Anchor}"
                                 Target="{Binding To.Input.Anchor}"
                                 Classes.context="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                                 Classes.review="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Review}}"
                                 nodify:BaseConnection.IsSelectable="True">
            <nodify:StepConnection.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Dependency"
                          Command="{Binding SetKindCommand}"
                          CommandParameter="{x:Static workflows:ConnectionKind.Dependency}" />
                <MenuItem Header="Context"
                          Command="{Binding SetKindCommand}"
                          CommandParameter="{x:Static workflows:ConnectionKind.Context}" />
                <MenuItem Header="Review"
                          Command="{Binding SetKindCommand}"
                          CommandParameter="{x:Static workflows:ConnectionKind.Review}" />
                <Separator />
                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
              </ContextMenu>
            </nodify:StepConnection.ContextMenu>
          </nodify:StepConnection>
        </DataTemplate>
      </nodify:NodifyEditor.ConnectionTemplate>

      <nodify:NodifyEditor.PendingConnectionTemplate>
        <DataTemplate DataType="canvas:PendingConnectionViewModel">
          <nodify:PendingConnection Source="{Binding Source, Mode=OneWayToSource}"
                                    PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}"
                                    EnablePreview="True"
                                    Content="{Binding PreviewText}"
                                    Classes.rejected="{Binding IsRejected}" />
        </DataTemplate>
      </nodify:NodifyEditor.PendingConnectionTemplate>
    </nodify:NodifyEditor>
  </Panel>
</UserControl>
