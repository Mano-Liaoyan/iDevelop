<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Canvas.WorkflowCanvasView"
             x:DataType="canvas:WorkflowCanvasViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Canvas/CanvasTemplates.axaml" />
        <ResourceInclude Source="/Canvas/CanvasMenus.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Below a zoom of 0.5 the dots turn into a texture, so the canvas has only its color. -->
      <SolidColorBrush x:Key="CanvasPlainBrush" Color="{DynamicResource CanvasGrid.BackgroundColor}" />
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="/Canvas/CanvasStyles.axaml" />
  </UserControl.Styles>

  <Panel>
    <nodify:NodifyEditor x:Name="Editor"
                         ItemsSource="{Binding Nodes}"
                         SelectedItem="{Binding SelectedNode}"
                         SelectedItems="{Binding SelectedNodes}"
                         Connections="{Binding Connections}"
                         SelectedConnection="{Binding SelectedConnection}"
                         SelectedConnections="{Binding SelectedConnections}"
                         PendingConnection="{Binding PendingConnection}"
                         ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                         ViewportLocation="{Binding ViewportLocation}"
                         ConnectionCompletedCommand="{Binding ConnectCommand}"
                         RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                         ItemsDragCompletedCommand="{Binding CommitMovesCommand}"
                         Decorators="{Binding Ghosts}"
                         ItemTemplate="{StaticResource TaskCardTemplate}"
                         ConnectionTemplate="{StaticResource ConnectionTemplate}"
                         PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                         GridCellSize="15">

      <nodify:NodifyEditor.Background>
        <!-- A DrawingBrush keeps drawing the brush objects of its first frame, so these two brushes stay the same
             objects and take their colors from theme Color keys. The transform keeps the dots fixed to the canvas. -->
        <DrawingBrush TileMode="Tile" DestinationRect="0,0,24,24" Transform="{Binding #Editor.DpiScaledViewportTransform}">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Geometry="M0,0 H24 V24 H0 Z">
                <GeometryDrawing.Brush>
                  <SolidColorBrush Color="{DynamicResource CanvasGrid.BackgroundColor}" />
                </GeometryDrawing.Brush>
              </GeometryDrawing>
              <GeometryDrawing>
                <GeometryDrawing.Brush>
                  <SolidColorBrush Color="{DynamicResource CanvasGrid.DotColor}" />
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                  <EllipseGeometry Rect="0,0,1,1" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </nodify:NodifyEditor.Background>

      <!-- Nodify gives every decorator one template, so the ghosts leave it unset and take theirs by type from here.
           A proposal's tasks draw as dashed cards over the empty cards they fill, and its connections as dashed wires.
           A wire dropped on empty canvas stays as the line it was while the Add popover is open. -->
      <nodify:NodifyEditor.DataTemplates>
        <!-- A ghost has a card's three lines. A tab hanging from it says why the planner's choice of agent falls back. -->
        <DataTemplate DataType="canvas:GhostCardViewModel">
          <StackPanel Width="{x:Static canvas:WorkflowCanvasViewModel.TaskCardWidth}"
                      AutomationProperties.AutomationId="GhostCard"
                      AutomationProperties.Name="{Binding Title}">
            <Panel Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}">
              <Border Classes="ghost" Margin="10,0" CornerRadius="{StaticResource RadiusLg}" />
              <Rectangle Classes="kindStroke" Margin="10,0" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="4,3"
                         theme:StyleClass.Kind="{Binding Kind}" />
              <Grid Margin="22,0" ColumnDefinitions="32,*" ColumnSpacing="12">
                <theme:KindTile Kind="{Binding Kind}" TileSize="32" Opacity="0.55" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Classes="cardText">
                  <TextBlock Classes="cardTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="GhostTitle" />
                  <TextBlock Classes="cardAgent" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="GhostLabel" />
                  <TextBlock Classes="cardAgent" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="GhostDetail" />
                </StackPanel>
              </Grid>
            </Panel>
            <Border Classes="ghostNote" IsVisible="{Binding HasNote}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" />
                <TextBlock Text="{Binding Note}" AutomationProperties.AutomationId="GhostNote" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="canvas:GhostWireViewModel">
          <canvas:RoutedConnection Classes="ghost" Source="{Binding Source}" Target="{Binding Target}"
                                   Classes.context="{Binding IsContext}"
                                   AutomationProperties.AutomationId="GhostWire" />
        </DataTemplate>
        <DataTemplate DataType="canvas:DanglingWireViewModel">
          <nodify:LineConnection Classes="dangling" Source="{Binding Source}" Target="{Binding Target}"
                                 AutomationProperties.AutomationId="DanglingWire" />
        </DataTemplate>
      </nodify:NodifyEditor.DataTemplates>

      <nodify:NodifyEditor.ItemContainerTheme>
        <ControlTheme TargetType="nodify:ItemContainer"
                      BasedOn="{StaticResource {x:Type nodify:ItemContainer}}"
                      x:DataType="canvas:TaskNodeViewModel">
          <!-- Where the card shows: its saved position, moved aside on screen while other cards are expanded (ADR 0024). -->
          <Setter Property="Location" Value="{Binding DisplayLocation}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="SelectedBorderThickness" Value="0" />
          <!-- The selection ring and the shadow are drawn outside the card's box. -->
          <Setter Property="ClipToBounds" Value="False" />
        </ControlTheme>
      </nodify:NodifyEditor.ItemContainerTheme>

      <!-- A proposal's tasks and connections, and a dropped wire, draw as ghosts that take no input. -->
      <nodify:NodifyEditor.DecoratorContainerStyle>
        <ControlTheme TargetType="nodify:DecoratorContainer"
                      BasedOn="{StaticResource {x:Type nodify:DecoratorContainer}}"
                      x:DataType="canvas:Ghost">
          <Setter Property="Location" Value="{Binding Location}" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <!-- NodifyAvalonia 6.6.0 undoes the editor's zoom on each decorator, so a ghost would keep its size as the cards
               shrink and cover its neighbours. Without that transform, a ghost takes the zoom as the cards do. -->
          <Setter Property="RenderTransform" Value="{x:Null}" />
        </ControlTheme>
      </nodify:NodifyEditor.DecoratorContainerStyle>
    </nodify:NodifyEditor>

    <!-- The keyboard's place: the canvas took the focus by a key, so its keys act here. -->
    <Border x:Name="CanvasFocus" Classes="canvasFocus" IsHitTestVisible="False" IsVisible="False"
            AutomationProperties.AutomationId="CanvasFocus" />

    <canvas:GenerateLayer />

    <canvas:AddNodePopover x:Name="AddPopover" />

    <!-- The zoom controls, the run bar, and the minimap share the canvas's bottom edge, 12 px above it. The code-behind decides
         what shows, from the canvas's size and from whether a card is outside the view. -->
    <canvas:CanvasBottomBar x:Name="BottomBar" VerticalAlignment="Bottom" Margin="12">
      <Border x:Name="ZoomPanel" Classes="floating" canvas:CanvasBottomBar.Slot="Leading" IsVisible="{Binding !IsEmpty}">
        <Border Padding="1">
          <StackPanel>
            <!-- The panel is Fit and its chevron until the graph leaves the view or the person opens it. -->
            <Grid x:Name="ZoomMore" ColumnDefinitions="28,28" RowDefinitions="28,28" IsVisible="False">
              <!-- Expand All and Collapse All, for this workflow's cards only (ADR 0024), with the zoom controls, since it
                   changes only this machine's view. The tooltip's first line names it. Its glyph is no chevron, so the panel's
                   one chevron is the one that closes the panel. -->
              <Panel x:Name="ExpandAllSlot">
              <Button Classes="icon zoom" Command="{Binding ExpandCardsCommand}" IsVisible="{Binding !IsEmpty}"
                      ToolTip.Tip="{Binding ExpandCardsLabel, StringFormat='{}{0}&#10;Show or hide the details of every card in this workflow'}"
                      AutomationProperties.AutomationId="ExpandAll"
                      AutomationProperties.Name="{Binding ExpandCardsLabel}">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconExpandAll}" />
              </Button>
              </Panel>
              <ToggleButton x:Name="MinimapToggle" Grid.Column="1" Classes="zoom"
                            ToolTip.Tip="Show the minimap"
                            AutomationProperties.AutomationId="ShowMinimap" AutomationProperties.Name="Show the minimap">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconMinimap}" />
              </ToggleButton>
              <Button Grid.Row="1" Classes="icon zoom" Click="OnZoomOut" ToolTip.Tip="Zoom out (-)"
                      AutomationProperties.AutomationId="ZoomOut" AutomationProperties.Name="Zoom out">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconZoomOut}" />
              </Button>
              <Button Grid.Row="1" Grid.Column="1" Classes="icon zoom" Click="OnZoomIn" ToolTip.Tip="Zoom in (+)"
                      AutomationProperties.AutomationId="ZoomIn" AutomationProperties.Name="Zoom in">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconZoomIn}" />
              </Button>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Button Classes="icon zoom" Click="OnFitToScreen" ToolTip.Tip="Fit to view (F)"
                      AutomationProperties.AutomationId="FitToScreen" AutomationProperties.Name="Fit to screen">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFit}" />
              </Button>
              <Button Classes="ghost zoom zoomValue" Click="OnZoomActual" ToolTip.Tip="Zoom to 100% (0)"
                      AutomationProperties.AutomationId="ZoomValue" AutomationProperties.Name="Reset the zoom">
                <TextBlock Text="{Binding ZoomLabel}" AutomationProperties.AutomationId="ZoomLabel" />
              </Button>
              <ToggleButton x:Name="ZoomOpen" Classes="zoom zoomOpen" ToolTip.Tip="Zoom controls"
                            AutomationProperties.AutomationId="ZoomOpen" AutomationProperties.Name="Zoom controls">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronUp}" Width="12" Height="12" />
              </ToggleButton>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- One bar for a run: how far it went, one chip per state that has nodes, Next, Follow, and Merge into my branch while
           every node is completed and nothing is stale (ADR 0017). The chips are the canvas's badges with their counts, so the bar
           is also the badges' legend. Stop All sits where Run Workflow was. UI Automation shows no plain border, so a user
           control carries its id. On a narrow canvas the summary shortens and Follow keeps only its glyph. -->
      <StackPanel x:Name="RunBars" canvas:CanvasBottomBar.Slot="Center" VerticalAlignment="Bottom" Spacing="8">
        <UserControl HorizontalAlignment="Center" ClipToBounds="False"
                     IsVisible="{Binding ShowsBar}"
                     ToolTip.Tip="{Binding BarTip}"
                     AutomationProperties.HelpText="{Binding BarTip}"
                     AutomationProperties.AutomationId="WorkflowRunBar"
                     AutomationProperties.Name="{Binding BarSummary}">
          <Border Classes="floating">
            <Border Height="38" Padding="10,0,8,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                  <Button Classes="action bar" Command="{Binding NextWaitingCommand}" IsVisible="{Binding HasAttention}"
                          ToolTip.Tip="{x:Static canvas:WorkflowCanvasView.NextHelp}"
                          AutomationProperties.AutomationId="NextWaiting"
                          AutomationProperties.Name="Show the next node that waits for you or failed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="label" Text="Next" VerticalAlignment="Center" />
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" Width="12" Height="12" />
                    </StackPanel>
                  </Button>
                  <ToggleButton Classes="bar follow" IsChecked="{Binding IsFollowing}" IsVisible="{Binding !!RunningCount}"
                                ToolTip.Tip="{Binding FollowLabel}"
                                AutomationProperties.AutomationId="FollowRunning"
                                AutomationProperties.Name="{Binding FollowLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFollow}" />
                      <TextBlock Classes="followLabel" Text="Follow" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                  <Button Classes="primary glyph bar"
                          Command="{Binding MergeIntoBranchCommand}" IsVisible="{Binding CanMergeIntoBranch}"
                          ToolTip.Tip="Merge into my branch&#10;Merge the end nodes' work into the branch you have checked out"
                          AutomationProperties.AutomationId="MergeIntoBranch"
                          AutomationProperties.Name="Merge into my branch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
                      <TextBlock Classes="label" Text="Merge into my branch" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Panel VerticalAlignment="Center">
                    <TextBlock Classes="barText barLong" Text="{Binding BarProgress}" AutomationProperties.AutomationId="RunStatus" />
                    <TextBlock Classes="barText barShort" Text="{Binding BarShort}" AutomationProperties.AutomationId="RunStatusShort" />
                  </Panel>
                  <ItemsControl ItemsSource="{Binding BarChips}" VerticalAlignment="Center" AutomationProperties.AutomationId="RunChips">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="canvas:StateChip">
                        <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding Label}"
                                    AutomationProperties.AutomationId="RunChip" AutomationProperties.Name="{Binding Label}">
                          <Panel Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Classes="badgeDisc" theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
                            <PathIcon Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                                      theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
                          </Panel>
                          <TextBlock Classes="barText" Text="{Binding Count}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>
        </UserControl>
      </StackPanel>

      <Border x:Name="MinimapPanel" Classes="floating" canvas:CanvasBottomBar.Slot="Trailing" Width="160" Height="120" IsVisible="False">
        <Border>
          <nodify:Minimap x:Name="Minimap"
                          ItemsSource="{Binding Converter={x:Static canvas:MinimapItems.Of}}"
                          ViewportLocation="{Binding ViewportLocation}"
                          ViewportSize="{Binding #Editor.ViewportSize}"
                          ViewportStyle="{StaticResource MinimapViewportTheme}"
                          ResizeToViewport="True"
                          AutomationProperties.AutomationId="Minimap"
                          AutomationProperties.Name="Minimap">
            <!-- An item is a small card in its state's fill, as a card is at the Block tier. A proposal's ghost card is a faint
                 fill in a dashed ring of its kind, as on the canvas. -->
            <nodify:Minimap.DataTemplates>
              <DataTemplate DataType="canvas:TaskNodeViewModel">
                <Border Classes="minimapItem stateBlock" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
              </DataTemplate>
              <DataTemplate DataType="canvas:GhostCardViewModel">
                <Panel>
                  <Border Classes="minimapItem ghost" theme:StyleClass.Kind="{Binding Kind}" />
                  <Rectangle Classes="minimapRing kindStroke" theme:StyleClass.Kind="{Binding Kind}" />
                </Panel>
              </DataTemplate>
            </nodify:Minimap.DataTemplates>
            <nodify:Minimap.ItemContainerTheme>
              <!-- The items are cards and ghost cards, two types that each have a Location, so the binding finds it by name. -->
              <ControlTheme TargetType="nodify:MinimapItem"
                            BasedOn="{StaticResource {x:Type nodify:MinimapItem}}">
                <Setter Property="Location" Value="{ReflectionBinding Location, Mode=OneWay}" />
                <Setter Property="Width" Value="{x:Static canvas:WorkflowCanvasViewModel.TaskCardWidth}" />
                <Setter Property="Height" Value="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}" />
              </ControlTheme>
            </nodify:Minimap.ItemContainerTheme>
          </nodify:Minimap>
        </Border>
      </Border>
    </canvas:CanvasBottomBar>
  </Panel>
</UserControl>
