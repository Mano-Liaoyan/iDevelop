<!-- The canvas's own styles. Kinds.axaml paints the kind, state, and role classes. Styles here are nearer the canvas's
     elements, so they win over Kinds.axaml where both set a property, which is why the neutral rules here exclude the
     kind classes they would otherwise hide. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:IDevelop.Desktop.Canvas"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:theme="using:IDevelop.Desktop.Theme">
  <!-- One neutral ring, 3 px outside the card, says selected. It leaves blue to Running. -->
  <Style Selector="Border.ring">
    <Setter Property="Margin" Value="7,-3" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="nodify|ItemContainer:selected:null-previewing-selection Border.ring">
    <Setter Property="BorderBrush" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="nodify|ItemContainer:previewing-selection Border.ring">
    <Setter Property="BorderBrush" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- A card is 240 wide in its 260 wide container, and an expanded card 320 in 340 (ADR 0024). An expanded card's state
       tint stays on its header, so its details read on the card's own surface. -->
  <Style Selector="Panel.taskCard">
    <Setter Property="Width" Value="260" />
    <Setter Property="MinHeight" Value="64" />
  </Style>
  <Style Selector="Panel.taskCard.expanded">
    <Setter Property="Width" Value="340" />
  </Style>
  <Style Selector="Panel.taskCard Border.stateTint">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.cardBand">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
  </Style>
  <Style Selector="Border.bandHover">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
    <Setter Property="Background" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="nodify|ItemContainer:pointerover Border.bandHover">
    <Setter Property="Opacity" Value="0.04" />
  </Style>
  <Style Selector="Panel.taskCard.expanded Border.stateTint">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
  </Style>
  <!-- The card's disclosure: a 24 px target drawn in the 12 px column, right while collapsed and down while expanded,
       as the sidebar's rows show theirs. -->
  <Style Selector="ToggleButton.cardChevron">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cardChevron:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cardChevron:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cardChevron:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron:checked PathIcon">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource NodeShadow}" />
  </Style>
  <Style Selector="nodify|ItemContainer:pointerover Border.card">
    <Setter Property="BoxShadow" Value="{DynamicResource NodeHoverShadow}" />
  </Style>

  <!-- A zoomed out card. A collapsed card gives up its zones and an expanded card stays in the Full tier, so that it can be used. -->
  <Style Selector="Grid.cardFar, Border.cardFarTint, Border.cardBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).tier-compact Panel.taskCard:not(.expanded) Grid.cardFull, :is(Control).tier-label Panel.taskCard:not(.expanded) Grid.cardFull, :is(Control).tier-block Panel.taskCard:not(.expanded) Grid.cardFull">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).tier-compact Panel.taskCard:not(.expanded) Grid.cardFar, :is(Control).tier-label Panel.taskCard:not(.expanded) Grid.cardFar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).tier-block Panel.taskCard:not(.expanded) Border.cardBlock">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).tier-label Panel.taskCard:not(.expanded) Border.cardFarTint.state-idle, :is(Control).tier-label Panel.taskCard:not(.expanded) Border.cardFarTint.state-completed">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TextBlock.farTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector=":is(Control).tier-label TextBlock.farTitle">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LineHeight" Value="30" />
  </Style>
  <Style Selector=":is(Control).tier-label theme|KindTile.farTile">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="PathIcon.farGlyph">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <!-- A selection ring and a wire keep their weight on screen as the cards shrink. -->
  <Style Selector=":is(Control).tier-label Border.ring">
    <Setter Property="Margin" Value="4,-6" />
    <Setter Property="BorderThickness" Value="4" />
  </Style>
  <Style Selector=":is(Control).tier-block Border.ring">
    <Setter Property="Margin" Value="0,-10" />
    <Setter Property="BorderThickness" Value="8" />
  </Style>
  <!-- A ghost's surface is opaque: a fill's ghost covers the empty card it fills, whose subtitle and glyph would otherwise
       show through it (#85). Its dashed edge and faded tile say it is a proposal. -->
  <Style Selector="Border.ghost">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>
  <!-- A ghost's three text lines, 18 + 16 + 16 px, sit 7 px from the card's top and bottom edges. -->
  <Style Selector="StackPanel.cardText">
    <Setter Property="Margin" Value="0,7,0,0" />
  </Style>
  <!-- Why a ghost's agent falls back: a tab that hangs from the card's bottom edge, inset by the card's corner radius on
       both sides, so its edges line up with the card's straight edge. -->
  <Style Selector="Border.ghostNote">
    <Setter Property="Margin" Value="24,-1,24,0" />
    <Setter Property="Padding" Value="8,3,8,4" />
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>
  <Style Selector="Border.ghostNote PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource StateWarningStrongBrush}" />
  </Style>
  <Style Selector="Border.ghostNote TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- The box is its font's line plus a 1 px border at the top and bottom, so no font loses its descenders. The -5 left
       and -1 top margins cancel the border and the 4 px padding, so the text sits where the title drew it. With the -6
       bottom margin the box takes 5 px less than its line, so the row keeps the 18 px of its Panel's MinHeight for any line
       up to 23 px, and a taller box reaches into the empty top of the subtitle's row. -->
  <Style Selector="TextBox.cardTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="-5,-1,0,-6" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.cardAgent, TextBlock.cardStatus, TextBlock.cardIdle, TextBlock.cardModel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="16" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.cardStatus, TextBlock.cardIdle">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.cardIdle">
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="TextBlock.cardStatus.state-running">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.cardStatus.state-failed">
    <Setter Property="Foreground" Value="{DynamicResource DestructiveTextBrush}" />
  </Style>
  <Style Selector="TextBlock.cardStatus.state-inputrequired, TextBlock.cardStatus.state-stale">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Ellipse.portDot">
    <Setter Property="StrokeThickness" Value="0" />
  </Style>
  <!-- A port's ring is neutral until a connection uses it. Then Kinds.axaml paints it in its node's kind. -->
  <Style Selector="Ellipse.port:not(.kindStroke)">
    <Setter Property="Stroke" Value="{DynamicResource Border100Brush}" />
  </Style>

  <!-- Nodify's own rule that draws connections below the cards never matches its internal host type. -->
  <Style Selector="nodify|NodifyEditor /template/ :is(Control)#PART_ConnectionsHost">
    <Setter Property="ZIndex" Value="-1" />
  </Style>
  <Style Selector="nodify|StepConnection">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Opacity" Value="1" />
    <!-- A routed wire ignores the spacing. WireRouting.Stub is the spacing plus the offset, one value for both ends, so
         a change to the spacing or to both offsets needs the same change in Stub. -->
    <Setter Property="Spacing" Value="20" />
    <Setter Property="CornerRadius" Value="8" />
    <!-- Half a handle's width, so each end meets the edge of its 10 px handle. -->
    <Setter Property="SourceOffset" Value="5,0" />
    <Setter Property="TargetOffset" Value="5,0" />
    <Setter Property="ArrowSize" Value="9,9" />
    <!-- An invisible solid outline gives the pointer a 12 px target around the line, gaps in a dash included. -->
    <Setter Property="OutlineBrush" Value="Transparent" />
    <Setter Property="OutlineThickness" Value="5" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="StrokeThickness" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <!-- A wire's stroke and arrow take its source node's kind. Nodify's connections are not Avalonia shapes, so Kinds.axaml's
       shape rules miss them. -->
  <Style Selector=":is(nodify|BaseConnection).kind-implement">
    <Setter Property="Stroke" Value="{DynamicResource KindImplementStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindImplementStrokeBrush}" />
  </Style>
  <Style Selector=":is(nodify|BaseConnection).kind-plan">
    <Setter Property="Stroke" Value="{DynamicResource KindPlanStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindPlanStrokeBrush}" />
  </Style>
  <Style Selector=":is(nodify|BaseConnection).kind-architect">
    <Setter Property="Stroke" Value="{DynamicResource KindArchitectStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindArchitectStrokeBrush}" />
  </Style>
  <Style Selector=":is(nodify|BaseConnection).kind-review">
    <Setter Property="Stroke" Value="{DynamicResource KindReviewStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindReviewStrokeBrush}" />
  </Style>
  <Style Selector=":is(nodify|BaseConnection).kind-approval">
    <Setter Property="Stroke" Value="{DynamicResource KindApprovalStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindApprovalStrokeBrush}" />
  </Style>
  <Style Selector=":is(nodify|BaseConnection).kind-merge">
    <Setter Property="Stroke" Value="{DynamicResource KindMergeStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindMergeStrokeBrush}" />
  </Style>
  <Style Selector=":is(nodify|BaseConnection).kind-readonlyagent">
    <Setter Property="Stroke" Value="{DynamicResource KindReadOnlyAgentStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource KindReadOnlyAgentStrokeBrush}" />
  </Style>
  <!-- A wire's flow sets its weight, opacity, and motion, and its hue stays its source kind's unless it reports a problem.
       The stroke comes from the wire's view model, because the flow, the selection, and the zoom tier all set it. An opacity
       keeps a wire's contrast with the canvas at 3:1 or more in both themes, so the lit path shows by weight and by motion. -->
  <Style Selector="nodify|StepConnection.wire">
    <Setter Property="StrokeThickness" Value="{ReflectionBinding Stroke}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.flow-delivered, nodify|StepConnection.wire.flow-feeding, nodify|StepConnection.wire.flow-outdated">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.flow-ready">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.flow-outdated">
    <Setter Property="Stroke" Value="{DynamicResource StateWarningStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource StateWarningStrokeBrush}" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.flow-stopped">
    <Setter Property="Stroke" Value="{DynamicResource StateFailedStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource StateFailedStrokeBrush}" />
  </Style>
  <!-- Moving arrows follow the wire's corners and mean a node reads this result now. Dashes mean context, so nothing dashes here. -->
  <Style Selector="nodify|StepConnection.wire.flow-feeding">
    <Setter Property="DirectionalArrowsCount" Value="3" />
    <Setter Property="IsAnimatingDirectionalArrows" Value="True" />
    <Setter Property="DirectionalArrowsAnimationDuration" Value="1.2" />
  </Style>
  <Style Selector="nodify|StepConnection.context">
    <Setter Property="StrokeDashArray" Value="4,3" />
  </Style>
  <!-- Every proposed connection is dashed, so a proposed context connection is dotted to stay apart from a proposed
       dependency. -->
  <Style Selector="nodify|StepConnection.ghost">
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="ArrowSize" Value="7,7" />
  </Style>
  <Style Selector="nodify|StepConnection.ghost.context">
    <Setter Property="StrokeDashArray" Value="1,3" />
  </Style>
  <!-- The line Nodify's pending connection draws while a wire is dragged. -->
  <Style Selector="nodify|LineConnection.dangling">
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeDashArray" Value="4,4" />
    <Setter Property="Spacing" Value="0" />
    <Setter Property="ArrowSize" Value="0,0" />
    <Setter Property="SourceOffsetMode" Value="None" />
    <Setter Property="TargetOffsetMode" Value="None" />
  </Style>
  <Style Selector="nodify|StepConnection.wire:pointerover">
    <Setter Property="StrokeThickness" Value="{ReflectionBinding HotStroke}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="nodify|StepConnection.wire[(nodify|BaseConnection.IsSelected)=true]">
    <Setter Property="StrokeThickness" Value="{ReflectionBinding HotStroke}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-implement">
    <Setter Property="Stroke" Value="{DynamicResource KindImplementStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-plan">
    <Setter Property="Stroke" Value="{DynamicResource KindPlanStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-architect">
    <Setter Property="Stroke" Value="{DynamicResource KindArchitectStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-review">
    <Setter Property="Stroke" Value="{DynamicResource KindReviewStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-approval">
    <Setter Property="Stroke" Value="{DynamicResource KindApprovalStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-merge">
    <Setter Property="Stroke" Value="{DynamicResource KindMergeStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.kind-readonlyagent">
    <Setter Property="Stroke" Value="{DynamicResource KindReadOnlyAgentStrokeBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.rejected">
    <Setter Property="Stroke" Value="{DynamicResource StateFailedStrokeBrush}" />
  </Style>

  <!-- Nodify draws the viewport over the items, and this viewport is opaque. -->
  <Style Selector="nodify|Minimap /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="nodify|MinimapItem">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- An item is a card in canvas units, which the minimap draws about eight times smaller. It takes its state's fill, as a
       card does at the Block tier. A ghost is a faint fill in a dashed ring. -->
  <Style Selector="Border.minimapItem">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>
  <Style Selector="Border.minimapItem.ghost">
    <Setter Property="Opacity" Value="0.3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Rectangle.minimapRing">
    <Setter Property="StrokeThickness" Value="16" />
    <Setter Property="StrokeDashArray" Value="2,1.5" />
    <Setter Property="RadiusX" Value="10" />
    <Setter Property="RadiusY" Value="10" />
  </Style>

  <!-- The zoom panel's buttons are 28 by 28, with no lines between them. -->
  <Style Selector="Button.zoom, ToggleButton.zoom">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.zoom /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.zoom:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.zoom:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.zoomValue">
    <Setter Property="Width" Value="56" />
  </Style>
  <Style Selector="Button.zoomValue TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- The run bar. All of it centres on one 40 px line. -->
  <Style Selector="TextBlock.barText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.barShort">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).narrowBar TextBlock.barShort">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).narrowBar TextBlock.barLong">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).shortBar Button.stopAll">
    <Setter Property="Width" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Control).shortBar Button.stopAll TextBlock.label">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.bar, ToggleButton.bar">
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <Style Selector="ToggleButton.follow">
    <Setter Property="Width" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.follow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.follow:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.follow:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
</Styles>
