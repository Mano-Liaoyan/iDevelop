<!-- The canvas's own styles. Kinds.axaml paints the kind, state, and role classes. Styles here are nearer the canvas's
     elements, so they win over Kinds.axaml where both set a property, which is why the neutral rules here exclude the
     kind classes they would otherwise hide. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:IDevelop.Desktop.Canvas"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:theme="using:IDevelop.Desktop.Theme">
  <!-- One neutral line on the card's edge says selected, and it leaves the state's own edge visible inside it. The keyboard's
       ring, the app's one focus ring, sits outside it while the canvas has the keyboard's focus. -->
  <Style Selector="Border.ring">
    <Setter Property="Margin" Value="9,-1" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="nodify|ItemContainer:selected:null-previewing-selection Border.ring">
    <Setter Property="BorderBrush" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="nodify|ItemContainer:previewing-selection Border.ring">
    <Setter Property="BorderBrush" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Border.keyRing">
    <Setter Property="Margin" Value="7,-3" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(Control).keyboardFocus nodify|ItemContainer:selected Border.keyRing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- A card is 240 wide in its 260 wide container, and an expanded card 320 in 340 (ADR 0024). An expanded card's state
       tint stays on its header, so its details read on the card's own surface. -->
  <Style Selector="Panel.taskCard">
    <Setter Property="Width" Value="260" />
    <Setter Property="MinHeight" Value="64" />
  </Style>
  <Style Selector="Panel.taskCard.expanded">
    <Setter Property="Width" Value="340" />
  </Style>
  <Style Selector="Panel.cardHead">
    <Setter Property="Height" Value="64" />
  </Style>
  <Style Selector="Panel.taskCard Border.stateTint">
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The tint fills the taller zoomed out card too. -->
  <Style Selector=":is(Control).tier-detail Panel.taskCard:not(.expanded) Border.stateTint, :is(Control).tier-compact Panel.taskCard:not(.expanded) Border.stateTint, :is(Control).tier-label Panel.taskCard:not(.expanded) Border.stateTint, :is(Control).tier-title Panel.taskCard:not(.expanded) Border.stateTint">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.cardBand">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
  </Style>
  <!-- The pointer over a card lifts its surface a little, and only a selection draws a line. -->
  <Style Selector="Border.cardHover">
    <Setter Property="Background" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="nodify|ItemContainer:pointerover Border.cardHover">
    <Setter Property="Opacity" Value="0.05" />
  </Style>
  <Style Selector="Panel.taskCard.expanded Border.stateTint">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
  </Style>
  <!-- The card's disclosure: a 24 px target drawn in the 12 px column, right while collapsed and down while expanded,
       as the sidebar's rows show theirs. -->
  <Style Selector="ToggleButton.cardChevron">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cardChevron:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cardChevron:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cardChevron:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.cardChevron:checked PathIcon">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource NodeShadow}" />
  </Style>
  <!-- A selected card takes the fill of the left area's selected row, and the neutral line keeps it apart from a running card's blue. -->
  <Style Selector="nodify|ItemContainer:selected Border.stateTint">
    <Setter Property="Background" Value="{DynamicResource StateSelectedSurfaceBrush}" />
  </Style>
  <Style Selector="nodify|ItemContainer:pointerover Border.card">
    <Setter Property="BoxShadow" Value="{DynamicResource NodeHoverShadow}" />
  </Style>

  <!-- A zoomed out card. A collapsed card gives up its zones and an expanded card stays in the Full tier, so that it can be used.
       Each tier sets its stripe, title, badge, and edge in canvas units, so they stay near one size on screen. -->
  <Style Selector=":is(Control).cardFar, Border.cardEdgeClip, Border.cardBlock, Panel.stateBadge">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).tier-detail Panel.taskCard:not(.expanded) Grid.cardFull, :is(Control).tier-compact Panel.taskCard:not(.expanded) Grid.cardFull, :is(Control).tier-label Panel.taskCard:not(.expanded) Grid.cardFull, :is(Control).tier-title Panel.taskCard:not(.expanded) Grid.cardFull, :is(Control).tier-block Panel.taskCard:not(.expanded) Grid.cardFull">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).tier-detail Panel.taskCard:not(.expanded) :is(Control).cardFar, :is(Control).tier-compact Panel.taskCard:not(.expanded) :is(Control).cardFar, :is(Control).tier-label Panel.taskCard:not(.expanded) :is(Control).cardFar, :is(Control).tier-title Panel.taskCard:not(.expanded) :is(Control).cardFar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).tier-detail Panel.taskCard:not(.expanded) Border.cardEdgeClip, :is(Control).tier-compact Panel.taskCard:not(.expanded) Border.cardEdgeClip, :is(Control).tier-label Panel.taskCard:not(.expanded) Border.cardEdgeClip, :is(Control).tier-title Panel.taskCard:not(.expanded) Border.cardEdgeClip">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).tier-detail Panel.taskCard:not(.expanded) Panel.stateBadge, :is(Control).tier-compact Panel.taskCard:not(.expanded) Panel.stateBadge, :is(Control).tier-label Panel.taskCard:not(.expanded) Panel.stateBadge, :is(Control).tier-title Panel.taskCard:not(.expanded) Panel.stateBadge, :is(Control).tier-block Panel.taskCard:not(.expanded) Panel.stateBadge">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).tier-block Panel.taskCard:not(.expanded) Border.cardBlock">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.cardEdge">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Width" Value="5" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.cardEdge">
    <Setter Property="Width" Value="8" />
  </Style>
  <Style Selector=":is(Control).tier-title Border.cardEdge">
    <Setter Property="Width" Value="16" />
  </Style>
  <!-- The title has the card's whole width, and the last line's height comes on top of the card's 64 px. Each tier sets both in
       canvas units, so the text stays at least 10 px on screen. -->
  <Style Selector="TextBlock.farTitle">
    <Setter Property="Margin" Value="16,0,10,0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector=":is(Control).tier-compact TextBlock.farTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
  </Style>
  <Style Selector=":is(Control).tier-label TextBlock.farTitle">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="31" />
  </Style>
  <Style Selector=":is(Control).tier-title TextBlock.farTitle">
    <Setter Property="Margin" Value="26,0,6,0" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="LineHeight" Value="52" />
  </Style>
  <!-- A ghost keeps a card's form at each zoom: its three lines close up, and far out only its title shows, as large as a card's. -->
  <Style Selector="TextBlock.ghostFar">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).tier-detail TextBlock.ghostFar, :is(Control).tier-compact TextBlock.ghostFar, :is(Control).tier-label TextBlock.ghostFar, :is(Control).tier-title TextBlock.ghostFar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).tier-detail Grid.ghostFull, :is(Control).tier-compact Grid.ghostFull, :is(Control).tier-label Grid.ghostFull, :is(Control).tier-title Grid.ghostFull, :is(Control).tier-block Grid.ghostFull">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.cardBody">
    <Setter Property="MinHeight" Value="64" />
  </Style>
  <Style Selector=":is(Control).tier-detail Panel.taskCard:not(.expanded) Panel.cardBody">
    <Setter Property="MinHeight" Value="90" />
    <Setter Property="Margin" Value="0,0,0,-26" />
  </Style>
  <Style Selector=":is(Control).tier-compact Panel.taskCard:not(.expanded) Panel.cardBody">
    <Setter Property="MinHeight" Value="94" />
    <Setter Property="Margin" Value="0,0,0,-30" />
  </Style>
  <Style Selector=":is(Control).tier-label Panel.taskCard:not(.expanded) Panel.cardBody">
    <Setter Property="MinHeight" Value="102" />
    <Setter Property="Margin" Value="0,0,0,-38" />
  </Style>
  <!-- Under a zoom of 0.36 the second line of the title takes the last line's place, and the badge sits above the card. -->
  <Style Selector=":is(Control).tier-title Panel.taskCard:not(.expanded) Panel.cardBody">
    <Setter Property="MinHeight" Value="112" />
    <Setter Property="Margin" Value="0,0,0,-48" />
  </Style>
  <Style Selector=":is(Control).tier-title Panel.taskCard:not(.expanded) Panel.cardHead">
    <Setter Property="Height" Value="112" />
  </Style>
  <Style Selector="DockPanel.farLine">
    <Setter Property="Margin" Value="20,62,36,0" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector=":is(Control).tier-compact DockPanel.farLine">
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="20,62,40,0" />
  </Style>
  <Style Selector=":is(Control).tier-label DockPanel.farLine">
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="18,64,46,0" />
  </Style>
  <Style Selector=":is(Control).tier-title DockPanel.farLine">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="theme|KindTile.farTile">
    <Setter Property="TileSize" Value="20" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector=":is(Control).tier-compact theme|KindTile.farTile">
    <Setter Property="TileSize" Value="22" />
  </Style>
  <Style Selector=":is(Control).tier-label theme|KindTile.farTile">
    <Setter Property="TileSize" Value="26" />
  </Style>
  <Style Selector="TextBlock.farAgent">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector=":is(Control).tier-compact TextBlock.farAgent">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector=":is(Control).tier-label TextBlock.farAgent">
    <Setter Property="FontSize" Value="28" />
  </Style>
  <Style Selector="TextBlock.farAgent.state-running">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.farAgent.state-failed">
    <Setter Property="Foreground" Value="{DynamicResource DestructiveTextBrush}" />
  </Style>
  <!-- The badge ends the last line in the two tiers with one, sits fully above the card where the title takes the card's height,
       and centres on the corner of the Block tier's card, which has no text. -->
  <Style Selector="Panel.stateBadge">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,62,18,0" />
  </Style>
  <Style Selector=":is(Control).tier-compact Panel.stateBadge">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,63,18,0" />
  </Style>
  <Style Selector=":is(Control).tier-label Panel.stateBadge">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,65,18,0" />
  </Style>
  <Style Selector=":is(Control).tier-title Panel.stateBadge">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="60" />
    <Setter Property="Margin" Value="0,-64,12,0" />
  </Style>
  <Style Selector=":is(Control).tier-block Panel.stateBadge">
    <Setter Property="Width" Value="80" />
    <Setter Property="Height" Value="80" />
    <Setter Property="Margin" Value="0,-40,-30,0" />
  </Style>
  <!-- A card's edge keeps its weight on screen as the cards shrink, and a node with no state keeps a visible edge. A running
       node's edge and glow stay the heaviest in every tier. -->
  <Style Selector=":is(Control).tier-detail Border.stateStroke, :is(Control).tier-compact Border.stateStroke">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.stateStroke">
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector=":is(Control).tier-title Border.stateStroke, :is(Control).tier-block Border.stateStroke">
    <Setter Property="BorderThickness" Value="5" />
  </Style>
  <Style Selector=":is(Control).tier-detail Border.stateStroke.state-running, :is(Control).tier-compact Border.stateStroke.state-running">
    <Setter Property="BorderThickness" Value="4" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.stateStroke.state-running">
    <Setter Property="BorderThickness" Value="6" />
  </Style>
  <Style Selector=":is(Control).tier-title Border.stateStroke.state-running, :is(Control).tier-block Border.stateStroke.state-running">
    <Setter Property="BorderThickness" Value="10" />
  </Style>
  <Style Selector=":is(Control).tier-detail Border.glow, :is(Control).tier-compact Border.glow">
    <Setter Property="BorderThickness" Value="6" />
    <Setter Property="Margin" Value="4,-6" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.glow">
    <Setter Property="BorderThickness" Value="10" />
    <Setter Property="Margin" Value="0,-10" />
  </Style>
  <Style Selector=":is(Control).tier-title Border.glow, :is(Control).tier-block Border.glow">
    <Setter Property="BorderThickness" Value="16" />
    <Setter Property="Margin" Value="-6,-16" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.stateStroke.state-idle, :is(Control).tier-title Border.stateStroke.state-idle, :is(Control).tier-block Border.stateStroke.state-idle,
                   :is(Control).tier-label Border.stateStroke.state-completed, :is(Control).tier-title Border.stateStroke.state-completed, :is(Control).tier-block Border.stateStroke.state-completed">
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector=":is(Control).tier-label Rectangle.staleEdge">
    <Setter Property="StrokeThickness" Value="3" />
  </Style>
  <Style Selector=":is(Control).tier-title Rectangle.staleEdge, :is(Control).tier-block Rectangle.staleEdge">
    <Setter Property="StrokeThickness" Value="5" />
  </Style>
  <!-- A selection line and a focus ring keep their weight on screen as the cards shrink. -->
  <Style Selector=":is(Control).tier-detail Border.ring, :is(Control).tier-compact Border.ring">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.ring">
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector=":is(Control).tier-title Border.ring, :is(Control).tier-block Border.ring">
    <Setter Property="BorderThickness" Value="6" />
  </Style>
  <Style Selector=":is(Control).tier-detail Border.keyRing, :is(Control).tier-compact Border.keyRing">
    <Setter Property="Margin" Value="6,-4" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector=":is(Control).tier-label Border.keyRing">
    <Setter Property="Margin" Value="2,-8" />
    <Setter Property="BorderThickness" Value="5" />
  </Style>
  <Style Selector=":is(Control).tier-title Border.keyRing, :is(Control).tier-block Border.keyRing">
    <Setter Property="Margin" Value="-4,-14" />
    <Setter Property="BorderThickness" Value="10" />
  </Style>
  <!-- A ghost's surface is opaque: a fill's ghost covers the empty card it fills, whose subtitle and glyph would otherwise
       show through it (#85). Its dashed edge and faded tile say it is a proposal. -->
  <Style Selector="Border.ghost">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>
  <!-- A ghost's three text lines, 18 + 16 + 16 px, sit 7 px from the card's top and bottom edges. -->
  <Style Selector="StackPanel.cardText">
    <Setter Property="Margin" Value="0,7,0,0" />
  </Style>
  <!-- Why a ghost's agent falls back: a tab that hangs from the card's bottom edge, inset by the card's corner radius on
       both sides, so its edges line up with the card's straight edge. -->
  <Style Selector="Border.ghostNote">
    <Setter Property="Margin" Value="24,-1,24,0" />
    <Setter Property="Padding" Value="8,3,8,4" />
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>
  <Style Selector="Border.ghostNote PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource StateWarningStrongBrush}" />
  </Style>
  <Style Selector="Border.ghostNote TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- The box is its font's line plus a 1 px border at the top and bottom, so no font loses its descenders. The -5 left
       and -1 top margins cancel the border and the 4 px padding, so the text sits where the title drew it. With the -6
       bottom margin the box takes 5 px less than its line, so the row keeps the 18 px of its Panel's MinHeight for any line
       up to 23 px, and a taller box reaches into the empty top of the subtitle's row. -->
  <Style Selector="TextBox.cardTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="-5,-1,0,-6" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.cardAgent, TextBlock.cardStatus, TextBlock.cardIdle, TextBlock.cardModel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="16" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.cardStatus, TextBlock.cardIdle, TextBlock.cardAgent">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="TextBlock.cardIdle">
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="TextBlock.cardStatus.state-running">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.cardStatus.state-failed">
    <Setter Property="Foreground" Value="{DynamicResource DestructiveTextBrush}" />
  </Style>
  <Style Selector="TextBlock.cardStatus.state-inputrequired, TextBlock.cardStatus.state-stale">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- A port keeps its size on screen as the cards shrink. -->
  <Style Selector="Ellipse.port, Ellipse.portDot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector=":is(Control).tier-detail Ellipse.port, :is(Control).tier-detail Ellipse.portDot, :is(Control).tier-compact Ellipse.port, :is(Control).tier-compact Ellipse.portDot">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector=":is(Control).tier-label Ellipse.port, :is(Control).tier-label Ellipse.portDot, :is(Control).tier-title Ellipse.port, :is(Control).tier-title Ellipse.portDot">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Ellipse.port">
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector=":is(Control).tier-label Ellipse.port, :is(Control).tier-title Ellipse.port">
    <Setter Property="StrokeThickness" Value="4" />
  </Style>
  <Style Selector="Ellipse.portDot">
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- A port's ring is faint until a connection uses it. -->
  <Style Selector="Ellipse.port">
    <Setter Property="Stroke" Value="{DynamicResource Border100Brush}" />
  </Style>
  <Style Selector="Ellipse.port.connected">
    <Setter Property="Stroke" Value="{DynamicResource TextFaintBrush}" />
  </Style>

  <!-- Nodify's own rule that draws connections below the cards never matches its internal host type. -->
  <Style Selector="nodify|NodifyEditor /template/ :is(Control)#PART_ConnectionsHost">
    <Setter Property="ZIndex" Value="-1" />
  </Style>
  <Style Selector="nodify|StepConnection">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Opacity" Value="1" />
    <!-- A routed wire ignores the spacing. WireRouting.Stub is the spacing plus the offset, one value for both ends, so
         a change to the spacing or to both offsets needs the same change in Stub. -->
    <Setter Property="Spacing" Value="20" />
    <!-- Half a handle's width, so each end meets the edge of its 10 px handle. -->
    <Setter Property="SourceOffset" Value="5,0" />
    <Setter Property="TargetOffset" Value="5,0" />
    <!-- A small arrowhead at the input says which way a wire runs. -->
    <Setter Property="ArrowSize" Value="7,6" />
    <!-- An invisible solid outline gives the pointer a 12 px target around the line, gaps in a dash included. -->
    <Setter Property="OutlineBrush" Value="Transparent" />
    <Setter Property="OutlineThickness" Value="5" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="StrokeThickness" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <!-- A wire's color shows what happens on it, never the kinds of its nodes (ADR 0045). It is quiet while it is idle or done,
       and only the wire into a running node is loud: thick, bright, glowing, and moving. The neutral brushes keep 3:1 with the
       canvas in both themes. The stroke comes from the wire's view model, because the flow, the selection, and the zoom tier
       all set it. -->
  <Style Selector="nodify|StepConnection">
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="nodify|StepConnection.wire">
    <Setter Property="StrokeThickness" Value="{ReflectionBinding Stroke}" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.highlighted">
    <Setter Property="Stroke" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="Fill" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.dimmed">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.flow-outdated">
    <Setter Property="Stroke" Value="{DynamicResource StateWarningStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource StateWarningStrokeBrush}" />
  </Style>
  <Style Selector="nodify|StepConnection.wire.flow-stopped">
    <Setter Property="Stroke" Value="{DynamicResource StateFailedStrokeBrush}" />
    <Setter Property="Fill" Value="{DynamicResource StateFailedStrokeBrush}" />
  </Style>
  <!-- Moving arrows follow the wire's curve and mean a node reads this result now. Dashes mean context, so nothing dashes here. -->
  <Style Selector="nodify|StepConnection.wire.flow-feeding">
    <Setter Property="Stroke" Value="{DynamicResource StateRunningBrush}" />
    <Setter Property="Fill" Value="{DynamicResource StateRunningBrush}" />
    <Setter Property="OutlineBrush" Value="{DynamicResource StateRunning45Brush}" />
    <Setter Property="OutlineThickness" Value="4" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="ArrowSize" Value="10,10" />
    <Setter Property="DirectionalArrowsCount" Value="3" />
    <Setter Property="IsAnimatingDirectionalArrows" Value="True" />
    <Setter Property="DirectionalArrowsAnimationDuration" Value="1.2" />
  </Style>
  <Style Selector="nodify|StepConnection.context">
    <Setter Property="StrokeDashArray" Value="4,3" />
  </Style>
  <!-- Every proposed connection is dashed, so a proposed context connection is dotted to stay apart from a proposed
       dependency. -->
  <Style Selector="nodify|StepConnection.ghost">
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="nodify|StepConnection.ghost.context">
    <Setter Property="StrokeDashArray" Value="1,3" />
  </Style>
  <!-- The line Nodify's pending connection draws while a wire is dragged. -->
  <Style Selector="nodify|LineConnection.dangling">
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeDashArray" Value="4,4" />
    <Setter Property="Spacing" Value="0" />
    <Setter Property="ArrowSize" Value="0,0" />
    <Setter Property="SourceOffsetMode" Value="None" />
    <Setter Property="TargetOffsetMode" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="nodify|StepConnection.wire:pointerover">
    <Setter Property="StrokeThickness" Value="{ReflectionBinding HotStroke}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="nodify|StepConnection.wire[(nodify|BaseConnection.IsSelected)=true]">
    <Setter Property="StrokeThickness" Value="{ReflectionBinding HotStroke}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="nodify|PendingConnection">
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="nodify|PendingConnection.rejected">
    <Setter Property="Stroke" Value="{DynamicResource StateFailedStrokeBrush}" />
  </Style>

  <!-- Nodify draws the viewport over the items, and this viewport is opaque. -->
  <Style Selector="nodify|Minimap /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="nodify|MinimapItem">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- An item is a card in canvas units, which the minimap draws about eight times smaller. It takes its state's fill, as a
       card does at the Block tier. A ghost is a faint fill in a dashed ring. -->
  <Style Selector="Border.minimapItem">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>
  <!-- A node that has not run stays visible on the map's surface, under the states that have happened. -->
  <Style Selector="Border.minimapItem.state-idle">
    <Setter Property="Background" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector="Border.minimapItem.ghost">
    <Setter Property="Opacity" Value="0.3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Rectangle.minimapRing">
    <Setter Property="StrokeThickness" Value="16" />
    <Setter Property="StrokeDashArray" Value="2,1.5" />
    <Setter Property="RadiusX" Value="10" />
    <Setter Property="RadiusY" Value="10" />
  </Style>

  <!-- The zoom panel's buttons are 28 by 28, with no lines between them. -->
  <Style Selector="Button.zoom, ToggleButton.zoom">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.zoom /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.zoom:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.zoom:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.zoomValue">
    <Setter Property="Width" Value="40" />
  </Style>
  <!-- One quiet line inside the canvas's edge, so no panel covers it and the selected card's ring stays the strongest mark. -->
  <Style Selector="Border.canvasFocus">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.zoomValue TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- The run bar. All of it centres on one 40 px line. -->
  <Style Selector="ItemsControl.barChips TextBlock.barText">
    <Setter Property="TextTrimming" Value="None" />
  </Style>
  <Style Selector="TextBlock.barText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.barShort, TextBlock.barBrief">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).shortBar TextBlock.barShort, :is(Control).narrowBar TextBlock.barBrief">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Control).shortBar TextBlock.barLong, :is(Control).narrowBar TextBlock.barShort">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).narrowBar ItemsControl.barChips">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).shortBar TextBlock.followLabel, :is(Control).narrowBar TextBlock.nextLabel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.bar, ToggleButton.bar">
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <Style Selector="ToggleButton.follow">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.follow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.follow:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.follow:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <!-- The bands along the canvas's top and bottom edges and the minimap's dock sit beside the editor, as a node editor's
       header and status bars do, on the top bar's solid surface. -->
  <Style Selector="Border.canvasBand.bottom, Border.canvasDock">
    <Setter Property="Background" Value="{DynamicResource AppTopbarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <Style Selector="Border.canvasBand.bottom">
    <Setter Property="Height" Value="44" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.canvasDock">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="8" />
  </Style>
</Styles>
