<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:canvas="using:IDevelop.Desktop.Canvas"
                    xmlns:theme="using:IDevelop.Desktop.Theme"
                    xmlns:workflows="using:IDevelop.Workflows">
  <ControlTheme x:Key="PortTheme" TargetType="nodify:Connector">
    <Setter Property="Template">
      <ControlTemplate>
        <TemplatedControl Name="PART_Connector" Width="20" Height="20" Background="{DynamicResource SurfaceRaisedBrush}">
          <TemplatedControl.Template>
            <ControlTemplate>
              <!-- The transparent panel lets the whole 20 px square take the pointer, not only the 12 px handle. -->
              <Panel Background="Transparent">
                <Ellipse Classes="port" Width="12" Height="12" StrokeThickness="2"
                         x:DataType="canvas:PortViewModel"
                         Classes.kindStroke="{Binding IsConnected}"
                         theme:StyleClass.Kind="{Binding Node.Kind}"
                         Fill="{TemplateBinding Background}" />
              </Panel>
            </ControlTemplate>
          </TemplatedControl.Template>
        </TemplatedControl>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ TemplatedControl#PART_Connector">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^.isOverElement /template/ TemplatedControl#PART_Connector">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>
  <!-- The minimap's background is PlanWeave's muted mask, and the opaque viewport is the clear window in it. -->
  <ControlTheme x:Key="MinimapViewportTheme" TargetType="Rectangle">
    <Setter Property="Fill" Value="{DynamicResource SurfaceOverlayBrush}" />
  </ControlTheme>

  <!-- The card is 240 by 64 in a 260 wide container, whose 10 px gutters hold the ports on the card's edges. Kind lives in
       the tile; state lives in the ring, the tint, the glyph, and the subtitle. The state ring, the tint, and the card are
       separate layers, because a running ring pulses and must not take the text with it. An expanded card is 320 wide
       and as tall as its details (ADR 0024). Its header stays 64 px, and the ports stay on the header's middle line, so a
       card that unfolds never moves its wires' rows. The state glyph sits on the title's line and the disclosure on the
       last line, both in the 16 px column the glyph always had, so the title keeps its width. -->
  <DataTemplate x:Key="TaskCardTemplate" DataType="canvas:TaskNodeViewModel">
    <Panel Classes="taskCard" Classes.expanded="{Binding IsExpanded}"
           canvas:CardBehaviors.ReportsSize="True"
           canvas:CardBehaviors.Peek="{Binding ShowsPeek}"
           AutomationProperties.AutomationId="TaskCard"
           AutomationProperties.Name="{Binding Title}">
      <Border Classes="card" Margin="10,0" CornerRadius="{StaticResource RadiusXl}" />
      <Border Classes="stateTint" Margin="10,0" VerticalAlignment="Top" Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}"
              IsHitTestVisible="False"
              theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
      <StackPanel Margin="10,0">
        <Grid Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}" Margin="12,0" ColumnDefinitions="32,*,16" ColumnSpacing="12">
          <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="32" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="CardKind"
                          AutomationProperties.HelpText="{Binding KindHelp}" />
          <!-- Three lines in every state: the title, the client or the status, then the model and level, which stays while a
               status shows. A line without text keeps its place, so every card's text sits the same. -->
          <StackPanel Grid.Column="1" Classes="cardText">
            <!-- The row keeps the title's height while the rename box replaces the title. -->
            <Panel MinHeight="18">
              <TextBlock Classes="cardTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !IsRenaming}"
                         AutomationProperties.AutomationId="CardTitle" />
              <canvas:CardTitleBox Classes="cardTitle" IsVisible="{Binding IsRenaming}"
                                   AutomationProperties.AutomationId="CardTitleBox"
                                   AutomationProperties.Name="Title" />
            </Panel>
            <Panel>
              <TextBlock Classes="cardAgent" Text="{Binding AgentClient}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ShowsAgent}"
                         AutomationProperties.AutomationId="CardAgent" />
              <!-- A status names what it waits for when the name fits whole, and counts it when it does not. -->
              <canvas:FittingText Classes="cardStatus" Choices="{Binding SubtitleChoices}" TextTrimming="CharacterEllipsis"
                                  IsVisible="{Binding !ShowsAgent}"
                                  AutomationProperties.AutomationId="CardStatus" />
            </Panel>
            <TextBlock Classes="cardAgent" Text="{Binding AgentModel}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="CardModel" />
          </StackPanel>
          <!-- While the task needs the person, its state glyph is a button that opens the conversation at what it needs, or,
               for an approval, selects it so the inspector shows its request. It sits on the title's line. -->
          <Panel Grid.Column="2" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.GlyphMargin}" Height="16">
            <!-- The state styles hide the glyph of some states, so the attention switch sits on a panel around it. -->
            <Panel IsVisible="{Binding !HasAttention}">
              <PathIcon Classes="stateIcon" Theme="{StaticResource Glyph}"
                        theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}"
                        AutomationProperties.AutomationId="CardStateGlyph" />
            </Panel>
            <Button Classes="attention" IsVisible="{Binding HasAttention}"
                    Command="{Binding AttendCommand}"
                    ToolTip.Tip="{Binding AttentionLabel}"
                    AutomationProperties.AutomationId="CardAttention"
                    AutomationProperties.Name="{Binding AttentionLabel}"
                    AutomationProperties.HelpText="{Binding AttendHelp}">
              <PathIcon Classes="stateIcon" Theme="{StaticResource Glyph}"
                        theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
            </Button>
          </Panel>
          <!-- The disclosure, on the last line under the glyph: a 28 px target drawn in the 16 px column. -->
          <ToggleButton Grid.Column="2" Classes="cardChevron" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.ChevronMargin}"
                        IsChecked="{Binding IsExpanded}"
                        ToolTip.Tip="{Binding ExpandName}"
                        AutomationProperties.AutomationId="CardExpand"
                        AutomationProperties.Name="{Binding ExpandName}">
            <PathIcon Theme="{StaticResource Glyph}" />
          </ToggleButton>
        </Grid>
        <canvas:CardDetail IsVisible="{Binding IsExpanded}" />
      </StackPanel>
      <!-- A review that goes on with this node marks its tile with the Review tile. -->
      <Border Classes="roleBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38.5,36.5,0,0"
              IsVisible="{Binding IsUnderReview}" ToolTip.Tip="{Binding ReviewerTip}"
              AutomationProperties.AutomationId="CardUnderReview">
        <theme:KindTile Kind="Review" TileSize="18" />
      </Border>
      <Border Classes="stateStroke" Margin="10,0" CornerRadius="{StaticResource RadiusXl}" BorderThickness="1.5" IsHitTestVisible="False"
              theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
      <!-- The selection ring lies outside the card, over the card's shadow. -->
      <Border Classes="ring" Margin="6,-4" CornerRadius="18" BorderThickness="2" IsHitTestVisible="False" />
      <!-- The ports sit on the header's middle line, 32 px down, however tall the card is. -->
      <ContentControl Content="{Binding Input}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.PortMargin}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="canvas:PortViewModel">
            <nodify:NodeInput Theme="{StaticResource PortTheme}"
                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                              IsConnected="{Binding IsConnected}"
                              AutomationProperties.Name="Task input" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl Content="{Binding Output}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.PortMargin}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="canvas:PortViewModel">
            <nodify:NodeOutput Theme="{StaticResource PortTheme}"
                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                               IsConnected="{Binding IsConnected}"
                               AutomationProperties.Name="Task output" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="ConnectionTemplate" DataType="canvas:ConnectionViewModel">
    <canvas:RoutedConnection Source="{Binding From.Output.Anchor}"
                             Target="{Binding To.Input.Anchor}"
                             Route="{Binding Route}"
                             theme:StyleClass.Kind="{Binding SourceKind}"
                             Classes.context="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                             canvas:WireLayer.IsBelow="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                             Classes.highlighted="{Binding Emphasis, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static canvas:WireEmphasis.Highlighted}}"
                             Classes.dimmed="{Binding Emphasis, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static canvas:WireEmphasis.Dimmed}}"
                             nodify:BaseConnection.IsSelectable="True" />
  </DataTemplate>

  <DataTemplate x:Key="PendingConnectionTemplate" DataType="canvas:PendingConnectionViewModel">
    <nodify:PendingConnection Source="{Binding Source, Mode=OneWayToSource}"
                              PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}"
                              EnablePreview="True"
                              Content="{Binding PreviewText}"
                              theme:StyleClass.Kind="{Binding $self.Source, Converter={x:Static canvas:PortViewModel.KindOfSource}}"
                              Classes.rejected="{Binding IsRejected}" />
  </DataTemplate>
</ResourceDictionary>
