<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:canvas="using:IDevelop.Desktop.Canvas"
                    xmlns:theme="using:IDevelop.Desktop.Theme"
                    xmlns:workflows="using:IDevelop.Workflows">
  <!-- A pin is a 10 px ring in a 20 px target. A dot fills it while the input is ready or the output holds a current result.
       A connected pin's ring takes its node's kind. -->
  <ControlTheme x:Key="PortTheme" TargetType="nodify:Connector">
    <Setter Property="Template">
      <ControlTemplate>
        <TemplatedControl Name="PART_Connector" Width="20" Height="20" Background="{DynamicResource SurfaceRaisedBrush}">
          <TemplatedControl.Template>
            <ControlTemplate>
              <!-- The transparent panel lets the whole 20 px square take the pointer, not only the 10 px handle. -->
              <Panel Background="Transparent" x:DataType="canvas:PortViewModel" ToolTip.Tip="{Binding Tip}">
                <Ellipse Classes="port" Width="10" Height="10" StrokeThickness="2"
                         Classes.kindStroke="{Binding IsConnected}"
                         theme:StyleClass.Kind="{Binding Node.Kind}"
                         Fill="{TemplateBinding Background}" />
                <Ellipse Classes="portDot kindFill" Width="10" Height="10" IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                         theme:StyleClass.Kind="{Binding Node.Kind}" />
              </Panel>
            </ControlTemplate>
          </TemplatedControl.Template>
        </TemplatedControl>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ TemplatedControl#PART_Connector">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^.isOverElement /template/ TemplatedControl#PART_Connector">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>
  <!-- The minimap's background is PlanWeave's muted mask, and the opaque viewport is the clear window in it. -->
  <ControlTheme x:Key="MinimapViewportTheme" TargetType="Rectangle">
    <Setter Property="Fill" Value="{DynamicResource SurfaceOverlayBrush}" />
  </ControlTheme>

  <!-- The card is 240 by 64 in a 260 wide container, whose 10 px gutters hold the ports on the card's edges. Three zones: the
       22 px band holds the kind's tint, the tile, the title, and the state glyph; the 20 px first line, centred on the ports,
       holds the status; and the 18 px last line holds the model and the disclosure. An expanded card is 320 wide and as tall
       as its details (ADR 0024). Its header stays 64 px and the ports stay on the same line, so a card that unfolds never
       moves its wires' rows. The state's ring, tint, and glow are separate layers, because they pulse and must not take the
       text with them.

       The canvas's zoom tier decides how much a collapsed card shows, so a title never draws under 10 px on screen. Every
       tier under the full card has one form: a stripe in the kind's hue, the title as large as the tier lets it fit, and the
       state's glyph in a badge on the card's top right corner, clear of the output port. Only the last tier gives up the title,
       for cardBlock's state fill. -->
  <DataTemplate x:Key="TaskCardTemplate" DataType="canvas:TaskNodeViewModel">
    <Panel Classes="taskCard" Classes.expanded="{Binding IsExpanded}"
           canvas:CardBehaviors.ReportsSize="True"
           canvas:CardBehaviors.Peek="{Binding ShowsPeek}"
           AutomationProperties.AutomationId="TaskCard"
           AutomationProperties.Name="{Binding Title}">
      <Border Classes="glow" Margin="6,-4" CornerRadius="14" BorderThickness="4" IsHitTestVisible="False"
              theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
      <Border Classes="card" Margin="10,0" CornerRadius="{StaticResource RadiusLg}" />
      <Border Classes="stateTint" Margin="10,0" VerticalAlignment="Top" Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}"
              IsHitTestVisible="False"
              theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
      <StackPanel Margin="10,0">
        <Panel Height="{x:Static canvas:WorkflowCanvasViewModel.TaskCardHeight}">
          <Grid Classes="cardFull" RowDefinitions="22,20,18,*">
            <Border Classes="cardBand kindTint" theme:StyleClass.Kind="{Binding Kind}" IsHitTestVisible="False">
              <Border Classes="bandHover" />
            </Border>
            <Grid Margin="8,0" ColumnDefinitions="16,*,Auto,14" ColumnSpacing="6">
              <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" KeepsBadge="True" TileSize="16" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="CardKind"
                              AutomationProperties.HelpText="{Binding KindHelp}" />
              <!-- The row keeps the title's height while the rename box replaces the title. -->
              <Panel Grid.Column="1" MinHeight="18" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsRenaming}"
                           AutomationProperties.AutomationId="CardTitle" />
                <canvas:CardTitleBox Classes="cardTitle" IsVisible="{Binding IsRenaming}"
                                     AutomationProperties.AutomationId="CardTitleBox"
                                     AutomationProperties.Name="Title" />
              </Panel>
              <!-- A review that goes on with this node marks the band with the Review tile. -->
              <Panel Grid.Column="2" IsVisible="{Binding IsUnderReview}" ToolTip.Tip="{Binding ReviewerTip}"
                     AutomationProperties.AutomationId="CardUnderReview">
                <theme:KindTile Kind="Review" TileSize="14" VerticalAlignment="Center" />
              </Panel>
              <!-- While the task needs the person, its state glyph is a button that opens the conversation at what it needs,
                   or, for an approval, selects it so the inspector shows its request. The state styles hide the glyph of
                   some states, so the attention switch sits on a panel around it. -->
              <Panel Grid.Column="3" Height="14" VerticalAlignment="Center">
                <Panel IsVisible="{Binding !HasAttention}">
                  <PathIcon Classes="stateIcon" Theme="{StaticResource Glyph}" Width="14" Height="14"
                            theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}"
                            theme:StyleClass.Why="{Binding WaitReason}"
                            AutomationProperties.AutomationId="CardStateGlyph" />
                </Panel>
                <Button Classes="attention" Margin="{x:Static canvas:CardBehaviors.GlyphMargin}" IsVisible="{Binding HasAttention}"
                        Command="{Binding AttendCommand}"
                        ToolTip.Tip="{Binding AttentionLabel}"
                        AutomationProperties.AutomationId="CardAttention"
                        AutomationProperties.Name="{Binding AttentionLabel}"
                        AutomationProperties.HelpText="{Binding AttendHelp}">
                  <PathIcon Classes="stateIcon" Theme="{StaticResource Glyph}" Width="14" Height="14"
                            theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}"
                            theme:StyleClass.Why="{Binding WaitReason}" />
                </Button>
              </Panel>
            </Grid>
            <!-- One meaning for the line: the node's status, and while it is idle, the client that will run it. -->
            <Panel Grid.Row="1" Margin="10,0">
              <DockPanel IsVisible="{Binding ShowsAgent}">
                <TextBlock DockPanel.Dock="Left" Classes="cardIdle" Text="Idle ·" />
                <TextBlock Classes="cardAgent" Text="{Binding AgentClient}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="CardAgent" />
              </DockPanel>
              <!-- A status names what it waits for when the name fits whole, and counts it when it does not. -->
              <canvas:FittingText Classes="cardStatus" Choices="{Binding SubtitleChoices}" TextTrimming="CharacterEllipsis"
                                  IsVisible="{Binding !ShowsAgent}" theme:StyleClass.State="{Binding State}"
                                  AutomationProperties.AutomationId="CardStatus" />
            </Panel>
            <Grid Grid.Row="2" Margin="10,0,8,0" ColumnDefinitions="*,12">
              <TextBlock Classes="cardModel" Text="{Binding AgentModel}" TextTrimming="CharacterEllipsis"
                         AutomationProperties.AutomationId="CardModel" />
              <!-- The disclosure: a 24 px target drawn in the 12 px column. -->
              <ToggleButton Grid.Column="1" Classes="cardChevron" Margin="{x:Static canvas:CardBehaviors.ChevronMargin}"
                            IsChecked="{Binding IsExpanded}"
                            ToolTip.Tip="{Binding ExpandName}"
                            AutomationProperties.AutomationId="CardExpand"
                            AutomationProperties.Name="{Binding ExpandName}">
                <PathIcon Theme="{StaticResource Glyph}" />
              </ToggleButton>
            </Grid>
          </Grid>
          <!-- The zoomed out card. Only Label takes the kind's tint over all of the card, for an idle or a completed node. -->
          <Border Classes="cardFarTint kindTint" CornerRadius="{StaticResource RadiusLg}" theme:StyleClass.Kind="{Binding Kind}"
                  theme:StyleClass.State="{Binding State}" IsHitTestVisible="False" />
          <Border Classes="cardEdge kindTile" theme:StyleClass.Kind="{Binding Kind}" IsHitTestVisible="False" />
          <theme:EllipsisText Classes="cardFar farTitle" Whole="{Binding Title}" IsHitTestVisible="False"
                              AutomationProperties.AccessibilityView="Raw" />
          <Border Classes="cardBlock stateBlock" CornerRadius="{StaticResource RadiusLg}" IsHitTestVisible="False"
                  theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
        </Panel>
        <canvas:CardDetail IsVisible="{Binding IsExpanded}" />
      </StackPanel>
      <Border Classes="stateStroke" Margin="10,0" CornerRadius="{StaticResource RadiusLg}" IsHitTestVisible="False"
              theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
      <Rectangle Classes="staleEdge" Margin="10,0" RadiusX="10" RadiusY="10" IsHitTestVisible="False"
                 theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
      <!-- The selection ring lies outside the card, over the card's shadow. -->
      <Border Classes="ring" CornerRadius="13" IsHitTestVisible="False" />
      <Panel Classes="stateBadge" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
        <Panel IsVisible="{Binding ShowsStateBadge}">
          <Ellipse Fill="{DynamicResource SurfaceRaisedBrush}" />
          <Viewbox Margin="2">
            <PathIcon Classes="stateIcon" Theme="{StaticResource Glyph}" Width="14" Height="14"
                      theme:StyleClass.Kind="{Binding Kind}" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}"
                      theme:StyleClass.Why="{Binding WaitReason}"
                      AutomationProperties.AutomationId="CardFarGlyph" />
          </Viewbox>
        </Panel>
      </Panel>
      <!-- The ports sit on the header's first line, 32 px down, however tall the card is. -->
      <ContentControl Content="{Binding Input}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.PortMargin}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="canvas:PortViewModel">
            <nodify:NodeInput Theme="{StaticResource PortTheme}"
                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                              IsConnected="{Binding IsConnected}"
                              AutomationProperties.Name="Task input" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl Content="{Binding Output}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.PortMargin}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="canvas:PortViewModel">
            <nodify:NodeOutput Theme="{StaticResource PortTheme}"
                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                               IsConnected="{Binding IsConnected}"
                               AutomationProperties.Name="Task output" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="ConnectionTemplate" DataType="canvas:ConnectionViewModel">
    <canvas:RoutedConnection Classes="wire" Source="{Binding From.Output.Anchor}"
                             Target="{Binding To.Input.Anchor}"
                             Route="{Binding Route}"
                             theme:StyleClass.Kind="{Binding SourceKind}"
                             theme:StyleClass.Flow="{Binding Flow}"
                             ToolTip.Tip="{Binding Tip}"
                             Classes.context="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                             canvas:WireLayer.IsBelow="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                             nodify:BaseConnection.IsSelectable="True" />
  </DataTemplate>

  <DataTemplate x:Key="PendingConnectionTemplate" DataType="canvas:PendingConnectionViewModel">
    <nodify:PendingConnection Source="{Binding Source, Mode=OneWayToSource}"
                              PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}"
                              EnablePreview="True"
                              Content="{Binding PreviewText}"
                              theme:StyleClass.Kind="{Binding $self.Source, Converter={x:Static canvas:PortViewModel.KindOfSource}}"
                              Classes.rejected="{Binding IsRejected}" />
  </DataTemplate>
</ResourceDictionary>
