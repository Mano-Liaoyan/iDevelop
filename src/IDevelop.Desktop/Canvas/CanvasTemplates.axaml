<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:canvas="using:IDevelop.Desktop.Canvas"
                    xmlns:theme="using:IDevelop.Desktop.Theme"
                    xmlns:workflows="using:IDevelop.Workflows">
  <!-- A pin is a 10 px ring in a 20 px target. A dot fills it while the input is ready or the output holds a current result.
       A connected pin's ring is stronger, and neither takes a color of its own, so the running wire stays the loudest line. -->
  <ControlTheme x:Key="PortTheme" TargetType="nodify:Connector">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <TemplatedControl Name="PART_Connector" Width="20" Height="20" ClipToBounds="False" Background="{DynamicResource SurfaceRaisedBrush}">
          <TemplatedControl.Template>
            <ControlTemplate>
              <!-- The transparent panel lets the whole 20 px square take the pointer, not only the 10 px handle. -->
              <Panel Background="Transparent" ClipToBounds="False" x:DataType="canvas:PortViewModel" ToolTip.Tip="{Binding Tip}">
                <Ellipse Classes="port" Classes.input="{Binding IsInput}" Classes.output="{Binding !IsInput}"
                         Classes.connected="{Binding IsConnected}"
                         Fill="{TemplateBinding Background}" />
                <Ellipse Classes="portDot" Classes.input="{Binding IsInput}" Classes.output="{Binding !IsInput}" IsVisible="{Binding IsLive}" IsHitTestVisible="False" />
              </Panel>
            </ControlTemplate>
          </TemplatedControl.Template>
        </TemplatedControl>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ TemplatedControl#PART_Connector">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^.isOverElement /template/ TemplatedControl#PART_Connector">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>
  <!-- The minimap's background is PlanWeave's muted mask, and the opaque viewport is the clear window in it. -->
  <ControlTheme x:Key="MinimapViewportTheme" TargetType="Rectangle">
    <Setter Property="Fill" Value="{DynamicResource SurfaceOverlayBrush}" />
    <!-- In canvas units, which the minimap draws about eight times smaller. -->
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="14" />
  </ControlTheme>

  <!-- The card is 240 by 64 in a 260 wide container, whose 10 px gutters hold the ports on the card's edges. Two zones: the
       42 px band holds the kind's quiet tint, the tile, the title in up to two lines, and the state badge; and the 22 px last
       line holds the status, the model, and the disclosure. An expanded card is 320 wide and as tall as its details (ADR 0024).
       Its header stays 64 px and the ports stay on the same line, so a card that unfolds never moves its wires' rows. The state's edge is a layer of its own.

       The canvas's zoom tier decides how much a collapsed card shows, so a title never draws under 10 px on screen (ADR 0045).
       Under the full card there is one zoomed out form: a stripe in the kind's hue, the title as large as the tier lets it fit,
       and a last line with the client's letter, the model and level, and the state's badge, so the badge never meets the title.
       The stripe says the kind, so a node with an agent gives the tile's place to its client's letter.
       The form takes more height than the card's 64 px without moving its neighbours or its wires: cardBody draws past the box
       that the layout sees. Only the last tier gives up the text, for cardBlock's state fill. -->
  <DataTemplate x:Key="TaskCardTemplate" DataType="canvas:TaskNodeViewModel">
    <Panel Classes="taskCard" ClipToBounds="False" Classes.expanded="{Binding IsExpanded}"
           canvas:CardBehaviors.ReportsSize="True"
           canvas:CardBehaviors.Peek="{Binding ShowsPeek}"
           AutomationProperties.AutomationId="TaskCard"
           AutomationProperties.Name="{Binding Title}">
      <Panel Classes="cardBody">
        <Border Classes="card" Margin="10,0" CornerRadius="{StaticResource RadiusLg}" />
        <Border Classes="stateTint" Margin="10,0" VerticalAlignment="Top"
                IsHitTestVisible="False"
                theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
        <Border Classes="cardBand runBand" Margin="10,0" VerticalAlignment="Top" IsVisible="{Binding IsRunningNow}" IsHitTestVisible="False" />
        <Border Classes="cardEdgeClip" Margin="10,0" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True" IsHitTestVisible="False">
          <Border Classes="cardEdge kindTile" theme:StyleClass.Kind="{Binding Kind}" />
        </Border>
        <StackPanel Margin="10,0">
          <Panel Classes="cardHead">
            <Grid Classes="cardFull" RowDefinitions="42,22,*">
              <Grid Margin="8,0" ColumnDefinitions="16,*,Auto,16" ColumnSpacing="6">
                <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" KeepsBadge="True" TileSize="16" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CardKind"
                                AutomationProperties.HelpText="{Binding KindHelp}" />
                <!-- The row keeps the title's height while the rename box replaces the title. -->
                <Panel Grid.Column="1" MinHeight="18" VerticalAlignment="Center">
                  <theme:EllipsisText Classes="cardTitle" Whole="{Binding Title}" KeepFrom="{Binding TitleKeep}"
                                      IsVisible="{Binding !IsRenaming}"
                                      AutomationProperties.AutomationId="CardTitle" />
                  <canvas:CardTitleBox Classes="cardTitle" IsVisible="{Binding IsRenaming}"
                                       AutomationProperties.AutomationId="CardTitleBox"
                                       AutomationProperties.Name="Title" />
                </Panel>
                <!-- A review that goes on with this node marks the band with the Review tile. -->
                <Panel Grid.Column="2" IsVisible="{Binding IsUnderReview}" ToolTip.Tip="{Binding ReviewerTip}"
                       AutomationProperties.AutomationId="CardUnderReview">
                  <theme:KindTile Kind="Review" TileSize="14" VerticalAlignment="Center" />
                </Panel>
                <!-- While the task needs the person, its state badge is a button that opens the conversation at what it needs,
                     or, for an approval, selects it so the inspector shows its request. The state styles hide the badge of
                     some states, so the attention switch sits on a panel around it. -->
                <Panel Grid.Column="3" Height="16" VerticalAlignment="Center">
                  <Panel IsVisible="{Binding !HasAttention}">
                    <Ellipse Classes="badgeDisc" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
                    <PathIcon Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                              theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}"
                              AutomationProperties.AutomationId="CardStateGlyph" />
                  </Panel>
                  <Button Classes="attention" Margin="{x:Static canvas:CardBehaviors.GlyphMargin}" IsVisible="{Binding HasAttention}"
                          Command="{Binding AttendCommand}"
                          ToolTip.Tip="{Binding AttentionLabel}"
                          AutomationProperties.AutomationId="CardAttention"
                          AutomationProperties.Name="{Binding AttentionLabel}"
                          AutomationProperties.HelpText="{Binding AttendHelp}">
                    <Panel Width="16" Height="16">
                      <Ellipse Classes="badgeDisc" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
                      <PathIcon Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                                theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
                    </Panel>
                  </Button>
                </Panel>
              </Grid>
              <!-- One line that keeps the agent's place in every state: its client and its model and level at the start, and the
                   node's state in a word at the end, so a card says it is an agent whatever happens to it. -->
              <Grid Grid.Row="1" Margin="10,0,8,0" ColumnDefinitions="Auto,*,Auto,12">
                <TextBlock Classes="cardAgent" Text="{Binding CardClient}" TextTrimming="CharacterEllipsis" MaxWidth="96" ToolTip.Tip="{Binding AgentClient}"
                           AutomationProperties.AutomationId="CardAgent" />
                <canvas:FittingText Grid.Column="1" Classes="cardModel" Choices="{Binding ModelLines}" TextTrimming="CharacterEllipsis"
                                    IsVisible="{Binding HasModel}" ToolTip.Tip="{Binding AgentModel}"
                                    AutomationProperties.AutomationId="CardModel" />
                <TextBlock Grid.Column="2" Classes="cardStatus" Text="{Binding CardStatus}" Margin="6,0,6,0"
                           theme:StyleClass.State="{Binding State}"
                           AutomationProperties.AutomationId="CardStatus" />
                <!-- The disclosure: a 24 px target drawn in the 12 px column. -->
                <ToggleButton Grid.Column="3" Classes="cardChevron" Margin="{x:Static canvas:CardBehaviors.ChevronMargin}"
                              IsChecked="{Binding IsExpanded}"
                              ToolTip.Tip="{Binding ExpandName}"
                              AutomationProperties.AutomationId="CardExpand"
                              AutomationProperties.Name="{Binding ExpandName}">
                  <PathIcon Theme="{StaticResource Glyph}" />
                </ToggleButton>
              </Grid>
            </Grid>
            <!-- The zoomed out card's title. -->
            <theme:EllipsisText Classes="cardFar farTitle" Whole="{Binding Title}" KeepFrom="{Binding TitleKeep}" IsHitTestVisible="False"
                                AutomationProperties.AccessibilityView="Raw" />
            <Border Classes="cardBlock stateBlock" CornerRadius="{StaticResource RadiusLg}" IsHitTestVisible="False"
                    theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
          </Panel>
          <canvas:CardDetail IsVisible="{Binding IsExpanded}" />
        </StackPanel>
        <Border Classes="stateStroke" Margin="10,0" CornerRadius="{StaticResource RadiusLg}" IsHitTestVisible="False"
                theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
        <Rectangle Classes="staleEdge" Margin="10,0" RadiusX="10" RadiusY="10" IsHitTestVisible="False"
                   theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" />
        <!-- The selection line sits a gap outside the card's edge, and the keyboard's ring outside it. -->
        <Border Classes="ring" CornerRadius="14" IsHitTestVisible="False" />
        <!-- The zoomed out card's last line, under its title, which leaves the state's badge its place at the end. -->
        <DockPanel Classes="cardFar farLine" IsHitTestVisible="False">
          <theme:KindTile Classes="farTile" DockPanel.Dock="Left" Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" VerticalAlignment="Center"
                          IsVisible="{Binding !HasClient}" />
          <Border Classes="farClient" DockPanel.Dock="Left" VerticalAlignment="Center" IsVisible="{Binding HasClient}">
            <TextBlock Text="{Binding ClientMark}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="CardClientMark" />
          </Border>
          <canvas:FittingText Classes="farAgent" Choices="{Binding CardLines}" TextTrimming="CharacterEllipsis" theme:StyleClass.State="{Binding State}"
                              AutomationProperties.AutomationId="CardLine" AutomationProperties.AccessibilityView="Raw" />
        </DockPanel>
        <!-- While the node needs the person, the zoomed out badge acts as the full card's does, because Fit rests at this form. -->
        <Panel Classes="stateBadge" HorizontalAlignment="Right" IsHitTestVisible="{Binding HasAttention}">
          <Viewbox>
            <Canvas Width="16" Height="16">
              <Ellipse Classes="badgeDisc" Width="16" Height="16" theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}" />
              <PathIcon Canvas.Left="3" Canvas.Top="3" Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                        theme:StyleClass.State="{Binding State}" theme:StyleClass.Role="{Binding Role}" theme:StyleClass.Why="{Binding WaitReason}"
                        AutomationProperties.AutomationId="CardFarGlyph" />
            </Canvas>
          </Viewbox>
          <Button Classes="attention farAttention" IsVisible="{Binding HasAttention}"
                  Command="{Binding AttendCommand}"
                  ToolTip.Tip="{Binding AttentionLabel}"
                  AutomationProperties.AutomationId="CardFarAttention"
                  AutomationProperties.Name="{Binding AttentionLabel}"
                  AutomationProperties.HelpText="{Binding AttendHelp}" />
        </Panel>
        <!-- The ports sit 32 px down, however tall the card is. -->
        <ContentControl Content="{Binding Input}" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.PortMargin}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="canvas:PortViewModel">
              <nodify:NodeInput Theme="{StaticResource PortTheme}"
                                Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                IsConnected="{Binding IsConnected}"
                                AutomationProperties.Name="Task input" />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <ContentControl Content="{Binding Output}" ClipToBounds="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{x:Static canvas:CardBehaviors.PortMargin}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="canvas:PortViewModel">
              <nodify:NodeOutput Theme="{StaticResource PortTheme}"
                                 Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                 IsConnected="{Binding IsConnected}"
                                 AutomationProperties.Name="Task output" />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Panel>
    </Panel>
  </DataTemplate>

  <!-- A group of the run bar: its state's badge and its words. "+N more" has no badge, and its tooltip names its groups. -->
  <DataTemplate x:Key="BarChipTemplate" DataType="canvas:StateChip">
    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip.Tip="{Binding Tip}"
                AutomationProperties.AutomationId="RunChip" AutomationProperties.Name="{Binding Label}">
      <Panel Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding !IsMore}">
        <Ellipse Classes="badgeDisc" theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
        <PathIcon Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                  theme:StyleClass.State="{Binding State}" theme:StyleClass.Why="{Binding Why}" />
      </Panel>
      <TextBlock Classes="barText" Text="{Binding RowText}" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="ConnectionTemplate" DataType="canvas:ConnectionViewModel">
    <canvas:RoutedConnection Classes="wire" Source="{Binding From.Output.Anchor}"
                             Target="{Binding To.Input.Anchor}"
                             Curve="{Binding Curve}"
                             theme:StyleClass.Flow="{Binding Flow}"
                             ToolTip.Tip="{Binding Tip}"
                             Classes.highlighted="{Binding IsHighlighted}"
                             Classes.dimmed="{Binding IsDimmed}"
                             Classes.context="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                             canvas:WireLayer.IsBelow="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static workflows:ConnectionKind.Context}}"
                             nodify:BaseConnection.IsSelectable="True" />
  </DataTemplate>

  <DataTemplate x:Key="PendingConnectionTemplate" DataType="canvas:PendingConnectionViewModel">
    <nodify:PendingConnection Source="{Binding Source, Mode=OneWayToSource}"
                              PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}"
                              EnablePreview="True"
                              Content="{Binding PreviewText}"
                              Classes.rejected="{Binding IsRejected}" />
  </DataTemplate>
</ResourceDictionary>
