<!-- The Add popover. It sits in the window's overlay layer, so UI Automation finds its rows under the main window and the
     canvas zoom never scales it. The view places it at its anchor and keeps it inside its bounds. -->
<Popup xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:canvas="using:IDevelop.Desktop.Canvas"
       xmlns:theme="using:IDevelop.Desktop.Theme"
       x:Class="IDevelop.Desktop.Canvas.AddNodePopover"
       x:DataType="canvas:AddNodeViewModel"
       ShouldUseOverlayLayer="True"
       IsLightDismissEnabled="True"
       OverlayDismissEventPassThrough="True"
       Placement="Custom">
  <Popup.Styles>
    <Style Selector="Button.addRow">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.addRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.addRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    </Style>
    <Style Selector="Button.addRow.highlighted /template/ ContentPresenter#PART_ContentPresenter, Button.addRow.highlighted:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.addRow.highlighted:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.addRow TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Button.addRow.highlighted TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.addRow PathIcon.actionGlyph">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.addRow.highlighted PathIcon.actionGlyph">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <!-- Derive and Edit sit on the highlighted row, over the accent fill. -->
    <Style Selector="Button.rowTool">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.rowTool:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rowTool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentFillBrush}" />
    </Style>
  </Popup.Styles>

  <!-- The margin leaves room for the shadow, which the popup's host would otherwise clip at the popover's edge. Show caps
       its height at its bounds' height less a gap at each end, and the popover takes its content's height up to that. -->
  <Border x:Name="Root" Classes="popover" Width="300" Margin="24,12,24,36"
          AutomationProperties.AutomationId="AddNodePopover"
          AutomationProperties.Name="Add a node">
    <Border.DataTemplates>
      <DataTemplate DataType="canvas:AddNodeHeader">
        <TextBlock Text="{Binding Title}" Margin="10,8,10,4" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </DataTemplate>
      <DataTemplate DataType="canvas:BlueprintRow">
        <Grid>
          <Button Classes="addRow" Classes.highlighted="{Binding IsHighlighted}"
                  Command="{Binding Command}"
                  PointerEntered="OnRowEntered"
                  AutomationProperties.AutomationId="AddNodeItem"
                  AutomationProperties.Name="{Binding AutomationName}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,52,0">
              <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="24" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Spacing="2"
                      IsVisible="{Binding IsHighlighted}">
            <Button Classes="rowTool" Command="{Binding DeriveCommand}" ToolTip.Tip="Derive a blueprint from it"
                    AutomationProperties.AutomationId="AddNodeDerive"
                    AutomationProperties.Name="{Binding DeriveName}">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" />
            </Button>
            <Button Classes="rowTool" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Edit the blueprint"
                    AutomationProperties.AutomationId="AddNodeEdit"
                    AutomationProperties.Name="{Binding EditName}">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconEdit}" />
            </Button>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate DataType="canvas:ActionRow">
        <Button Classes="addRow" Classes.highlighted="{Binding IsHighlighted}"
                Command="{Binding Command}"
                PointerEntered="OnRowEntered"
                AutomationProperties.AutomationId="AddNodeAction"
                AutomationProperties.Name="{Binding AutomationName}">
          <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
            <PathIcon Classes="actionGlyph" Theme="{StaticResource Glyph}"
                      Data="{Binding Icon, Converter={x:Static canvas:AddNodePopover.Glyph}}" />
            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="hint" Text="{Binding Hint}" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </DataTemplate>
    </Border.DataTemplates>

    <!-- Only the list scrolls. The actions below it stay in view however long the libraries grow. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
      <TextBox x:Name="Search" Classes="search" Height="32" Margin="8,8,8,4"
               Watermark="Search nodes and actions"
               Text="{Binding Query}"
               AutomationProperties.AutomationId="AddNodeSearch"
               AutomationProperties.Name="Search nodes and actions" />

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="14,4,12,4"
            IsVisible="{Binding HasConnect}">
        <TextBlock Classes="caption" Text="{Binding ConnectLabel}" VerticalAlignment="Center" />
        <theme:KindTile Grid.Column="1" Kind="{Binding ConnectNode.Kind}" IsLibrary="{Binding ConnectNode.IsLibrary}" TileSize="18"
                        VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding ConnectNode.Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                   AutomationProperties.AutomationId="AddNodeConnect" />
      </Grid>

      <ScrollViewer x:Name="List" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Items}" Margin="4,0"
                      AutomationProperties.AutomationId="AddNodeList" />
      </ScrollViewer>

      <ItemsControl x:Name="ActionRows" Grid.Row="3" ItemsSource="{Binding Actions}" Margin="4,0,4,4" />

      <Border Grid.Row="4" Padding="12,8,12,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                     MinHeight="28" Foreground="{DynamicResource TextMutedBrush}"
                     AutomationProperties.AutomationId="AddNodeDescription" />
          <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                      IsVisible="{Binding HasProblems}"
                      ToolTip.Tip="{Binding ProblemsDetail}">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStateNeedsSetup}" Width="12" Height="12"
                      Foreground="{DynamicResource StateWarningStrongBrush}" />
            <TextBlock Text="{Binding ProblemsLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       AutomationProperties.AutomationId="AddNodeProblems"
                       AutomationProperties.HelpText="{Binding ProblemsDetail}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Popup>
