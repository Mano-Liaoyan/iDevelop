<!-- The canvas's context menus. The view opens each from code with a fresh subject as its DataContext. A menu hides
     what its subject cannot do rather than dimming it. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:canvas="using:IDevelop.Desktop.Canvas"
                    xmlns:theme="using:IDevelop.Desktop.Theme">
  <ContextMenu x:Key="NodeMenu" x:DataType="canvas:NodeMenuViewModel">
    <MenuItem Header="Run" InputGesture="{x:Static canvas:CanvasKeys.Run}"
              Command="{Binding Node.RunCommand}" IsVisible="{Binding ShowRun}"
              AutomationProperties.AutomationId="NodeMenuRun">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Cancel Run"
              Command="{Binding Node.CancelCommand}" IsVisible="{Binding ShowCancel}"
              AutomationProperties.AutomationId="NodeMenuCancel">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator IsVisible="{Binding ShowRunGroup}" />
    <MenuItem Header="Rename" InputGesture="{x:Static canvas:CanvasKeys.Rename}"
              Command="{Binding RenameCommand}" IsVisible="{Binding IsSingle}"
              AutomationProperties.AutomationId="NodeMenuRename">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRename}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Duplicate" InputGesture="{x:Static canvas:CanvasKeys.Duplicate}"
              Command="{Binding DuplicateCommand}"
              AutomationProperties.AutomationId="NodeMenuDuplicate">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDuplicate}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Replace With" ItemsSource="{Binding ReplaceChoices}" IsVisible="{Binding ShowReplace}"
              AutomationProperties.AutomationId="NodeMenuReplace">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconReplace}" />
      </MenuItem.Icon>
      <MenuItem.ItemContainerTheme>
        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="canvas:ReplaceChoice">
          <Setter Property="Header" Value="{Binding Name}" />
          <Setter Property="Command" Value="{Binding Command}" />
          <Setter Property="AutomationProperties.AutomationId" Value="ReplaceWithItem" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
          <Setter Property="Icon">
            <Template>
              <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="18" />
            </Template>
          </Setter>
          <!-- The menu's icon column is 16 px, and a list's kind tile is 18. -->
          <Style Selector="^ /template/ ContentControl#PART_IconPresenter">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
          </Style>
        </ControlTheme>
      </MenuItem.ItemContainerTheme>
    </MenuItem>
    <MenuItem Header="Disconnect"
              Command="{Binding DisconnectCommand}" IsVisible="{Binding ShowDisconnect}"
              AutomationProperties.AutomationId="NodeMenuDisconnect">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDisconnect}" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator IsVisible="{Binding IsSingle}" />
    <MenuItem Header="Derive Blueprint…"
              Command="{Binding Node.DeriveCommand}" IsVisible="{Binding IsSingle}"
              AutomationProperties.AutomationId="NodeMenuDerive">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDerive}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Save as Blueprint…"
              Command="{Binding Node.SaveAsBlueprintCommand}" IsVisible="{Binding IsSingle}"
              AutomationProperties.AutomationId="NodeMenuSaveAs">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Classes="destructive" Header="Delete" InputGesture="{x:Static canvas:CanvasKeys.Delete}"
              Command="{Binding DeleteCommand}"
              AutomationProperties.AutomationId="NodeMenuDelete">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDelete}" />
      </MenuItem.Icon>
    </MenuItem>
  </ContextMenu>

  <ContextMenu x:Key="ConnectionMenu" x:DataType="canvas:ConnectionMenuViewModel">
    <MenuItem Header="Dependency" Command="{Binding DependencyCommand}"
              AutomationProperties.AutomationId="ConnectionMenuDependency">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" IsVisible="{Binding IsDependency}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Context" Command="{Binding ContextCommand}"
              AutomationProperties.AutomationId="ConnectionMenuContext">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" IsVisible="{Binding IsContext}" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Header="Insert Node…" Command="{Binding InsertCommand}"
              AutomationProperties.AutomationId="ConnectionMenuInsert">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInsert}" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Classes="destructive" Header="Delete" Command="{Binding Connection.DeleteCommand}"
              AutomationProperties.AutomationId="ConnectionMenuDelete">
      <MenuItem.Icon>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDelete}" />
      </MenuItem.Icon>
    </MenuItem>
  </ContextMenu>
</ResourceDictionary>
