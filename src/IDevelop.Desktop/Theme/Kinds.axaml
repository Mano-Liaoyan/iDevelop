<!-- Paints an element in a node kind's hue, or in its state's or role's, by the classes that StyleClass sets: kind-plan,
     state-failed, role-proposing, and so on. An element that shows a state also takes its node's kind, because a running
     node's ring, tint, and glyph are in the kind's hue. Later rules win, so the state and role rules follow the kind
     rules. No rule colors text. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.kindTile.kind-implement">
    <Setter Property="Background" Value="{DynamicResource KindImplementTileBrush}" />
  </Style>
  <Style Selector="Border.kindStroke.kind-implement, Border.stateStroke.kind-implement">
    <Setter Property="BorderBrush" Value="{DynamicResource KindImplementStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindStroke.kind-implement">
    <Setter Property="Stroke" Value="{DynamicResource KindImplementStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindFill.kind-implement">
    <Setter Property="Fill" Value="{DynamicResource KindImplementStrokeBrush}" />
  </Style>
  <Style Selector="Border.kindTint.kind-implement, Border.stateTint.kind-implement">
    <Setter Property="Background" Value="{DynamicResource KindImplement10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.kind-implement">
    <Setter Property="Foreground" Value="{DynamicResource KindImplementStrongBrush}" />
  </Style>
  <Style Selector="Border.kindTile.kind-plan">
    <Setter Property="Background" Value="{DynamicResource KindPlanTileBrush}" />
  </Style>
  <Style Selector="Border.kindStroke.kind-plan, Border.stateStroke.kind-plan">
    <Setter Property="BorderBrush" Value="{DynamicResource KindPlanStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindStroke.kind-plan">
    <Setter Property="Stroke" Value="{DynamicResource KindPlanStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindFill.kind-plan">
    <Setter Property="Fill" Value="{DynamicResource KindPlanStrokeBrush}" />
  </Style>
  <Style Selector="Border.kindTint.kind-plan, Border.stateTint.kind-plan">
    <Setter Property="Background" Value="{DynamicResource KindPlan10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.kind-plan">
    <Setter Property="Foreground" Value="{DynamicResource KindPlanStrongBrush}" />
  </Style>
  <Style Selector="Border.kindTile.kind-architect">
    <Setter Property="Background" Value="{DynamicResource KindArchitectTileBrush}" />
  </Style>
  <Style Selector="Border.kindStroke.kind-architect, Border.stateStroke.kind-architect">
    <Setter Property="BorderBrush" Value="{DynamicResource KindArchitectStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindStroke.kind-architect">
    <Setter Property="Stroke" Value="{DynamicResource KindArchitectStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindFill.kind-architect">
    <Setter Property="Fill" Value="{DynamicResource KindArchitectStrokeBrush}" />
  </Style>
  <Style Selector="Border.kindTint.kind-architect, Border.stateTint.kind-architect">
    <Setter Property="Background" Value="{DynamicResource KindArchitect10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.kind-architect">
    <Setter Property="Foreground" Value="{DynamicResource KindArchitectStrongBrush}" />
  </Style>
  <Style Selector="Border.kindTile.kind-review">
    <Setter Property="Background" Value="{DynamicResource KindReviewTileBrush}" />
  </Style>
  <Style Selector="Border.kindStroke.kind-review, Border.stateStroke.kind-review">
    <Setter Property="BorderBrush" Value="{DynamicResource KindReviewStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindStroke.kind-review">
    <Setter Property="Stroke" Value="{DynamicResource KindReviewStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindFill.kind-review">
    <Setter Property="Fill" Value="{DynamicResource KindReviewStrokeBrush}" />
  </Style>
  <Style Selector="Border.kindTint.kind-review, Border.stateTint.kind-review">
    <Setter Property="Background" Value="{DynamicResource KindReview10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.kind-review">
    <Setter Property="Foreground" Value="{DynamicResource KindReviewStrongBrush}" />
  </Style>
  <Style Selector="Border.kindTile.kind-approval">
    <Setter Property="Background" Value="{DynamicResource KindApprovalTileBrush}" />
  </Style>
  <Style Selector="Border.kindStroke.kind-approval, Border.stateStroke.kind-approval">
    <Setter Property="BorderBrush" Value="{DynamicResource KindApprovalStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindStroke.kind-approval">
    <Setter Property="Stroke" Value="{DynamicResource KindApprovalStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindFill.kind-approval">
    <Setter Property="Fill" Value="{DynamicResource KindApprovalStrokeBrush}" />
  </Style>
  <Style Selector="Border.kindTint.kind-approval, Border.stateTint.kind-approval">
    <Setter Property="Background" Value="{DynamicResource KindApproval10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.kind-approval">
    <Setter Property="Foreground" Value="{DynamicResource KindApprovalStrongBrush}" />
  </Style>
  <Style Selector="Border.kindTile.kind-readonlyagent">
    <Setter Property="Background" Value="{DynamicResource KindReadOnlyAgentTileBrush}" />
  </Style>
  <Style Selector="Border.kindStroke.kind-readonlyagent, Border.stateStroke.kind-readonlyagent">
    <Setter Property="BorderBrush" Value="{DynamicResource KindReadOnlyAgentStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindStroke.kind-readonlyagent">
    <Setter Property="Stroke" Value="{DynamicResource KindReadOnlyAgentStrokeBrush}" />
  </Style>
  <Style Selector=":is(Shape).kindFill.kind-readonlyagent">
    <Setter Property="Fill" Value="{DynamicResource KindReadOnlyAgentStrokeBrush}" />
  </Style>
  <Style Selector="Border.kindTint.kind-readonlyagent, Border.stateTint.kind-readonlyagent">
    <Setter Property="Background" Value="{DynamicResource KindReadOnlyAgent10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.kind-readonlyagent">
    <Setter Property="Foreground" Value="{DynamicResource KindReadOnlyAgentStrongBrush}" />
  </Style>

  <!-- A running, stopping, or in-review node keeps its kind's hue. Every other state has its own. -->
  <Style Selector="Border.stateStroke.state-idle, Border.stateStroke.state-needssetup">
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <Style Selector="Border.stateStroke.state-waiting">
    <Setter Property="BorderBrush" Value="{DynamicResource StateWaitingStrokeBrush}" />
  </Style>
  <Style Selector="Border.stateStroke.state-succeeded">
    <Setter Property="BorderBrush" Value="{DynamicResource StateSuccessStrokeBrush}" />
  </Style>
  <Style Selector="Border.stateStroke.state-failed">
    <Setter Property="BorderBrush" Value="{DynamicResource StateFailedStrokeBrush}" />
  </Style>
  <Style Selector="Border.stateStroke.state-interrupted">
    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningStrokeBrush}" />
  </Style>
  <Style Selector="Border.stateStroke.state-cancelled">
    <Setter Property="BorderBrush" Value="{DynamicResource StateNeutralStrokeBrush}" />
  </Style>

  <Style Selector="Border.stateTint.state-idle, Border.stateTint.state-needssetup, Border.stateTint.state-runningelsewhere, Border.stateTint.state-succeeded, Border.stateTint.state-cancelled">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.stateTint.state-waiting">
    <Setter Property="Background" Value="{DynamicResource StateWaiting10Brush}" />
  </Style>
  <Style Selector="Border.stateTint.state-failed">
    <Setter Property="Background" Value="{DynamicResource StateFailed10Brush}" />
  </Style>
  <Style Selector="Border.stateTint.state-interrupted">
    <Setter Property="Background" Value="{DynamicResource StateWarning10Brush}" />
  </Style>

  <Style Selector="PathIcon.stateIcon.state-idle">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="PathIcon.stateIcon.state-needssetup, PathIcon.stateIcon.state-interrupted">
    <Setter Property="Foreground" Value="{DynamicResource StateWarningStrongBrush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.state-waiting">
    <Setter Property="Foreground" Value="{DynamicResource StateWaitingStrongBrush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.state-succeeded">
    <Setter Property="Foreground" Value="{DynamicResource StateSuccessStrongBrush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.state-failed">
    <Setter Property="Foreground" Value="{DynamicResource StateFailedStrongBrush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.state-cancelled">
    <Setter Property="Foreground" Value="{DynamicResource StateNeutralStrongBrush}" />
  </Style>

  <!-- A planner with an open proposal takes the accent instead of its state, and does not pulse. -->
  <Style Selector="Border.stateStroke.role-proposing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}" />
  </Style>
  <Style Selector="Border.stateTint.role-proposing">
    <Setter Property="Background" Value="{DynamicResource Accent10Brush}" />
  </Style>
  <Style Selector="PathIcon.stateIcon.role-proposing">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>

  <!-- A running or waiting node's ring pulses. Tests read its class, because its pixels depend on the time. -->
  <Style Selector="Border.stateStroke.state-running:not(.role-proposing), Border.stateStroke.state-waiting:not(.role-proposing)">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="PathIcon.stateIcon.state-running:not(.role-proposing)">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
