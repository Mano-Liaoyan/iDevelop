<!-- Every Fluent geometry is drawn in a 16 unit frame. A fixed canvas keeps that frame, so each glyph keeps its drawn
     size and position, where the default PathIcon theme would stretch each geometry to fill the icon. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:IDevelop.Desktop.Theme">
  <ControlTheme x:Key="Glyph" TargetType="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox>
          <Canvas Width="16" Height="16">
            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type theme:StateBadge}" TargetType="theme:StateBadge">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox>
          <Canvas Width="16" Height="16">
            <Ellipse Classes="badgeDisc" Width="16" Height="16"
                     theme:StyleClass.State="{TemplateBinding State}" theme:StyleClass.Why="{TemplateBinding Why}" />
            <PathIcon Canvas.Left="3" Canvas.Top="3" Classes="badgeGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                      theme:StyleClass.State="{TemplateBinding State}" theme:StyleClass.Why="{TemplateBinding Why}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
