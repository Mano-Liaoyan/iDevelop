<!-- Every Fluent geometry is drawn in a 16 unit frame. A fixed canvas keeps that frame, so each glyph keeps its drawn
     size and position, where the default PathIcon theme would stretch each geometry to fill the icon. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:IDevelop.Desktop.Theme">
  <ControlTheme x:Key="Glyph" TargetType="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox>
          <Canvas Width="16" Height="16">
            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <!-- The mark is drawn in a 16 unit frame and scales to the size that its place sets. The role's dot stays 6 px at every size. -->
  <ControlTheme x:Key="{x:Type theme:StateMark}" TargetType="theme:StateMark">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Viewbox>
            <Canvas Width="16" Height="16">
              <Ellipse Classes="markDisc" Width="16" Height="16"
                       theme:StyleClass.State="{TemplateBinding State}" theme:StyleClass.Why="{TemplateBinding Why}" />
              <Arc Classes="markArc" Width="16" Height="16" StartAngle="0" SweepAngle="270"
                   theme:StyleClass.State="{TemplateBinding State}" />
              <PathIcon Canvas.Left="3" Canvas.Top="3" Classes="markGlyph" Theme="{StaticResource Glyph}" Width="10" Height="10"
                        theme:StyleClass.State="{TemplateBinding State}" theme:StyleClass.Why="{TemplateBinding Why}" />
            </Canvas>
          </Viewbox>
          <Ellipse Classes="markRole" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                   theme:StyleClass.Role="{TemplateBinding Role}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
