<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The app's one design language. Type: 11/16 for key hints, 12/16 for second lines and captions, 13/18 for rows, fields,
       buttons, and menus, 14/22 for conversation text, 14/20 semibold for titles. Spacing sits on a 4 px grid, with 2 px only
       between rows. Heights: 20 chip, 24 pill and small glyph button, 28 control, 32 toolbar and primary, 40 bar, 44 two-line
       row. Radii: 4 small tile, RadiusSm for controls, rows, and pills, RadiusMd for floating bars, menus, and popovers,
       RadiusLg for cards and the composer. Only Send is round. -->

  <!-- One focus ring on every control: 2 px of the accent over the control's own edge, on keyboard focus only. RadiusSm plus 1 px. -->
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-1" BorderThickness="2" CornerRadius="7" BorderBrush="{DynamicResource AccentBrush}" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- A row in a scrolling list would lose an outer ring to the list's clip, so its ring sits 2 px inside its edge. -->
  <Style Selector="Button.nav, Button.activity, ToggleButton.projectRow, ListBox.tasks ListBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="2" BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource AccentBrush}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- All hover and press fills fade in 120 ms, and nothing moves. -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A section label in Title Case, as the popover's and the inspector's are. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- A key hint. Nothing else uses this size. -->
  <Style Selector="TextBlock.keyHint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Border.breadcrumb">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource SmallShadow}" />
  </Style>
  <!-- A bar of two groups: each group draws the chrome, and the bar none. -->
  <Style Selector="Border.breadcrumb.split">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Border.crumbPart">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource SmallShadow}" />
  </Style>
  <!-- A shadow outside a clipped border is cut off, so floating panels clip their content in an inner border. -->
  <Style Selector="Border.floating">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource FloatingShadow}" />
  </Style>
  <Style Selector="Border.floating > Border">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Padding" Value="7,0" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A status marker. One mapping for every surface: the state's fill, its stroke, its glyph, and neutral text. State
       always has a glyph or a word as well as color. -->
  <Style Selector="Border.pill">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource StateNeutral10Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill PathIcon:not(.badgeGlyph)">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Data" Value="{StaticResource IconIdle}" />
  </Style>
  <Style Selector="Border.pill.running">
    <Setter Property="BorderBrush" Value="{DynamicResource StateRunningBrush}" />
    <Setter Property="Background" Value="{DynamicResource StateRunningSurfaceBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.pill.running PathIcon:not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconStateRunning}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="Border.pill.running PathIcon:not(.badgeGlyph), PathIcon.spin">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.pill.complete">
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.pill.complete PathIcon:not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconStateSucceeded}" />
    <Setter Property="Foreground" Value="{DynamicResource StateSuccessStrongBrush}" />
  </Style>
  <Style Selector="Border.pill.problem">
    <Setter Property="BorderBrush" Value="{DynamicResource StateFailedStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource StateFailed10Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.pill.problem PathIcon:not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconStateFailed}" />
    <Setter Property="Foreground" Value="{DynamicResource StateFailedStrongBrush}" />
  </Style>
  <Style Selector="Border.pill.waiting">
    <Setter Property="BorderBrush" Value="{DynamicResource StateWaitingStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource StateWaiting10Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.pill.waiting PathIcon:not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconStateWaiting}" />
    <Setter Property="Foreground" Value="{DynamicResource StateWaitingStrongBrush}" />
  </Style>

  <!-- A result that needs updating: the warning color the card's ring takes, with the same glyph (#90). -->
  <Style Selector="Border.pill.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource StateWarning10Brush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.pill.warning PathIcon:not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconStateOutOfDate}" />
    <Setter Property="Foreground" Value="{DynamicResource StateWarningStrongBrush}" />
  </Style>

  <Style Selector="Ellipse.status">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector="Ellipse.status.small">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>
  <Style Selector="Ellipse.status.running">
    <Setter Property="Fill" Value="{DynamicResource StateRunningBrush}" />
  </Style>
  <Style Selector="Ellipse.status.complete">
    <Setter Property="Fill" Value="{DynamicResource StateSuccessBrush}" />
  </Style>
  <Style Selector="Ellipse.status.problem">
    <Setter Property="Fill" Value="{DynamicResource StateFailedBrush}" />
  </Style>
  <Style Selector="Ellipse.status.waiting">
    <Setter Property="Fill" Value="{DynamicResource StateWaitingBrush}" />
  </Style>

  <!-- Buttons without a fill until the pointer is over them. Fluent's own state styles set the template's colors,
       so each state is restated here. -->
  <Style Selector="Button.nav, Button.icon, Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- A disabled control loses its fill and its pointer response, and its label takes the muted text color at full opacity, so
       the label still reads at 4.5:1 or more in both themes. A kind segment is disabled while it is the chosen one, so it stays whole. -->
  <Style Selector="Button:disabled:not(.segment) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- A glyph button has no label to keep legible, and an enabled one already has the muted color, so a disabled one takes the faint color. -->
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.ghost.glyph:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- A bordered button for a command on the selected item, such as Run. -->
  <Style Selector="Button.action">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- The one main command of a panel or sheet, filled with the accent under white text. -->
  <Style Selector="Button.primary">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Under the pointer the fill darkens in both themes and the label stays white: the light theme takes the darker hover
       fill, and the dark theme's slight transparency darkens the fill against its dark panel. -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="Opacity" Value="0.84" />
  </Style>
  <!-- With nothing to run, the primary action gives up the accent for the quiet fill, and its tooltip says why. -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- A command that removes something: red text on the neutral button, and a red fill under white text on hover. -->
  <Style Selector="Button.destructive">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DestructiveTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DestructiveFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DestructiveFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.destructive:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.segment, RadioButton.segment">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- A kind button is disabled while its kind is the connection's kind, so the disabled one is the chosen segment. -->
  <Style Selector="Button.segment:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource SmallShadow}" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Segment"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment.glyph">
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- The chosen segment has an edge as well as a fill, so it reads in the dark theme, where the two fills lie close. -->
  <Style Selector="RadioButton.segment /template/ Border#PART_Segment">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
    <Setter Property="BoxShadow" Value="{StaticResource SmallShadow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaintBrush}" />
  </Style>

  <Style Selector="ListBox.tasks, ListBox.results">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- A node's row is flat and has the workflow row's 26 px and type (ADR 0072). Hover and selection are its only fills, so state color stays the loudest
       thing in the list. -->
  <Style Selector="ListBox.tasks ListBoxItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,4,8,4" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.tasks ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.tasks ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ListBox.tasks ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateSelectedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ListBox.tasks ListBoxItem:selected TextBlock.rowName">
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- A group header in a workflow's node list: a quiet chevron, the group's name, and its count (ADR 0064). -->
  <!-- A group header stands one level before its node rows: a node's tile starts under the group's name, so the levels read. -->
  <Style Selector="ListBox.tasks ListBoxItem.groupRow">
    <Setter Property="Padding" Value="8,5,8,5" />
  </Style>
  <Style Selector="ListBox.tasks ListBoxItem:not(.groupRow)">
    <Setter Property="Padding" Value="26,4,8,4" />
  </Style>
  <Style Selector="PathIcon.groupChevron">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon.groupChevron.folded">
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <!-- A group is one level under a section, whose label keeps the semibold. -->
  <Style Selector="TextBlock.groupName">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A node's name shows in full and wraps, selected or not (issue 108). -->
  <Style Selector="TextBlock.nodeName">
    <Setter Property="MaxLines" Value="0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Find's list takes the panel under its box, so it cuts through no row. -->
  <Style Selector="Border.findPalette">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="{DynamicResource AppTopbarBrush}" />
  </Style>
  <!-- Find's rows have two lines. The one in the box's choice takes the row selection fill. -->
  <Style Selector="ListBox.results ListBoxItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <!-- A name's type. A row of Activity cuts its name to one line, and the row's tooltip holds all of it. A tree row shows its whole name. -->
  <Style Selector="TextBlock.rowName">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- A workflow is the tree's middle level: plain weight under its semibold project, and strong only while it is shown. -->
  <Style Selector="TextBlock.rowName.workflowName">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.rowName.workflowName.shown">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.rowName.strong">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.rowName.semibold">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption.warning">
    <Setter Property="Foreground" Value="{DynamicResource StateWarningStrongBrush}" />
  </Style>

  <!-- A project's row, the tree's top level: 26 px, with a semibold name. Its chevron folds the project. -->
  <Style Selector="ToggleButton.projectRow">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.projectRow /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.projectRow:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.projectRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.projectRow:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.projectRow:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, Panel.projectRow:pointerover ToggleButton.projectRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.projectRow PathIcon:not(.stateIcon)">
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.projectRow:checked PathIcon:not(.stateIcon)">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>
  <!-- The tab on a panel's edge. It stays at the window's edge while the panel is closed. -->
  <Style Selector="Button.panelEdge">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- A closed panel's tab names the panel, so a small window says where the panel went. -->
  <!-- An open panel's tab shows only under the pointer or the keyboard, so it never sits on the conversation's or the canvas's margin. A closed panel's tab stays, as the way back. -->
  <Style Selector="Button.panelEdge:not(.closed):not(:pointerover):not(:focus-visible) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.panelEdge.leading">
    <Setter Property="Margin" Value="6,0,-6,0" />
  </Style>
  <Style Selector="Button.panelEdge.trailing">
    <Setter Property="Margin" Value="-6,0,6,0" />
  </Style>
  <Style Selector="Button.panelEdge.closed">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="84" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TextBlock.edgeLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
  </Style>
  <Style Selector="Button.panelEdge /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Button.panelEdge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="StackPanel.counts, StackPanel.count, StackPanel.rowActions">
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>
  <Style Selector="StackPanel.counts">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="StackPanel.counts.tight">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.counts.tight StackPanel.count">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="StackPanel.count">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="StackPanel.count.tight">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="StackPanel.count > PathIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A row's actions show on hover or keyboard focus only, over the row's end, in the row's hover fill. They stay in the
       Tab order, so a keyboard reaches them. -->
  <Style Selector="StackPanel.rowActions">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,8,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Panel.projectRow:pointerover StackPanel.rowActions, StackPanel.rowActions:focus-within">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- A project's letter tile. The project on show takes the accent's tint, so the list marks it. -->
  <Style Selector="Border.projectTile">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Border.projectTile.current">
    <Setter Property="Background" Value="{DynamicResource StateSelected25Brush}" />
  </Style>
  <Style Selector="Border.projectTile > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Border.treeHead">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource AppTopbarBrush}" />
  </Style>
  <Style Selector="Border.treeCover">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource AppTopbarBrush}" />
  </Style>
  <Style Selector="Button.stickyRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.stickyRow.projectHead">
    <Setter Property="Padding" Value="34,0,16,0" />
  </Style>
  <!-- The rule over the Nodes section, with its heading. It keeps the panel's color, so the two sections read as one panel (ADR 0071). -->
  <Style Selector="Border.sectionRule">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Padding" Value="0,4,0,0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <!-- A section heading that folds its list: its label starts where the other section labels start, and its chevron ends the row where their actions end. -->
  <Style Selector="ToggleButton.sectionFold">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.sectionFold /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sectionFold:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.sectionFold:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sectionFold:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.sectionFold PathIcon:not(.stateIcon):not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.sectionFold:checked PathIcon:not(.stateIcon):not(.badgeGlyph)">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>
  <Style Selector="TextBlock.caption.reason.why-approval">
    <Setter Property="Foreground" Value="{DynamicResource StateApprovalStrokeBrush}" />
  </Style>
  <Style Selector="TextBlock.caption.reason.why-interrupted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.caption.reason.state-failed">
    <Setter Property="Foreground" Value="{DynamicResource StateFailedStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.caption.reason.state-inputrequired">
    <Setter Property="Foreground" Value="{DynamicResource StateWaitingStrongBrush}" />
  </Style>
  <Style Selector="Run.match">
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A row of the Activity list has one line. A workflow's row keeps its first line clear of its chevron, which draws over the
       row's left end. -->
  <Style Selector="Button.activity">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <Style Selector="Button.activity:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.activity:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Button.nav.workflow">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="48,4,8,4" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.nav.workflow.selected /template/ ContentPresenter#PART_ContentPresenter, Button.nav.workflow.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav.workflow.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <!-- The shown workflow is the parent of the selected node, so its row takes the quiet neutral fill, and only the node's row takes the accent fill. -->
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>

  <!-- UI Automation reads which workflow the window shows from its row's status. -->
  <Style Selector="Button.nav.workflow.selected">
    <Setter Property="AutomationProperties.ItemStatus" Value="Shown" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="ToggleButton.chevron">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.chevron /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chevron:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.chevron:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chevron:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chevron:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <!-- A pinned row's chevron folds what the row names, on the row's 28 px line. -->
  <Style Selector="ToggleButton.stickyChevron">
    <Setter Property="Height" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ToggleButton.chevron PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.chevron:checked PathIcon">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextStrongBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource StateSelected40Brush}" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="MinHeight" Value="100" />
  </Style>
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <!-- A text box's edge takes the accent on any focus, because it takes keys however it got the focus. Keyboard focus adds the
       one ring, which Fluent's text box and picker themes turn off. -->
  <!-- A box shows the focus ring's 2 px on its own edge, however the focus came, and needs no ring over it. -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-1" BorderThickness="2" CornerRadius="7" BorderBrush="{DynamicResource AccentBrush}" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- Fluent draws a placeholder at half opacity, about 1.6:1 on focus. It stays the whole muted text in every state. -->
  <Style Selector="TextBox:not(:disabled) /template/ TextBlock#PART_Watermark, TextBox:not(:disabled) /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A template gives each search box its own glyph, because one control can have only one parent. -->
  <Style Selector="TextBox.search">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="InnerLeftContent">
      <Template>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSearch}" Margin="8,0,0,0"
                  Foreground="{DynamicResource TextMutedBrush}" />
      </Template>
    </Setter>
  </Style>

  <!-- Fluent's own state styles set the template's colors, so each state is restated here. -->
  <Style Selector="ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background, ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- Keyboard focus shows as the one ring, with no fill of Fluent's that reads as selected. -->
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- A picker's list is a menu's surface, with the template's own colors restated on :dropdownopen, which outranks them.
       The chosen entry takes the quiet selected fill, and hover the one hover fill. -->
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateSelectedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>

  <!-- Menus and popovers are opaque overlay surfaces with a hairline border. A highlighted row fills with the accent, and
       its text, hint, and icon turn white. Fluent's own state styles set the template's parts, so each is restated. -->
  <!-- Where no compositor makes a popup window transparent, as on a bare X11 server, its corners show this brush. -->
  <Style Selector="PopupRoot">
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>
  <!-- No PopoverShadow: a menu is its own popup window, which clips a shadow at the menu's edge. Room for one would be a
       transparent margin, and a bare X11 server paints that margin with the fallback brush, so only some platforms
       would show it. -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="180" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- A row's current choice is a class bound to the view model, not ToggleType. A click on a toggle row flips
       IsChecked itself, and a menu reused for another target keeps that flip while its binding's value is unchanged. -->
  <Style Selector="MenuItem.current /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Content">
      <Template>
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="MenuItem.destructive /template/ ContentPresenter#PART_HeaderPresenter, MenuItem.destructive /template/ ContentControl#PART_IconPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DestructiveTextBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
  </Style>
  <Style Selector="MenuItem.destructive:selected /template/ Border#PART_LayoutRoot, MenuItem.destructive:pointerover /template/ Border#PART_LayoutRoot, MenuItem.destructive:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource DestructiveFillBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:pressed /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentControl#PART_IconPresenter, MenuItem:pointerover /template/ ContentControl#PART_IconPresenter, MenuItem:pressed /template/ ContentControl#PART_IconPresenter, MenuItem:selected /template/ ContentControl#PART_ToggleIconPresenter, MenuItem:pointerover /template/ ContentControl#PART_ToggleIconPresenter, MenuItem:pressed /template/ ContentControl#PART_ToggleIconPresenter, MenuItem:selected /template/ TextBlock#PART_InputGestureText, MenuItem:pointerover /template/ TextBlock#PART_InputGestureText, MenuItem:pressed /template/ TextBlock#PART_InputGestureText">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:disabled /template/ ContentControl#PART_IconPresenter, MenuItem:disabled /template/ TextBlock#PART_InputGestureText">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- A submenu draws as its menu does, and its chevron follows the row's text. The submenu's border is the template's
       only other border. A popup's content takes its styles from the popup's host, so no selector reaches it through
       the popup, and the template sets its colors itself, which only a rule with a state such as :open outranks. -->
  <Style Selector="MenuItem:open /template/ Border:not(#PART_LayoutRoot)">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Path#PART_ChevronPath, MenuItem:pointerover /template/ Path#PART_ChevronPath, MenuItem:pressed /template/ Path#PART_ChevronPath">
    <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator, MenuItem Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource Border100Brush}" />
  </Style>
  <!-- A tooltip is a small popover. No shadow, for the reason menus have none. -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MaxWidth" Value="320" />
  </Style>

  <!-- Fluent fills a ticked box with the palette accent, which holds a white check at 3.5:1 or less, and shifts it on
       hover and press. The fill token holds the check at 4.6:1 in every state. -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- An in-window popover, such as the Add popover. -->
  <Style Selector="Border.popover">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BoxShadow" Value="{DynamicResource PopoverShadow}" />
  </Style>

  <!-- The splitter is 8 px wide for the pointer and draws a 1 px line in its middle. -->
  <Style Selector="GridSplitter">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource Border80Brush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- The band along the canvas's top edge, solid, as a node editor's header is. The canvas's own styles hold its bottom band. -->
  <Style Selector="Border.canvasBand.top">
    <Setter Property="Background" Value="{DynamicResource AppTopbarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- A compact canvas, below 680 px, marks its chrome compact. A glyph button shows only its glyph there, in a 32 px
       square, and its tooltip's first line names it. An iconOnly button shows only its glyph at every width. A wideOnly part hides there, and a compactOnly part shows only there.
       These come last, so they win over the button styles above. -->
  <Style Selector=".compact Button.glyph, Button.iconOnly">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=".compact Button.glyph TextBlock.label, .compact :is(Control).wideOnly, :is(Control).compactOnly">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".compact :is(Control).compactOnly">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- Run Workflow and Stop Workflow take turns in one place at one width, so a run does not move or cut the breadcrumb. -->
  <Style Selector="Button.runSlot">
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=".compact Button.primary">
    <Setter Property="Padding" Value="8,0" />
  </Style>
</Styles>
