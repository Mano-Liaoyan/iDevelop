<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IDevelop.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Merged dictionaries are searched last to first, so the tokens override Nodify's Light and Dark colors. -->
        <ResourceInclude Source="avares://Nodify/Theme.axaml" />
        <ResourceInclude Source="/Theme/Tokens.axaml" />
        <ResourceInclude Source="/Theme/FluentIcons.axaml" />
        <ResourceInclude Source="/Theme/Glyph.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Theme/Controls.axaml" />
    <StyleInclude Source="/Theme/Kinds.axaml" />
    <StyleInclude Source="/Conversation/ConversationStyles.axaml" />
  </Application.Styles>
</Application>
