<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IDevelop.Desktop"
             xmlns:conversation="using:IDevelop.Desktop.Conversation"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:execution="using:IDevelop.Desktop.Execution"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Conversation.ConversationView"
             x:DataType="conversation:ConversationViewModel"
             Background="{DynamicResource AppShellBrush}"
             AutomationProperties.AutomationId="ConversationView"
             AutomationProperties.Name="{Binding Title, StringFormat='Conversation with {0}'}">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding $parent[local:MainWindow].ViewModel.CloseConversationCommand, FallbackValue={x:Null}}" />
  </UserControl.KeyBindings>
  <!-- The header, the bar's strip, the client's limitations, and the composer take the height they need, and the transcript
       takes the rest. The window keeps the docked conversation tall enough for a few lines of the transcript. -->
  <Grid x:Name="Rows" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Border Classes="conversationHeader">
      <!-- The status sits beside the title while it keeps 160 px after its glyph. The layout and close buttons stay at the
           first line's end. -->
      <theme:SpillRow MinLeadWidth="186" Spacing="10" ItemsAlignment="Start" SpillIndent="26">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChat}" Foreground="{DynamicResource TextMutedBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="conversationTitle" Text="{Binding Title}"
                       AutomationProperties.AutomationId="ConversationTitle" />
            <!-- The canvas's breadcrumb shows above the dock, so the docked header leaves it out. -->
            <TextBlock Classes="caption" Text="{Binding Breadcrumb}" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !$parent[local:MainWindow].ViewModel.IsConversationDocked, FallbackValue=True}"
                       AutomationProperties.AutomationId="ConversationBreadcrumb" />
          </StackPanel>
        </Grid>
        <Border theme:SpillRow.Pinned="True" Classes="limitsGlyph" ToolTip.Tip="{Binding Limitations}"
                AutomationProperties.AccessibilityView="Control"
                AutomationProperties.AutomationId="ClientLimitationsInfo"
                AutomationProperties.Name="{Binding Limitations}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Limitations" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
              <Binding Path="$parent[local:MainWindow].ViewModel.IsConversationDocked" FallbackValue="False" />
            </MultiBinding>
          </Border.IsVisible>
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" />
        </Border>
        <Button theme:SpillRow.Pinned="True" Classes="icon"
                Command="{Binding $parent[local:MainWindow].ViewModel.ToggleConversationLayoutCommand, FallbackValue={x:Null}}"
                ToolTip.Tip="{Binding $parent[local:MainWindow].ViewModel.ConversationLayoutLabel, FallbackValue={x:Null}}"
                AutomationProperties.AutomationId="ConversationLayout"
                AutomationProperties.Name="{Binding $parent[local:MainWindow].ViewModel.ConversationLayoutLabel, FallbackValue={x:Null}}">
          <Panel>
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconPanelBottom}"
                      IsVisible="{Binding !$parent[local:MainWindow].ViewModel.IsConversationDocked, FallbackValue=True}" />
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconMaximize}"
                      IsVisible="{Binding $parent[local:MainWindow].ViewModel.IsConversationDocked, FallbackValue=False}" />
          </Panel>
        </Button>
        <Button theme:SpillRow.Pinned="True" Classes="icon"
                Command="{Binding $parent[local:MainWindow].ViewModel.CloseConversationCommand, FallbackValue={x:Null}}"
                ToolTip.Tip="Close the conversation (Esc)"
                AutomationProperties.AutomationId="CloseConversation"
                AutomationProperties.Name="Close conversation">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDismiss}" />
        </Button>
        <!-- The node's state, as its card names it. -->
        <Border Classes="pill" VerticalAlignment="Center" theme:SpillRow.BesideOnly="True"
                Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}"
                Classes.warning="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Warning}}">
          <TextBlock Text="{Binding StatusLabel}" AutomationProperties.AutomationId="ConversationStatus" />
        </Border>
      </theme:SpillRow>
    </Border>

    <!-- While the conversation takes the canvas's place, it repeats the canvas's bar: what runs and waits, Stop All, and
         Merge into my branch while it is offered (ADR 0017). The dock leaves the canvas and its bar in view, so it shows
         nothing here. -->
    <Border Grid.Row="1" Classes="limitations"
            AutomationProperties.AutomationId="ConversationRun"
            AutomationProperties.Name="{Binding Canvas.BarSummary}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Canvas.ShowsBar" />
          <Binding Path="!$parent[local:MainWindow].ViewModel.IsConversationDocked" FallbackValue="True" />
        </MultiBinding>
      </Border.IsVisible>
      <theme:SpillRow MinLeadWidth="200" Spacing="10">
        <WrapPanel VerticalAlignment="Center" ItemSpacing="10" LineSpacing="4">
          <Border Classes="pill" VerticalAlignment="Center"
                  Classes.running="{Binding Canvas.BarTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                  Classes.complete="{Binding Canvas.BarTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                  Classes.waiting="{Binding Canvas.BarTone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Theme="{StaticResource Glyph}" />
              <TextBlock Text="{Binding Canvas.BarSummary}" AutomationProperties.AutomationId="ConversationRunStatus" />
            </StackPanel>
          </Border>
          <TextBlock Classes="caption" Text="{Binding Canvas.BarActivity}" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Canvas.BarActivity}"
                     AutomationProperties.AutomationId="ConversationRunActivity" />
        </WrapPanel>
        <Button Classes="ghost" Height="28"
                Command="{Binding Canvas.MergeIntoBranchCommand}" IsVisible="{Binding Canvas.CanMergeIntoBranch}"
                ToolTip.Tip="Merge the end nodes' work into the branch you have checked out"
                AutomationProperties.AutomationId="ConversationMergeIntoBranch"
                AutomationProperties.Name="Merge into my branch">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCheckmark}" Width="14" Height="14" />
            <TextBlock Text="Merge into my branch" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Height="28"
                Command="{Binding Canvas.StopAllCommand}" IsVisible="{Binding !!Canvas.RunningCount}"
                ToolTip.Tip="Stop every running node. Finished results stay."
                AutomationProperties.AutomationId="ConversationStopAll"
                AutomationProperties.Name="Stop All">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
            <TextBlock Text="Stop All" />
          </StackPanel>
        </Button>
      </theme:SpillRow>
    </Border>

    <!-- In the dock, where height is short, the limitations sit behind the header's info glyph instead. -->
    <Border Grid.Row="2" Classes="limitations">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Limitations" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
          <Binding Path="!$parent[local:MainWindow].ViewModel.IsConversationDocked" FallbackValue="True" />
        </MultiBinding>
      </Border.IsVisible>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Center" MaxWidth="760">
        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Limitations}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ClientLimitations" />
      </Grid>
    </Border>

    <Border Grid.Row="4" Classes="composer">
      <StackPanel Spacing="6">
        <!-- The choices of a question the running turn waits on, which Send answers with the draft. -->
        <ItemsControl ItemsSource="{Binding Questions}" IsVisible="{Binding IsAsking}" AutomationProperties.AutomationId="ConversationQuestions">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="canvas:QuestionViewModel">
              <StackPanel Spacing="4" Margin="4,0,0,4">
                <TextBlock Classes="caption" Text="{Binding Header}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Choices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="canvas:ChoiceViewModel">
                      <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsChosen}" ToolTip.Tip="{Binding Detail}"
                                    Height="28" Padding="10,0" Margin="0,0,6,6"
                                    AutomationProperties.AutomationId="ConversationChoice" AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="Composer" Classes="composerBox" Text="{Binding Draft}"
                 AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;"
                 Watermark="{Binding Watermark}"
                 AutomationProperties.AutomationId="ConversationComposer"
                 AutomationProperties.Name="Message">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
            <KeyBinding Gesture="Meta+Enter" Command="{Binding SendCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <!-- The hint keeps 200 px beside the buttons, and otherwise takes its own line above them. The buttons end where the
             box ends, and Send, the last, ends there on the last line. -->
        <theme:SpillRow MinLeadWidth="200" Spacing="8" LineSpacing="8">
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0"
                     Text="{Binding ComposerHint}"
                     AutomationProperties.AutomationId="ComposerHint" />
          <Button Classes="action" Command="{Binding OpenInTerminalCommand}"
                  ToolTip.Tip="Copies the command that continues the session in a terminal"
                  AutomationProperties.AutomationId="ConversationTerminal"
                  AutomationProperties.Name="Open in terminal">
            <TextBlock Text="Open in terminal" />
          </Button>
          <Button Classes="action" Command="{Binding ApproveCommand}" IsVisible="{Binding ShowsApprove}"
                  ToolTip.Tip="Makes the agent's last reply the node's result"
                  AutomationProperties.AutomationId="ConversationApprove"
                  AutomationProperties.Name="Approve">
            <TextBlock Text="Approve" />
          </Button>
          <Button Classes="action" Command="{Binding StopCommand}" IsVisible="{Binding ShowsStop}"
                  AutomationProperties.AutomationId="ConversationStop"
                  AutomationProperties.Name="Stop">
            <TextBlock Text="Stop" />
          </Button>
          <Button Classes="action" Command="{Binding StopAndSendCommand}" IsVisible="{Binding ShowsStopAndSend}"
                  AutomationProperties.AutomationId="ConversationStopAndSend"
                  AutomationProperties.Name="Stop and send">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
              <TextBlock Text="Stop and send" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding SendCommand}"
                  ToolTip.Tip="Send (Ctrl+Enter)"
                  AutomationProperties.AutomationId="ConversationSend"
                  AutomationProperties.Name="Send">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSend}" Width="14" Height="14" />
              <TextBlock Text="Send" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </theme:SpillRow>
      </StackPanel>
    </Border>

    <Panel Grid.Row="3">
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.AutomationId="TranscriptScroller">
        <StackPanel>
          <Button Classes="action" HorizontalAlignment="Center" Margin="0,12,0,0"
                  Command="{Binding LoadEarlierCommand}" IsVisible="{Binding HasEarlier}"
                  AutomationProperties.AutomationId="LoadEarlier"
                  AutomationProperties.Name="Load earlier messages">
            <TextBlock Text="Load earlier messages" />
          </Button>
          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Items}" Margin="0,8,0,8"
                        AutomationProperties.AutomationId="Transcript"
                        AutomationProperties.Name="Conversation history">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="conversation:MessageItemViewModel">
                <Panel Classes="row">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsPerson}">
                      <TextBlock Classes="author" Text="{Binding AuthorLabel}" />
                      <Button Grid.Column="1" Classes="icon copy" Command="{Binding CopyCommand}"
                              ToolTip.Tip="Copy message"
                              AutomationProperties.AutomationId="CopyMessage"
                              AutomationProperties.Name="Copy message">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCopy}" />
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <Button Classes="icon copy" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding CopyCommand}"
                              IsVisible="{Binding IsPerson}"
                              ToolTip.Tip="Copy message"
                              AutomationProperties.AutomationId="CopyMessage"
                              AutomationProperties.Name="Copy message">
                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCopy}" />
                      </Button>
                      <Border Classes="message" Classes.person="{Binding IsPerson}"
                              AutomationProperties.AutomationId="Message"
                              AutomationProperties.Name="{Binding AuthorLabel}">
                        <conversation:MarkdownView Markdown="{Binding Text}" />
                      </Border>
                    </Grid>
                    <Border Classes="resultNote" IsVisible="{Binding ResultNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Classes="caption" Text="{Binding ResultNote}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="ResultNote" />
                    </Border>
                  </StackPanel>
                </Panel>
              </DataTemplate>
              <DataTemplate DataType="conversation:ActivityItemViewModel">
                <Panel Classes="row" Margin="24,1">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding Text}" Background="Transparent">
                    <PathIcon Theme="{StaticResource Glyph}" Width="12" Height="12" Foreground="{DynamicResource TextFaintBrush}"
                              Data="{StaticResource IconChevronRight}" />
                    <SelectableTextBlock Grid.Column="1" Classes="activity" Text="{Binding Line}"
                                         AutomationProperties.AutomationId="Activity" />
                  </Grid>
                </Panel>
              </DataTemplate>
              <DataTemplate DataType="conversation:MarkerItemViewModel">
                <Panel Classes="row" Margin="24,14">
                  <StackPanel Spacing="4" AutomationProperties.AutomationId="Marker" AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                      <Border Classes="mdRule" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="markerTitle" Classes.problem="{Binding IsProblem}" Text="{Binding Title}" />
                      <Border Grid.Column="2" Classes="mdRule" VerticalAlignment="Center" />
                    </Grid>
                    <SelectableTextBlock Classes="markerDetail" Text="{Binding Detail}"
                                         IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         AutomationProperties.AutomationId="MarkerDetail" />
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Button x:Name="JumpToLatest" Classes="jump" IsVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
              Click="OnJumpToLatest"
              AutomationProperties.AutomationId="JumpToLatest"
              AutomationProperties.Name="Jump to latest">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconArrowDown}" Width="14" Height="14" />
          <TextBlock Text="Jump to latest" VerticalAlignment="Center" FontSize="13" />
        </StackPanel>
      </Button>
    </Panel>
  </Grid>
</UserControl>
