<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:IDevelop.Desktop.Conversation"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             xmlns:inspector="using:IDevelop.Desktop.Inspector"
             xmlns:theme="using:IDevelop.Desktop.Theme"
             x:Class="IDevelop.Desktop.Conversation.ConversationView"
             x:DataType="conversation:ConversationViewModel"
             AutomationProperties.AutomationId="ConversationView"
             AutomationProperties.Name="{Binding Node.Title, StringFormat='Conversation with {0}'}">
  <!-- The Chat page: the transcript takes the height the Action Dock and the composer leave. The dock and the composer never scroll away. -->
  <Grid x:Name="Rows" RowDefinitions="*,Auto,Auto">
    <Panel>
      <ScrollViewer x:Name="Scroller" Classes="transcript" Focusable="True" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Node.HasAgent}"
                    AutomationProperties.AutomationId="TranscriptScroller">
        <!-- The room under the last row lets the end of the view rest on a whole line at its top. -->
        <StackPanel Margin="0,8,0,12">
          <Button Classes="ghost" HorizontalAlignment="Center" Height="24" Margin="0,0,0,8"
                  Command="{Binding LoadEarlierCommand}" IsVisible="{Binding HasEarlier}"
                  AutomationProperties.AutomationId="LoadEarlier"
                  AutomationProperties.Name="Load earlier messages">
            <TextBlock Text="Earlier messages" />
          </Button>
          <!-- What the agent received, which opens the conversation as a prompt opens a chat. -->
          <Panel Classes="row" Margin="16,0,16,8" IsVisible="{Binding ShowsTask}" AutomationProperties.AutomationId="ConversationTask">
            <StackPanel>
              <ToggleButton Classes="steps" IsChecked="{Binding IsTaskOpen}"
                            AutomationProperties.AutomationId="ConversationTaskToggle" AutomationProperties.Name="Task">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                  <PathIcon Theme="{StaticResource Glyph}" />
                  <TextBlock Grid.Column="1" Classes="stepTool" Text="Task" />
                  <theme:EllipsisText Grid.Column="2" Classes="stepPreview" Whole="{Binding TaskPreview}" MaxLines="1" VerticalAlignment="Center"
                                      IsVisible="{Binding !IsTaskOpen}" AutomationProperties.AutomationId="ConversationTaskPreview" />
                </Grid>
              </ToggleButton>
              <ItemsControl ItemsSource="{Binding TaskFields}" IsVisible="{Binding IsTaskOpen}" Margin="18,4,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="canvas:FieldViewModel">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="caption" Text="{Binding Label}" />
                      <SelectableTextBlock Classes="dockText" Text="{Binding Text}"
                                           AutomationProperties.AutomationId="ConversationTaskField" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Panel>
          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Items}"
                        AutomationProperties.AutomationId="Transcript"
                        AutomationProperties.Name="Conversation history">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="conversation:MessageItemViewModel">
                <Panel Classes="row" Margin="{Binding GapAbove, Converter={x:Static conversation:ConversationView.RowMargin}}" PointerEntered="OnRowEntered">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="{Binding AuthorLabel}" IsVisible="{Binding IsSubagent}" AutomationProperties.AutomationId="MessageAuthor" />
                    <Grid ColumnDefinitions="15*,85*">
                      <Border Grid.Column="{Binding IsPerson, Converter={x:Static conversation:ConversationView.MessageColumn}}"
                              Grid.ColumnSpan="{Binding IsPerson, Converter={x:Static conversation:ConversationView.MessageColumnSpan}}"
                              Classes="message" Classes.person="{Binding IsPerson}"
                              AutomationProperties.AutomationId="Message"
                              AutomationProperties.Name="{Binding AuthorLabel}">
                        <conversation:MarkdownView Markdown="{Binding Text}" />
                      </Border>
                    </Grid>
                    <Border Classes="resultNote" IsVisible="{Binding ResultNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Classes="caption" Text="{Binding ResultNote}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="ResultNote" />
                    </Border>
                    <Border Classes="resultCard" IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.AutomationId="ResultCard">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Classes="resultHeading" Text="{Binding Result.Heading, FallbackValue={x:Null}}" AutomationProperties.AutomationId="ResultCardHeading" />
                          <TextBlock Grid.Column="1" Classes="resultCommit" Text="{Binding Result.Commit, FallbackValue={x:Null}}" ToolTip.Tip="{Binding Result.CommitTip, FallbackValue={x:Null}}"
                                     IsVisible="{Binding Result.Commit, FallbackValue={x:Null}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     AutomationProperties.AutomationId="ResultCardCommit" />
                        </Grid>
                        <TextBlock Classes="dockText" Text="{Binding Result.PlainSummary, FallbackValue={x:Null}}" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="ResultCardSummary" />
                        <Button Classes="ghost" Height="24" Margin="-8,0,0,-4" HorizontalAlignment="Left" Click="OnShowResult"
                                ToolTip.Tip="Opens the Output page"
                                AutomationProperties.AutomationId="ResultOpenOutput" AutomationProperties.Name="Open output">
                          <TextBlock Text="Open output" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <!-- Copy shows on hover at the end of the message's last line, or beside a person's bubble. -->
                  <Button Classes="icon small copy" Classes.person="{Binding IsPerson}" Command="{Binding CopyCommand}"
                          ToolTip.Tip="Copy message" GotFocus="OnCopyFocused"
                          AutomationProperties.AutomationId="CopyMessage"
                          AutomationProperties.Name="Copy message">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCopy}" Width="14" Height="14" />
                  </Button>
                </Panel>
              </DataTemplate>
              <DataTemplate DataType="conversation:ActivityItemViewModel">
                <Panel Classes="row" Margin="{Binding GapAbove, Converter={x:Static conversation:ConversationView.RowMargin}}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding Text}" Background="Transparent">
                    <PathIcon Theme="{StaticResource Glyph}" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                              Data="{StaticResource IconInfo}" />
                    <SelectableTextBlock Grid.Column="1" Classes="activity" Text="{Binding Line}"
                                         AutomationProperties.AutomationId="Activity" />
                  </Grid>
                </Panel>
              </DataTemplate>
              <DataTemplate DataType="conversation:StepGroupItemViewModel">
                <Panel Classes="row" Margin="{Binding GapAbove, Converter={x:Static conversation:ConversationView.RowMargin}}">
                  <StackPanel>
                    <ToggleButton Classes="steps" IsChecked="{Binding IsOpen}"
                                  AutomationProperties.AutomationId="ActivityGroup" AutomationProperties.Name="{Binding Summary}">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                        <PathIcon Theme="{StaticResource Glyph}" />
                        <TextBlock Grid.Column="1" Classes="stepCount" Text="{Binding CountLabel}" AutomationProperties.AutomationId="ActivityCount" />
                        <TextBlock Grid.Column="2" Classes="stepTool" Text="{Binding Last.Tool}" IsVisible="{Binding !IsOpen}" />
                        <TextBlock Grid.Column="3" Classes="stepLast" Text="{Binding Last.Command}" IsVisible="{Binding !IsOpen}"
                                   ToolTip.Tip="{Binding LastLine}" AutomationProperties.AutomationId="ActivityLast" />
                      </Grid>
                    </ToggleButton>
                    <Border Classes="stepGuide" IsVisible="{Binding IsOpen}">
                      <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="conversation:ActivityItemViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding Text}" Background="Transparent">
                              <TextBlock Classes="stepTool" Text="{Binding Tool}" />
                              <SelectableTextBlock Grid.Column="1" Classes="activity" Text="{Binding Command}"
                                                   AutomationProperties.AutomationId="Activity" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Panel>
              </DataTemplate>
              <DataTemplate DataType="conversation:MarkerItemViewModel">
                <Panel Classes="row" Classes.held="{Binding IsHeldByCard}" Margin="{Binding GapAbove, Converter={x:Static conversation:ConversationView.RowMargin}}">
                  <StackPanel Spacing="2" AutomationProperties.AutomationId="Marker" AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsSessionStart}">
                      <Border Classes="mdRule" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Heading}" />
                      <Border Grid.Column="2" Classes="mdRule" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsSessionStart}">
                      <theme:StateMark Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding HasMark}" State="{Binding MarkState}" Why="{Binding MarkWhy}" />
                      <PathIcon Classes="markerGlyph" Theme="{StaticResource Glyph}" Width="14" Height="14" IsVisible="{Binding !HasMark}" />
                      <TextBlock Classes="markerTitle" Classes.problem="{Binding IsProblem}" Text="{Binding Heading}" />
                    </StackPanel>
                    <SelectableTextBlock Classes="markerDetail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                         AutomationProperties.AutomationId="MarkerDetail" />
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
          <!-- Below the Working row nothing shows. -->
          <Panel Classes="row" Margin="16,8,16,0" IsVisible="{Binding ShowsWorking}" AutomationProperties.AutomationId="ConversationWorking">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <theme:StateMark Width="14" Height="14" State="Running" />
              <TextBlock Classes="small" Text="{Binding WorkingLabel}" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="ConversationWorkingLabel" />
            </StackPanel>
          </Panel>
        </StackPanel>
      </ScrollViewer>

      <!-- A person's Approval node has no conversation, so the transcript area shows what it reviews. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !Node.HasAgent}">
        <StackPanel Margin="16,12,16,12" AutomationProperties.AutomationId="ChatInputs">
          <TextBlock Classes="caption" Text="This agent reads no input." IsVisible="{Binding Node.HasNoInputs}" />
          <ItemsControl ItemsSource="{Binding Node.Inputs}" AutomationProperties.AutomationId="ChatInputLinks">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="canvas:NodeLink">
                <inspector:NodeLinkRow LinkId="ChatInputLink" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <TextBlock Classes="caption" Text="No messages yet." HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsEmpty}"
                 AutomationProperties.AutomationId="ConversationEmpty" />
      <Button x:Name="JumpToLatest" Classes="jump" IsVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
              Click="OnJumpToLatest"
              AutomationProperties.AutomationId="JumpToLatest"
              AutomationProperties.Name="Jump to latest">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconArrowDown}" Width="14" Height="14" />
          <TextBlock Text="Jump to latest" VerticalAlignment="Center" FontSize="{StaticResource TypeBodySize}" />
        </StackPanel>
      </Button>
    </Panel>

    <conversation:ActionDock x:Name="DockView" Grid.Row="1" Margin="16,8,16,0" MaxWidth="680" DataContext="{Binding Dock}" />

    <Border x:Name="ComposerFrame" Grid.Row="2" Classes="composer" IsVisible="{Binding Node.HasAgent}">
      <StackPanel>
        <TextBox x:Name="Composer" Classes="composerBox" Text="{Binding Draft}" IsEnabled="{Binding CanCompose}"
                 AcceptsReturn="True" TextWrapping="Wrap" NewLine="&#10;"
                 Watermark="{Binding Watermark}"
                 ToolTip.Tip="{Binding SendProblem}" ToolTip.ShowOnDisabled="True"
                 AutomationProperties.AutomationId="ConversationComposer"
                 AutomationProperties.Name="Message" />
        <Grid x:Name="ComposerBar" Classes="composerBar" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
          <Button x:Name="ModelChip" Classes="modelChip" HorizontalAlignment="Left"
                  ToolTip.Tip="{Binding Node.AgentLabel, StringFormat='The agent: {0}'}"
                  AutomationProperties.AutomationId="ConversationModel" AutomationProperties.Name="{Binding Node.AgentLabel, StringFormat='Agent: {0}'}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAgent}" Width="12" Height="12" />
              <TextBlock Grid.Column="1" Text="{Binding Node.AgentLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="ConversationModelLabel" />
              <PathIcon Grid.Column="2" Classes="chipChevron" Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronUp}" Width="10" Height="10" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Classes="modelFlyout" Spacing="8">
                  <ComboBox ItemsSource="{Binding Node.Picker.ClientChoices}" SelectedItem="{Binding Node.Picker.SelectedClient, Mode=OneWay}"
                            SelectionChanged="OnAgentChosen" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ConversationPickClient" AutomationProperties.Name="Client" ItemTemplate="{StaticResource WrappedChoice}" />
                  <ComboBox ItemsSource="{Binding Node.Picker.ModelChoices}" SelectedItem="{Binding Node.Picker.SelectedModel, Mode=OneWay}"
                            SelectionChanged="OnAgentChosen" PlaceholderText="Choose a model" HorizontalAlignment="Stretch"
                            IsVisible="{Binding Node.HasClient}"
                            AutomationProperties.AutomationId="ConversationPickModel" AutomationProperties.Name="Model" ItemTemplate="{StaticResource WrappedChoice}" />
                  <ComboBox ItemsSource="{Binding Node.Picker.ReasoningChoices}" SelectedItem="{Binding Node.Picker.SelectedReasoning, Mode=OneWay}"
                            SelectionChanged="OnAgentChosen" PlaceholderText="Choose a level" HorizontalAlignment="Stretch"
                            IsVisible="{Binding Node.Picker.HasReasoning}"
                            AutomationProperties.AutomationId="ConversationPickReasoning" AutomationProperties.Name="Reasoning" ItemTemplate="{StaticResource WrappedChoice}" />
                  <TextBlock Classes="caption" Text="A change stops the running turn, and the node waits for your Run." TextWrapping="Wrap"
                             IsVisible="{Binding Node.ShowsNextRunNote}" AutomationProperties.AutomationId="ConversationNextRunNote" />
                  <Button Classes="ghost terminal" Height="28" Command="{Binding Node.OpenInTerminalCommand}" Click="OnCloseModel"
                          ToolTip.Tip="Copies the command that continues the session in a terminal"
                          AutomationProperties.AutomationId="ConversationTerminal" AutomationProperties.Name="Open in terminal">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconCopy}" Width="12" Height="12" />
                      <TextBlock Text="Open in terminal" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock x:Name="KeyHint" Grid.Column="1" Classes="caption keyHint" Text="Enter to send" VerticalAlignment="Center" Margin="0,0,4,0"
                     AutomationProperties.AutomationId="ComposerKeyHint" />
          <Border Grid.Column="2" Classes="composerInfo" Background="Transparent" ToolTip.Tip="{Binding Limitations}"
                  AutomationProperties.AutomationId="ClientLimitationsInfo" AutomationProperties.Name="{Binding Limitations}">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconInfo}" Width="14" Height="14" />
          </Border>
          <Panel Grid.Column="3" Width="28" Height="28">
            <Button Classes="round send" Command="{Binding Node.RunCommand}" IsVisible="{Binding ShowsRun}"
                    ToolTip.Tip="{Binding Node.RunRefusal, FallbackValue='Run'}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.AutomationId="ConversationRunNode" AutomationProperties.Name="Run">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" Width="14" Height="14" />
            </Button>
            <Button Classes="round stop" Command="{Binding Node.StopCommand}" IsVisible="{Binding ShowsComposerStop}"
                    ToolTip.Tip="Stop"
                    AutomationProperties.AutomationId="ConversationStop" AutomationProperties.Name="Stop">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" Width="14" Height="14" />
            </Button>
            <Button Classes="round send" Command="{Binding Node.StopAndSendCommand}" IsVisible="{Binding ShowsStopAndSend}"
                    ToolTip.Tip="Stop and send (Ctrl+Shift+Enter)"
                    AutomationProperties.AutomationId="ConversationStopAndSend" AutomationProperties.Name="Stop and send">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSend}" Width="14" Height="14" />
            </Button>
            <Button Classes="round send" Command="{Binding Node.SendCommand}" IsVisible="{Binding ShowsSend}"
                    ToolTip.Tip="{Binding SendHelp}" ToolTip.ShowOnDisabled="True" ToolTip.Placement="Top"
                    AutomationProperties.AutomationId="ConversationSend" AutomationProperties.Name="Send">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSend}" Width="14" Height="14" />
            </Button>
          </Panel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
