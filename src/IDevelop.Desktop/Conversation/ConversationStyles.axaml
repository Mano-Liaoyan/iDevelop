<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conversation="using:IDevelop.Desktop.Conversation">

  <!-- Markdown blocks. Text stays neutral; only links take the accent's text color. -->
  <!-- No fixed line height, because a line that holds a link control would clip its own text. -->
  <Style Selector="SelectableTextBlock.md">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource StateSelected40Brush}" />
  </Style>
  <Style Selector="SelectableTextBlock.md.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.md.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.md.h3, SelectableTextBlock.md.h4">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.md.th">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.mdMono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource StateSelected40Brush}" />
  </Style>
  <Style Selector="TextBlock.mdMarker">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="2,0,8,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.mdQuote">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Padding" Value="12,2,0,2" />
  </Style>
  <Style Selector="Border.mdRule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Border100Brush}" />
  </Style>
  <Style Selector="Border.mdTable">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.mdCell">
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.mdCell.header">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <!-- Code sits in its own surface, with its language and Copy in a header row so a long line never runs under Copy. -->
  <Style Selector="Border.mdCode">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Grid.mdCodeHeader">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="12,0,4,0" />
  </Style>
  <Style Selector="TextBlock.mdCodeLanguage">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.mdCodeText">
    <Setter Property="Margin" Value="12,0,12,12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="Button.mdLink">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.mdLink /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.mdLink:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent10Brush}" />
  </Style>
  <Style Selector="TextBlock.mdLinkText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- The conversation view. -->
  <Style Selector="Border.conversationHeader">
    <Setter Property="Padding" Value="16,8,12,8" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Background" Value="{DynamicResource AppTopbarBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
  </Style>
  <Style Selector="TextBlock.conversationTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Border.limitations">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted60Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border60Brush}" />
  </Style>
  <Style Selector="Panel.row">
    <Setter Property="MaxWidth" Value="808" />
    <Setter Property="Margin" Value="24,6" />
  </Style>
  <Style Selector="Border.message">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="Border.message.person">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="MaxWidth" Value="600" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
  <Style Selector="Border.message.application">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted60Brush}" />
  </Style>
  <!-- Copy shows on the row the pointer is over, and for the keyboard when it has focus. -->
  <Style Selector="Panel.row Button.copy">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Panel.row:pointerover Button.copy, Panel.row Button.copy:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.message.undelivered">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.author">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="Border.resultNote">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border80Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted60Brush}" />
  </Style>
  <!-- A prompt's artifact instructions: one muted line with a chevron that turns down while the text shows under it. -->
  <Style Selector="ToggleButton.instructions">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="4,0,6,0" />
    <Setter Property="Margin" Value="-4,0,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.instructions /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.instructions:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.instructions:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.instructions:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.instructions:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.instructions PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
  </Style>
  <Style Selector="ToggleButton.instructions:checked PathIcon">
    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
  </Style>
  <Style Selector="SelectableTextBlock.instructions">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource StateSelected40Brush}" />
  </Style>
  <Style Selector="SelectableTextBlock.activity">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.markerTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.markerTitle.problem">
    <Setter Property="Foreground" Value="{DynamicResource StateFailedStrongBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.markerDetail">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.request">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Border.request.open">
    <Setter Property="BorderBrush" Value="{DynamicResource StateWaiting40Brush}" />
    <Setter Property="Background" Value="{DynamicResource StateWaiting10Brush}" />
  </Style>
  <Style Selector="Border.composer">
    <Setter Property="MaxWidth" Value="808" />
    <Setter Property="Margin" Value="24,8,24,16" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource NodeShadow}" />
  </Style>
  <!-- The composer's box draws no frame of its own inside the composer's frame. -->
  <Style Selector="TextBox.composerBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MaxHeight" Value="220" />
    <Setter Property="Padding" Value="4,4" />
  </Style>
  <Style Selector="TextBox.composerBox:pointerover /template/ Border#PART_BorderElement, TextBox.composerBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.jump">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>

  <!-- Card attention: the state glyph becomes a button while the task needs the person, without changing the card's size. -->
  <Style Selector="Button.attention">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="-6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.attention /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.attention:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.attention:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
  </Style>
</Styles>
