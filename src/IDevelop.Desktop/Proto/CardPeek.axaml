<!-- THROWAWAY N1 PROTOTYPE, option B. Never merge. The card's tooltip as a read-only peek: what goes on now and the agent,
     so resting the pointer on a card answers "what is it doing" without a click. A tooltip takes no input, so the answer
     box and the links stay in the pinned note. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             x:Class="IDevelop.Desktop.Proto.CardPeek"
             x:DataType="canvas:TaskNodeViewModel"
             Width="296">
  <StackPanel Spacing="6" Margin="2,2,2,4">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="{Binding NowHeading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" />
      <TextBlock Grid.Column="1" Text="{Binding NowMeta}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
    </Grid>
    <TextBlock Text="{Binding NowText}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
               IsVisible="{Binding NowText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <ItemsControl ItemsSource="{Binding WaitsFor}" IsVisible="{Binding IsWaitsDetail}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="canvas:WaitItem">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="20">
            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Height="1" Background="{DynamicResource Border60Brush}" Margin="0,2" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="{Binding ShortAgent}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="› pins it" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
    </Grid>
  </StackPanel>
</UserControl>
