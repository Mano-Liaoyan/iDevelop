<!-- THROWAWAY N1 PROTOTYPE. Never merge. An expanded card's actions: the conversation on the content edge, and Run or Stop
     on the action edge when the task is the person's to start. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="using:IDevelop.Desktop.Canvas"
             x:Class="IDevelop.Desktop.Proto.CardActions"
             x:DataType="canvas:TaskNodeViewModel">
  <UserControl.Styles>
    <Style Selector="Button.link">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border100Brush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
    </Style>
    <Style Selector="Button.link PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Button Classes="link" HorizontalAlignment="Left" Command="{Binding OpenConversationCommand}" IsVisible="{Binding HasConversation}"
              AutomationProperties.AutomationId="CardOpenConversation" AutomationProperties.Name="Open conversation">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconConversation}" />
          <TextBlock Text="Open conversation" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="link" Command="{Binding PrimaryCommand}" IsVisible="{Binding HasPrimaryAction}"
              AutomationProperties.AutomationId="CardPrimary" AutomationProperties.Name="{Binding PrimaryAction}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Panel>
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" IsVisible="{Binding !IsRunningDetail}" />
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconStop}" IsVisible="{Binding IsRunningDetail}" />
          </Panel>
          <TextBlock Text="{Binding PrimaryAction}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
</UserControl>
