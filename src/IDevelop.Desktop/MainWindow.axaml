<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:IDevelop.Desktop"
        xmlns:canvas="using:IDevelop.Desktop.Canvas"
        xmlns:execution="using:IDevelop.Desktop.Execution"
        xmlns:inspector="using:IDevelop.Desktop.Inspector"
        xmlns:theme="using:IDevelop.Desktop.Theme"
        x:Class="IDevelop.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppSidebarBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome, OSXThickTitleBar">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" MinWidth="200" MaxWidth="400" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="320" MinWidth="280" MaxWidth="520" />
    </Grid.ColumnDefinitions>

    <!-- The sidebar has no fill of its own. The window's sidebar color shows through it.
         Its rows are in the order they appear, which is also the Tab order. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
      <!-- Linux ignores the request to draw into the title bar, so the bands that stand in for it collapse there. -->
      <Border Height="44" Background="Transparent"
              IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}"
              PointerPressed="OnTitleBandPressed" />

      <Border Grid.Row="1" Padding="12,8,12,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border60Brush}">
        <Button x:Name="AddNode" Classes="nav"
                Click="OnAddNode"
                IsEnabled="{Binding Canvas, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="Add a node (N on the canvas)"
                AutomationProperties.AutomationId="AddTask"
                AutomationProperties.Name="Add node">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" />
            <TextBlock Text="Add Node" />
          </StackPanel>
        </Button>
      </Border>

      <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="12" RowSpacing="12">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="Project" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon"
                    Click="OnOpenFolder"
                    ToolTip.Tip="Open folder"
                    AutomationProperties.AutomationId="OpenFolder"
                    AutomationProperties.Name="Open folder">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" />
            </Button>
          </Grid>
          <Border IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNull}}"
                  Padding="12,8" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                  BorderBrush="{DynamicResource Border80Brush}" Background="{DynamicResource SurfaceMuted60Brush}">
            <TextBlock Text="No project open." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
        </StackPanel>
        <!-- Each project lists its workflows, and each workflow lists its tasks while its row is expanded. The shown
             workflow is the selected row, as in PlanWeave's project tree. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Projects}"
                        AutomationProperties.AutomationId="Projects"
                        AutomationProperties.Name="Open projects">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:ProjectViewModel">
                <StackPanel Spacing="4">
                  <Grid Height="28" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="8,0,0,0">
                    <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" Foreground="{DynamicResource TextStrongBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                               ToolTip.Tip="{Binding Folder}"
                               AutomationProperties.AutomationId="ProjectName" />
                    <Ellipse Grid.Column="2" Classes="status running" VerticalAlignment="Center"
                             IsVisible="{Binding IsRunning}"
                             ToolTip.Tip="A task runs"
                             AutomationProperties.AutomationId="ProjectRunning"
                             AutomationProperties.Name="A task runs" />
                    <Button Grid.Column="3" Classes="icon"
                            Click="OnNewWorkflow"
                            ToolTip.Tip="New workflow"
                            AutomationProperties.AutomationId="NewWorkflow"
                            AutomationProperties.Name="New workflow">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" />
                    </Button>
                    <Button Grid.Column="4" Classes="icon"
                            Click="OnCloseProject"
                            ToolTip.Tip="Close project"
                            AutomationProperties.AutomationId="CloseProject"
                            AutomationProperties.Name="Close project">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconDismiss}" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Workflows}" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="canvas:WorkflowCanvasViewModel">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                            <ToggleButton Classes="chevron"
                                          IsChecked="{Binding IsExpanded}"
                                          ToolTip.Tip="Show tasks"
                                          AutomationProperties.AutomationId="WorkflowExpand"
                                          AutomationProperties.Name="Show tasks">
                              <PathIcon Theme="{StaticResource Glyph}" />
                            </ToggleButton>
                            <Panel Grid.Column="1">
                              <Button Classes="nav workflow" Classes.selected="{Binding IsSelected}" HorizontalContentAlignment="Stretch"
                                      IsVisible="{Binding !IsRenamingWorkflow}"
                                      Click="OnWorkflowClick"
                                      KeyDown="OnWorkflowKeyDown"
                                      ToolTip.Tip="{Binding Name}"
                                      AutomationProperties.AutomationId="WorkflowRow"
                                      AutomationProperties.Name="{Binding Name}">
                                <Button.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Header="Rename" InputGesture="F2"
                                              Click="OnRenameWorkflow"
                                              AutomationProperties.AutomationId="WorkflowRename"
                                              AutomationProperties.Name="Rename">
                                      <MenuItem.Icon>
                                        <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRename}" />
                                      </MenuItem.Icon>
                                    </MenuItem>
                                  </ContextMenu>
                                </Button.ContextMenu>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFlowchart}" />
                                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                             AutomationProperties.AutomationId="WorkflowName" />
                                  <Ellipse Grid.Column="2" Classes="status" VerticalAlignment="Center"
                                           IsVisible="{Binding HasUnsavedChanges}"
                                           ToolTip.Tip="Unsaved changes"
                                           AutomationProperties.AutomationId="WorkflowUnsaved"
                                           AutomationProperties.Name="Unsaved changes" />
                                  <Ellipse Grid.Column="3" Classes="status running" VerticalAlignment="Center"
                                           IsVisible="{Binding IsRunning}"
                                           ToolTip.Tip="A task runs"
                                           AutomationProperties.AutomationId="WorkflowRunning"
                                           AutomationProperties.Name="A task runs" />
                                  <Border Grid.Column="4" Classes="badge">
                                    <TextBlock Text="{Binding Nodes.Count}" AutomationProperties.AutomationId="TaskCount" />
                                  </Border>
                                </Grid>
                              </Button>
                              <local:WorkflowNameBox IsVisible="{Binding IsRenamingWorkflow}" Height="32"
                                                     AutomationProperties.AutomationId="WorkflowNameBox"
                                                     AutomationProperties.Name="Workflow name" />
                            </Panel>
                          </Grid>
                          <Border IsVisible="{Binding IsExpanded}"
                                  Margin="12,0,0,0" Padding="12,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border60Brush}">
                            <ListBox Classes="tasks"
                                     ItemsSource="{Binding Outline}"
                                     SelectedItem="{Binding SelectedNode}"
                                     SelectionChanged="OnSidebarSelectionChanged"
                                     Tapped="OnSidebarTapped"
                                     KeyDown="OnSidebarKeyDown"
                                     AutomationProperties.AutomationId="SidebarTasks"
                                     AutomationProperties.Name="{Binding Name}">
                              <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                              </ListBox.ItemsPanel>
                              <ListBox.ItemTemplate>
                                <DataTemplate DataType="canvas:TaskNodeViewModel">
                                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <theme:KindTile Kind="{Binding Kind}" IsLibrary="{Binding IsLibrary}" TileSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding Title}" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="3" Padding="12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="Agents" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon"
                    Command="{Binding RefreshAgentsCommand}"
                    ToolTip.Tip="Check agents again"
                    AutomationProperties.AutomationId="RefreshAgents"
                    AutomationProperties.Name="Check agents again">
              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRefresh}" />
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding Agents}"
                        AutomationProperties.AutomationId="Agents"
                        AutomationProperties.Name="Agents">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="execution:AgentRow">
                <!-- UI Automation shows no plain panel, so the summary carries the row's id and its reason. The summary
                     names the reason in a few words, and the row's tooltip holds all of it. -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8"
                      Background="Transparent"
                      ToolTip.Tip="{Binding Detail}">
                  <Ellipse Classes="status" VerticalAlignment="Center"
                           Classes.running="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Running}}"
                           Classes.complete="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Complete}}"
                           Classes.problem="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Problem}}"
                           Classes.waiting="{Binding Tone, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static execution:StatusTone.Waiting}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="{Binding AutomationId}"
                             AutomationProperties.HelpText="{Binding Detail}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Padding="12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Appearance" />
          <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2">
            <UniformGrid Columns="3">
              <RadioButton Classes="segment" GroupName="Theme" Content="System"
                           Tag="{x:Static ThemeVariant.Default}"
                           IsChecked="{Binding RequestedThemeVariant, Source={x:Static Application.Current}, Mode=OneWay,
                                       Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ThemeVariant.Default}}"
                           IsCheckedChanged="OnThemeChecked"
                           AutomationProperties.AutomationId="ThemeSystem"
                           AutomationProperties.Name="System theme" />
              <RadioButton Classes="segment" GroupName="Theme" Content="Light"
                           Tag="{x:Static ThemeVariant.Light}"
                           IsChecked="{Binding RequestedThemeVariant, Source={x:Static Application.Current}, Mode=OneWay,
                                       Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ThemeVariant.Light}}"
                           IsCheckedChanged="OnThemeChecked"
                           AutomationProperties.AutomationId="ThemeLight"
                           AutomationProperties.Name="Light theme" />
              <RadioButton Classes="segment" GroupName="Theme" Content="Dark"
                           Tag="{x:Static ThemeVariant.Dark}"
                           IsChecked="{Binding RequestedThemeVariant, Source={x:Static Application.Current}, Mode=OneWay,
                                       Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ThemeVariant.Dark}}"
                           IsCheckedChanged="OnThemeChecked"
                           AutomationProperties.AutomationId="ThemeDark"
                           AutomationProperties.Name="Dark theme" />
            </UniformGrid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1" Width="8" Margin="-3.5,0" ZIndex="1" />

    <Border Grid.Column="2" CornerRadius="14,0,0,14" ClipToBounds="True" Background="{DynamicResource AppShellBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="44"
                Background="{DynamicResource AppTopbarBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border80Brush}"
                IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}"
                PointerPressed="OnTitleBandPressed" />
        <Panel>
          <TextBlock Text="Open a project folder to start."
                     IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNull}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
          <ContentControl x:Name="CanvasHost" Content="{Binding Canvas}">
            <ContentControl.ContentTemplate>
              <canvas:CanvasViewTemplate />
            </ContentControl.ContentTemplate>
          </ContentControl>

          <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Spacing="8">
            <Border Classes="breadcrumb" HorizontalAlignment="Left"
                    IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNotNull}}"
                    AutomationProperties.AutomationId="Breadcrumb">
              <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Text="{Binding ProjectName}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                             AutomationProperties.AutomationId="BreadcrumbProject" />
                </StackPanel>
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Foreground="{DynamicResource TextFaintBrush}" />
                <TextBlock Text="{Binding WorkflowName}" MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="8,0,10,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                           AutomationProperties.AutomationId="BreadcrumbWorkflow" />
                <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border80Brush}">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="ghost" CornerRadius="0" VerticalAlignment="Stretch"
                            Command="{Binding UndoCommand}"
                            ToolTip.Tip="Undo"
                            AutomationProperties.AutomationId="Undo"
                            AutomationProperties.Name="Undo">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconUndo}" />
                    </Button>
                    <Button Classes="ghost" CornerRadius="0" VerticalAlignment="Stretch"
                            Command="{Binding RedoCommand}"
                            ToolTip.Tip="Redo"
                            AutomationProperties.AutomationId="Redo"
                            AutomationProperties.Name="Redo">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRedo}" />
                    </Button>
                  </StackPanel>
                </Border>
                <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border80Brush}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Unsaved changes" Margin="10,0,2,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                               IsVisible="{Binding HasUnsavedChanges}"
                               AutomationProperties.AutomationId="UnsavedChanges" />
                    <Button Classes="ghost" CornerRadius="0" VerticalAlignment="Stretch"
                            Command="{Binding SaveCommand}"
                            ToolTip.Tip="Save"
                            AutomationProperties.AutomationId="Save"
                            AutomationProperties.Name="Save">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- The status sits under the breadcrumb so a long message never covers it. The line limit keeps it above
                 the zoom panel and the minimap at the window's minimum height, and the tooltip holds the whole message. -->
            <Border Classes="breadcrumb" HorizontalAlignment="Left" Padding="12,9" MaxWidth="420"
                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="10"
                         ToolTip.Tip="{Binding Status}"
                         AutomationProperties.AutomationId="Status"
                         AutomationProperties.Name="Status" />
            </Border>
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="3" Width="8" Margin="-3.5,0" ZIndex="1" />

    <DockPanel Grid.Column="4" Background="{DynamicResource AppPanelBrush}" AutomationProperties.AutomationId="Inspector">
      <!-- Windows draws the caption buttons over this header's right end, so its title stays on the left. -->
      <Border DockPanel.Dock="Top" Height="44" Padding="12,0"
              Background="{DynamicResource AppTopbarBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border80Brush}"
              PointerPressed="OnTitleBandPressed">
        <TextBlock Text="Inspector" VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" />
      </Border>
      <!-- The inspector scrolls its own sections, so its header and filter stay in place. -->
      <ContentControl Content="{Binding Canvas}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="canvas:WorkflowCanvasViewModel">
            <inspector:InspectorView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>

    <!-- A modal sheet covers every column, so the breadcrumb, Save, and the sidebar take no click while it is open.
         It sits above the splitters, whose ZIndex 1 would otherwise draw them over the scrim and let them take a drag. -->
    <ContentControl Grid.ColumnSpan="5" ZIndex="2" Content="{Binding Canvas.Sheet}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="canvas:GenerateWorkflowViewModel">
          <canvas:GenerateSheet />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</Window>
