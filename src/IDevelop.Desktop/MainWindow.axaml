<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:IDevelop.Desktop"
        xmlns:canvas="using:IDevelop.Desktop.Canvas"
        xmlns:chrome="using:IDevelop.Desktop.Chrome"
        xmlns:inspector="using:IDevelop.Desktop.Inspector"
        xmlns:sidebar="using:IDevelop.Desktop.Sidebar"
        xmlns:theme="using:IDevelop.Desktop.Theme"
        x:Class="IDevelop.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppShellBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome, OSXThickTitleBar">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <StyleInclude Source="/Chrome/ChromeStyles.axaml" />
  </Window.Styles>

  <!-- The Command Bar spans the window. Under it the sheets sit on the shell with 4 px gaps, which are also their resize handles.
       The code-behind applies the width tier: a sheet's width, its limits, and how the Index and the Rail trade places. -->
  <Grid x:Name="Shell" RowDefinitions="44,*">
    <chrome:CommandBar />

    <Grid x:Name="Columns" Grid.Row="1" Margin="4,0,4,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" MinWidth="240" MaxWidth="400" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="400" MinWidth="360" MaxWidth="560" />
      </Grid.ColumnDefinitions>

      <!-- The Index. While the Rail stands in its place, the same sheet opens as a flyout over the Map. -->
      <Border x:Name="IndexSheet" Classes="sheet index" Classes.flyout="{Binding IsIndexFlyoutOpen}" ZIndex="2">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="IsSidebarShown" />
            <Binding Path="IsIndexFlyoutOpen" />
          </MultiBinding>
        </Border.IsVisible>
        <sidebar:SidebarView x:Name="Sidebar" />
      </Border>
      <chrome:IndexRail x:Name="Rail" IsVisible="{Binding ShowsRail}" />

      <GridSplitter Grid.Column="1" Classes="sheetGap" ZIndex="1" IsVisible="{Binding CanResizeIndex}" />

      <!-- The Map. Its fill is the canvas's background, so a corner never shows a different color. -->
      <Border x:Name="MapSheet" Grid.Column="2" Classes="sheet" IsVisible="{Binding !AgentPanel.IsRoom}">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource CanvasGrid.BackgroundColor}" />
        </Border.Background>
        <Grid x:Name="CanvasArea" RowDefinitions="Auto,*">
          <Border Classes="mapNotice" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <theme:EllipsisText Classes="caption" Whole="{Binding Status}" TextWrapping="Wrap" MaxLines="10"
                                ToolTip.Tip="{Binding Status}"
                                AutomationProperties.AutomationId="Status"
                                AutomationProperties.Name="Status" />
          </Border>
          <Panel Grid.Row="1">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNull}}">
              <Button Classes="primary" HorizontalAlignment="Center" Click="OnOpenFolder"
                      AutomationProperties.AutomationId="CanvasOpenFolder"
                      AutomationProperties.Name="Open folder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" />
                  <TextBlock Text="Open folder" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Classes="caption" Text="Open a project folder to start." HorizontalAlignment="Center" />
            </StackPanel>
            <ContentControl x:Name="CanvasHost" Content="{Binding Canvas}">
              <ContentControl.ContentTemplate>
                <canvas:CanvasViewTemplate />
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Panel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Classes="sheetGap" ZIndex="1" IsVisible="{Binding CanResizePanel}" />

      <!-- The Agent panel: its pages and tab strip. -->
      <Border x:Name="InspectorFrame" Grid.Column="4" Classes="sheet panel" IsVisible="{Binding IsInspectorShown}">
        <DockPanel x:Name="InspectorPanel" AutomationProperties.AutomationId="Inspector">
          <ContentControl Content="{Binding Canvas}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="canvas:WorkflowCanvasViewModel">
                <inspector:AgentPanelView Panel="{Binding $parent[local:MainWindow].ViewModel.AgentPanel}" />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Find floats over the whole window. A click outside it closes it. -->
    <sidebar:FindPalette x:Name="Palette" Grid.RowSpan="2" ZIndex="2" />

    <!-- A modal sheet covers the whole window, so the Command Bar and the Index take no click while it is open.
         It sits above the splitters, whose ZIndex 1 would otherwise draw them over the scrim and let them take a drag. -->
    <ContentControl Grid.RowSpan="2" ZIndex="3" Content="{Binding Canvas.Sheet, FallbackValue={x:Null}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="canvas:GenerateWorkflowViewModel">
          <canvas:GenerateSheet />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</Window>
