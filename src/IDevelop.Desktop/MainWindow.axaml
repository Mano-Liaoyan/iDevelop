<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:IDevelop.Desktop"
        xmlns:canvas="using:IDevelop.Desktop.Canvas"
        xmlns:conversation="using:IDevelop.Desktop.Conversation"
        xmlns:execution="using:IDevelop.Desktop.Execution"
        xmlns:inspector="using:IDevelop.Desktop.Inspector"
        xmlns:sidebar="using:IDevelop.Desktop.Sidebar"
        xmlns:theme="using:IDevelop.Desktop.Theme"
        x:Class="IDevelop.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppTopbarBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome, OSXThickTitleBar">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <!-- The sidebar and the inspector keep the width the person drags them to while the canvas keeps 336 px. The code-behind
       lowers their columns' largest widths as the window narrows, which the splitters also keep to. The sidebar is never
       narrower than 240 px, which leaves a tree row's name room for a word. -->
  <Grid x:Name="Columns">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256" MinWidth="240" MaxWidth="400" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="320" MinWidth="280" MaxWidth="520" />
    </Grid.ColumnDefinitions>

    <!-- The left area has no fill of its own. The window's color shows through it. -->
    <sidebar:SidebarView x:Name="Sidebar" />

    <GridSplitter Grid.Column="1" Width="8" Margin="-3.5,0" ZIndex="1" />

    <Border Grid.Column="2" ClipToBounds="True" Background="{DynamicResource AppShellBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="44"
                Background="{DynamicResource AppTopbarBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border80Brush}"
                IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}"
                PointerPressed="OnTitleBandPressed" />
        <!-- The conversation takes the main area over the canvas by default, or sits in a dock under it. -->
        <Grid x:Name="MainArea" RowDefinitions="*,Auto,Auto">
        <Panel x:Name="CanvasArea">
          <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNull}}">
            <Button Classes="primary" HorizontalAlignment="Center" Click="OnOpenFolder"
                    AutomationProperties.AutomationId="CanvasOpenFolder"
                    AutomationProperties.Name="Open Folder">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" />
                <TextBlock Text="Open Folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Classes="caption" Text="Open a project folder to start." HorizontalAlignment="Center" />
          </StackPanel>
          <ContentControl x:Name="CanvasHost" Content="{Binding Canvas}" IsVisible="{Binding ShowsCanvas}">
            <ContentControl.ContentTemplate>
              <canvas:CanvasViewTemplate />
            </ContentControl.ContentTemplate>
          </ContentControl>

          <!-- What floats along the canvas's top edge: the breadcrumb at the left, the workflow's buttons at the right, the
               waiting pill between them or under the buttons, and the status under the breadcrumb. The bar has no fill, so
               the canvas takes every input between them. On a compact canvas the code-behind marks the bar compact: the
               breadcrumb shows only the workflow's name, and the buttons only their glyphs. -->
          <canvas:CanvasTopBar x:Name="TopBar" VerticalAlignment="Top" Margin="12" IsVisible="{Binding ShowsCanvas}">
            <Border Classes="breadcrumb" canvas:CanvasTopBar.Slot="Leading" HorizontalAlignment="Left"
                    IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNotNull}}"
                    AutomationProperties.AutomationId="Breadcrumb">
              <!-- The names come first and give up width first, the project's before the workflow's, while Undo, Redo, and
                   Save keep theirs at the end, in that order for the keyboard too. -->
              <theme:SpillRow Spacing="0">
                <DockPanel Margin="0,0,10,0">
                  <PathIcon DockPanel.Dock="Left" Theme="{StaticResource Glyph}" Data="{StaticResource IconFolder}" Width="14" Height="14" Margin="10,0,6,0"
                            Foreground="{DynamicResource TextMutedBrush}" />
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WorkflowName}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextStrongBrush}"
                               ToolTip.Tip="{Binding WorkflowName}"
                               AutomationProperties.AutomationId="BreadcrumbWorkflow" />
                    <PathIcon DockPanel.Dock="Right" Classes="wideOnly" Theme="{StaticResource Glyph}" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Margin="10,0,8,0"
                              Foreground="{DynamicResource TextFaintBrush}" />
                    <TextBlock Classes="wideOnly" Text="{Binding ProjectName}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               ToolTip.Tip="{Binding ProjectName}"
                               AutomationProperties.AutomationId="BreadcrumbProject" />
                  </DockPanel>
                </DockPanel>
                <Border theme:SpillRow.Pinned="True" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border80Brush}">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="ghost" CornerRadius="0" VerticalAlignment="Stretch"
                            Command="{Binding UndoCommand}"
                            ToolTip.Tip="Undo"
                            AutomationProperties.AutomationId="Undo"
                            AutomationProperties.Name="Undo">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconUndo}" />
                    </Button>
                    <Button Classes="ghost" CornerRadius="0" VerticalAlignment="Stretch"
                            Command="{Binding RedoCommand}"
                            ToolTip.Tip="Redo"
                            AutomationProperties.AutomationId="Redo"
                            AutomationProperties.Name="Redo">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRedo}" />
                    </Button>
                  </StackPanel>
                </Border>
                <Border theme:SpillRow.Pinned="True" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border80Brush}">
                  <StackPanel Orientation="Horizontal">
                    <Panel Classes="wideOnly" VerticalAlignment="Center">
                      <TextBlock Text="Unsaved changes" Margin="10,0,2,0"
                                 FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                 IsVisible="{Binding HasUnsavedChanges}"
                                 AutomationProperties.AutomationId="UnsavedChanges" />
                    </Panel>
                    <Button Classes="ghost" CornerRadius="0" VerticalAlignment="Stretch"
                            Command="{Binding SaveCommand}"
                            ToolTip.Tip="Save"
                            AutomationProperties.AutomationId="Save"
                            AutomationProperties.Name="Save">
                      <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSaveAs}" />
                    </Button>
                  </StackPanel>
                </Border>
              </theme:SpillRow>
            </Border>

            <Button Classes="ghost" Padding="0" canvas:CanvasTopBar.Slot="Center"
                    Command="{Binding Canvas.NextWaitingCommand, FallbackValue={x:Null}}"
                    IsVisible="{Binding Canvas.HasWaiting, FallbackValue=False}"
                    AutomationProperties.AutomationId="NextWaiting"
                    AutomationProperties.Name="Show the next node that waits for you">
              <Border Classes="pill waiting">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Theme="{StaticResource Glyph}" />
                  <TextBlock Text="{Binding Canvas.WaitingLabel, FallbackValue=''}" AutomationProperties.AutomationId="WaitingCount" />
                </StackPanel>
              </Border>
            </Button>

            <!-- Run Workflow runs every node that has no current result, so it needs no selected node (ADR 0017). -->
            <Panel canvas:CanvasTopBar.Slot="Trailing" IsVisible="{Binding Canvas, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentControl Content="{Binding Canvas}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="canvas:WorkflowCanvasViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="action glyph" Click="OnAddNode"
                              ToolTip.Tip="Add Node&#10;N on the canvas"
                              AutomationProperties.AutomationId="AddTask"
                              AutomationProperties.Name="Add node">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconAdd}" />
                          <TextBlock Classes="label" Text="Add Node" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="action glyph" Command="{Binding RunWorkflowCommand}"
                              ToolTip.Tip="{x:Static local:MainWindow.RunWorkflowHelp}"
                              AutomationProperties.AutomationId="RunWorkflow"
                              AutomationProperties.Name="Run Workflow">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconRun}" />
                          <TextBlock Classes="label" Text="Run Workflow" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="glyph" Classes.primary="{Binding IsGenerateIdle}" Classes.action="{Binding !IsGenerateIdle}"
                              Click="OnGenerate"
                              ToolTip.Tip="{Binding GenerateLabel, StringFormat='{}{0}&#10;Describe what to build, and a planner proposes the tasks'}"
                              AutomationProperties.AutomationId="GenerateWorkflow"
                              AutomationProperties.Name="{Binding GenerateLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSparkle}" IsVisible="{Binding IsGenerateIdle}" />
                          <PathIcon Theme="{StaticResource Glyph}" Classes="spin" Data="{StaticResource IconStateRunning}"
                                    Foreground="{DynamicResource AccentStrongBrush}" IsVisible="{Binding IsPlanning}" />
                          <!-- An open proposal shows a dot before its label, or on the glyph when the label hides. -->
                          <Panel Classes="wideOnly" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="4,0" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsReviewing}" />
                          </Panel>
                          <Panel Classes="compactOnly" VerticalAlignment="Center">
                            <Panel IsVisible="{Binding IsReviewing}">
                              <PathIcon Theme="{StaticResource Glyph}" Data="{StaticResource IconSparkle}" />
                              <Ellipse Width="6" Height="6" Margin="0,-2,-3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Fill="{DynamicResource AccentBrush}" />
                            </Panel>
                          </Panel>
                          <TextBlock Classes="label" Text="{Binding GenerateLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Panel>

            <!-- The status sits under the breadcrumb so a long message never covers it. The line limit keeps it above
                 the zoom panel and the minimap at the window's minimum height, and the tooltip holds the whole message. -->
            <Border Classes="breadcrumb" canvas:CanvasTopBar.Slot="Below" HorizontalAlignment="Left" Padding="12,9" MaxWidth="420"
                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="10"
                         ToolTip.Tip="{Binding Status}"
                         AutomationProperties.AutomationId="Status"
                         AutomationProperties.Name="Status" />
            </Border>
          </canvas:CanvasTopBar>

          <ContentControl Content="{Binding MainConversation}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="conversation:ConversationViewModel">
                <conversation:ConversationView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Panel>
        <GridSplitter x:Name="DockSplitter" Grid.Row="1" Height="8" Margin="0,-3.5" ZIndex="1"
                      IsVisible="{Binding DockedConversation, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border80Brush}"
                IsVisible="{Binding DockedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl x:Name="DockedHost" Content="{Binding DockedConversation}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="conversation:ConversationViewModel">
                <conversation:ConversationView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
        </Grid>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="3" Width="8" Margin="-3.5,0" ZIndex="1" />

    <DockPanel x:Name="InspectorPanel" Grid.Column="4" Background="{DynamicResource AppPanelBrush}" AutomationProperties.AutomationId="Inspector">
      <!-- Windows draws the caption buttons over this header's right end, so its title stays on the left. -->
      <Border DockPanel.Dock="Top" Height="44" Padding="12,0"
              Background="{DynamicResource AppTopbarBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border80Brush}"
              PointerPressed="OnTitleBandPressed">
        <TextBlock Text="Inspector" VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" />
      </Border>
      <!-- The inspector scrolls its own sections, so its header and filter stay in place. -->
      <ContentControl Content="{Binding Canvas}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="canvas:WorkflowCanvasViewModel">
            <inspector:InspectorView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>

    <!-- A modal sheet covers every column, so the breadcrumb, Save, and the sidebar take no click while it is open.
         It sits above the splitters, whose ZIndex 1 would otherwise draw them over the scrim and let them take a drag. -->
    <ContentControl Grid.Column="0" Grid.ColumnSpan="5" ZIndex="2" Content="{Binding Canvas.Sheet, FallbackValue={x:Null}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="canvas:GenerateWorkflowViewModel">
          <canvas:GenerateSheet />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</Window>
