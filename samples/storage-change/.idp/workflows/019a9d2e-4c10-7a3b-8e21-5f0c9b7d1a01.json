      "blueprint": "idevelop.implement@1",
      "fields": {
        "instructions": [
          "Propose a JSON layout for tasks, connections, and canvas positions.",
          "Keep multi-line text readable in a plain text editor.",
          "",
          "Store no view state other than node positions."
