<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- A deadlocked test aborts its host after 5 minutes, names the hung test, and leaves a mini dump instead of hanging the run. -->
    <VSTestBlameHang>true</VSTestBlameHang>
    <VSTestBlameHangTimeout>5m</VSTestBlameHangTimeout>
    <VSTestBlameHangDumpType>mini</VSTestBlameHangDumpType>
    <!-- A project's whole run ends with an error after 30 minutes, for a run that slows to a crawl without one test hanging (#165). -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
